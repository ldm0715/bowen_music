<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- ★ xunit.v3 的 buildTransitive targets 对非 Exe 的 OutputType 直接报 Error -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Bodian.Core.Tests</RootNamespace>
    <AssemblyName>Bodian.Core.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- xunit 自身大量用反射，不要开 AOT 分析器 -->
    <IsAotCompatible>false</IsAotCompatible>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- 研究向量单独编译，解密器不在 Bodian.Core / WinUI 的输出程序集内。 -->
  <ItemGroup>
    <Compile Include="..\..\src\Bodian.Core\Playback\EKeyAudioDecryptor.cs" Link="Research\EKeyAudioDecryptor.cs" />
    <Compile Include="..\..\src\Bodian.Core\Playback\EncryptedAudioSourceResolver.cs" Link="Research\EncryptedAudioSourceResolver.cs" />
    <!-- 脱敏测试要用 LoggerFactory.Create 搭一个内层工厂；
         它在这个包里，而不在 Core 引用的 Abstractions 里。 -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="xunit.v3" />
    <!-- 保留它给 VS 测试资源管理器；dotnet test 仍按 global.json 走 MTP -->
    <PackageReference Include="xunit.runner.visualstudio" />
    <!--
      xunit.v3 会传递引入 Microsoft.Testing.Extensions.Telemetry，它是「默认开启、靠环境变量退出」，
      与项目 README 的「不含遥测」立场冲突。这里直接排除资产，不依赖开发者记得设环境变量。
      确认方法见 docs/dev-environment.md 第 3.3 节。
    -->
    <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bodian.Core\Bodian.Core.csproj" />
    <!-- 只测导入表定位，不调用 Win32 或修改真实模块。 -->
    <Compile Include="..\..\src\Bodian.WinUI\Services\LegacyImeCompatibility.cs" Link="Services\LegacyImeCompatibility.cs" />
    <!-- 评论 ViewModel 不依赖 WinUI，链接源文件验证请求取消和迟到响应，不加载 UI 运行时。 -->
    <Compile Include="..\..\src\Bodian.WinUI\ViewModels\SongCommentsViewModel.cs" Link="ViewModels\SongCommentsViewModel.cs" />
    <Compile Include="..\..\src\Bodian.WinUI\ViewModels\SongCommentRow.cs" Link="ViewModels\SongCommentRow.cs" />
    <Compile Include="..\..\src\Bodian.WinUI\ViewModels\TrackStatisticsViewModel.cs" Link="ViewModels\TrackStatisticsViewModel.cs" />
    <!-- 曲目行「更多」菜单。它只依赖 Core 与下面两个接口，所以能离屏测；
         真正的实现 Services\TrackActionsService.cs 依赖导航与页面，链进来编不过。 -->
    <Compile Include="..\..\src\Bodian.WinUI\ViewModels\TrackActionsViewModel.cs" Link="ViewModels\TrackActionsViewModel.cs" />
    <Compile Include="..\..\src\Bodian.WinUI\ViewModels\TrackMenuEntry.cs" Link="ViewModels\TrackMenuEntry.cs" />
    <Compile Include="..\..\src\Bodian.WinUI\ViewModels\ArtistChoice.cs" Link="ViewModels\ArtistChoice.cs" />
    <Compile Include="..\..\src\Bodian.WinUI\Services\ITrackNavigator.cs" Link="Services\ITrackNavigator.cs" />
    <Compile Include="..\..\src\Bodian.WinUI\Services\INoticeSink.cs" Link="Services\INoticeSink.cs" />
    <Compile Include="..\..\src\Bodian.WinUI\Services\IQueueSink.cs" Link="Services\IQueueSink.cs" />
    <!-- 歌词滚动只依赖纯数学，链接正式动画器验证当前行不回弹以及错峰延迟。 -->
    <Compile Include="..\..\src\Bodian.WinUI\LyricRenderer\LyricsScrollAnimator.cs" Link="LyricRenderer\LyricsScrollAnimator.cs" />
    <!-- 通用分页列表。只依赖 Core 的游标与 CommunityToolkit.Mvvm，不含 WinUI 类型，
         所以「播放全部」要用的 LoadAllAsync（拉完全部、触顶、中途失败）能离屏测。 -->
    <Compile Include="..\..\src\Bodian.WinUI\ViewModels\PagedList.cs" Link="ViewModels\PagedList.cs" />
    <!-- 歌单/「我喜欢的」那一族的「播放全部」走的是手写游标，不是 PagedList，
         它的 LoadAllAsync 语义要单独验。同样只依赖 Core 与 PlaybackCoordinator。 -->
    <Compile Include="..\..\src\Bodian.WinUI\ViewModels\PlaylistTracksViewModel.cs" Link="ViewModels\PlaylistTracksViewModel.cs" />
    <Compile Include="..\..\src\Bodian.WinUI\Playback\PlaybackCoordinator.cs" Link="Playback\PlaybackCoordinator.cs" />
    <Compile Include="..\..\src\Bodian.WinUI\Playback\PlaybackTypes.cs" Link="Playback\PlaybackTypes.cs" />
    <Compile Include="..\..\src\Bodian.WinUI\Playback\PlayQueue.cs" Link="Playback\PlayQueue.cs" />
    <Compile Include="..\..\src\Bodian.WinUI\Playback\IPlaybackService.cs" Link="Playback\IPlaybackService.cs" />
    <!-- 静音标记与「显式改音量即解除静音」。纯状态、不碰 WinUI 也不碰音频引擎，所以能离屏验。 -->
    <Compile Include="..\..\src\Bodian.WinUI\Playback\VolumeState.cs" Link="Playback\VolumeState.cs" />
    <!-- 发现页卡片区的分页算式。不引用任何 WinUI 类型，宽度为 0 / 不足一步 /
         换宽度时的锚点 / 末页夹取这些边界能离屏验。 -->
    <Compile Include="..\..\src\Bodian.WinUI\Controls\CardStripPaging.cs" Link="Controls\CardStripPaging.cs" />
    <Compile Include="..\..\src\Bodian.WinUI\Controls\CoverDropPath.cs" Link="Controls\CoverDropPath.cs" />
    <Compile Include="..\..\src\Bodian.WinUI\Services\ThemeColorMotion.cs" Link="Services\ThemeColorMotion.cs" />
    <!-- 托盘「关闭到托盘」的判定。只有两个 bool 进、一个 bool 出，不含 Win32 与窗口，
         所以那张真值表能离屏验 —— 这是托盘那一套里唯一测得到的部分。 -->
    <Compile Include="..\..\src\Bodian.WinUI\Services\TrayCloseDecision.cs" Link="Services\TrayCloseDecision.cs" />
  </ItemGroup>

  <!-- ★ 编译期注入仓库根，测试靠它定位 fixtures/。不靠遍历输出目录，也不拷贝 fixture -->
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryRoot" Value="$(MSBuildThisFileDirectory)..\..\" />
  </ItemGroup>

</Project>
