# 构建产物
[Bb]in/
[Oo]bj/
/artifacts/
*.user
*.suo
.vs/

# NuGet
packages/
*.nupkg

# 逆向用的原始安装包
# 283 MB 的第三方二进制，且 roadmap 的分发红线要求不打包官方客户端的任何二进制。
# 不入库；需要复现逆向结论时自行放置。
apk/

# 逆向分析工作区（reverse/）：只提交 findings 结论、README 与 tools 脚本，其余是二进制/工具链产物
# 目录结构与用途见 reverse/README.md
reverse/.venv/
reverse/.uv-cache/
reverse/_tools/
reverse/**/blutter/
reverse/**/*.so
reverse/**/*.log
# 反汇编转储：与 blutter 产物同类，结论落到 findings 后即可再生，正文文本几千行不留在仓库里
reverse/**/ekey/
__pycache__/

# 第三方参考源码（ref/）：P5 的歌词渲染观感与参数对齐自 BetterLyrics（GPL-3.0）。
# 整仓不入库 —— 它是外部仓库的快照，不是我们的产物；自己的代码在 src/ 下自行实现。
# 复现：git clone --depth 1 https://github.com/jayfunc/BetterLyrics.git ref/BetterLyrics
/ref/

# 本机环境
.vscode/
.dotnet/

# 随手截的界面图，不作为文档配图引用；要引用的图请放 docs/ 下
/snippet/

# WinUI 打包中间产物（EnableMsixTooling 打开后可能出现）
AppPackages/
*.appx
*.msix
*.msixupload

# 构建日志与测试结果
*.binlog
TestResults/
*.trx

# 日志兜底（正常落在 %LOCALAPPDATA%\Bodian\logs）
logs/

# 探针运行时的本机凭据（正常落在 %LOCALAPPDATA%，这里兜底防误提交）
*.token
session.json

# libmpv 原生库。**libmpv-2.dll 现在入库**（8.36 MB）：它是运行时的必需文件，
# 不入库的话 CI 打出来的包会缺库，而且 csproj 是条件拷贝、缺文件静默跳过，
# 构建不会报错 —— 只会得到一个没声音的包。完整维护说明见 docs/libmpv-audio-build.md。
libmpv/*.7z

# 写 README 与更新记录时对照的参考样例。不是项目产物，别让 git add . 带进仓库。
# 格式已落到 README.md 与 changes.md，留着只为以后改写法时对照。
/README_EXAMPLE.md
/README_EXAMPLE.assets/
/CHANGELOG_EXAMPLE.md
