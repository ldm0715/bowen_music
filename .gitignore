# 构建产物
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# NuGet
packages/
*.nupkg

# 逆向用的原始安装包
# 283 MB 的第三方二进制，且 roadmap 的分发红线要求不打包官方客户端的任何二进制。
# 不入库；需要复现逆向结论时自行放置。
apk/

# 逆向分析工作区（reverse/）：只提交 findings 与 README，其余是二进制/工具链产物
# 目录结构与用途见 reverse/README.md
reverse/.venv/
reverse/.uv-cache/
reverse/_tools/
reverse/**/blutter/
reverse/**/*.so
reverse/**/*.log
__pycache__/

# 第三方参考源码（ref/）：P5 的歌词渲染观感与参数对齐自 BetterLyrics（GPL-3.0）。
# 整仓不入库 —— 它是外部仓库的快照，不是我们的产物；自己的代码在 src/ 下自行实现。
# 复现：git clone --depth 1 https://github.com/jayfunc/BetterLyrics.git ref/BetterLyrics
/ref/

# 本机环境
.vscode/
.dotnet/

# WinUI 打包中间产物（EnableMsixTooling 打开后可能出现）
AppPackages/
*.appx
*.msix
*.msixupload

# 构建日志与测试结果
*.binlog
TestResults/
*.trx

# 日志兜底（正常落在 %LOCALAPPDATA%\Bodian\logs）
logs/

# 探针运行时的本机凭据（正常落在 %LOCALAPPDATA%，这里兜底防误提交）
*.token
session.json

# libmpv 原生库：115 MB，且是 GPLv2+ 的第三方二进制，入库会带来对应的源码提供义务。
# 只保留 libmpv/README.md（来源、校验和、复现步骤），见该文件。
libmpv/*.dll
libmpv/*.7z
