                            -->
                            <Path Data="F0 M78.5,58 H241.5 A2.5,2.5 0 0 1 244,60.5 V169.5 A2.5,2.5 0 0 1 241.5,172 H78.5 A2.5,2.5 0 0 1 76,169.5 V60.5 A2.5,2.5 0 0 1 78.5,58 Z M76,112 A24,24 0 1 1 124,112 A24,24 0 1 1 76,112 Z M196,112 A24,24 0 1 1 244,112 A24,24 0 1 1 196,112 Z">
                                <Path.Fill>
