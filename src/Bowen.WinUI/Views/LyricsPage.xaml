<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Bowen.WinUI.Views.LyricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bowen.WinUI.Controls"
    xmlns:local="using:Bowen.WinUI"
    xmlns:models="using:Bowen.Core.Models" RequestedTheme="Dark"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Page.Resources>
        <!-- 按钮外观与图标都不再单写：外观在 Themes/Styles/Player.xaml，图标走 Controls/Icon。 -->

        <!-- 歌词外观浮层：沿用设置页 / 评论面板已有的字号、圆角与间距 token。 -->
        <Style x:Key="LyricsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="LyricsValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LyricsResetButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerBareIconButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="LyricsSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsThumbToolTipEnabled" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 分享面板的整行入口：图标 + 标题 + 一行说明。 -->
        <Style x:Key="ShareMenuRowStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!--
            对齐分段：与评论面板的「推荐 / 最新」同一套 ToggleButton 形态。
            选中态由 AccentFillColorDefaultBrush 提供，只亮当前一颗。
        -->
        <Style x:Key="LyricsSegmentButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!--
            极简键：一颗细线圆键，平时只有一圈描边，悬停提亮、按下压暗。
            背景与描边都走模板绑定，播放键可以单独填成浅色实心，成为画面唯一的焦点。
        -->
        <Style x:Key="Mp3KeyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="#3A424A" />
            <Setter Property="Foreground" Value="#C8CDD3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <Border x:Name="Key" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="1"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Key.BorderBrush">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="#8A949E" />
                                                </Setter.Value>
                                            </Setter>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Key.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.35" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            方向键扇形：四块扇形叠在同一个 136 圆里，各自的 Path 决定外观与命中区域。
            模板根节点不能有背景，否则每块都会盖住整个圆、互相挡住点击。
        -->
        <Style x:Key="Mp3SectorButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="136" />
            <Setter Property="Height" Value="136" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="SectorContent"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            磁带键：一颗实心小键，悬停变淡、按下更暗。
            模板根节点透明，键面完全由 Border 画出来，命中区只有键本身。
        -->
        <Style x:Key="CassetteKeyStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent">
                            <Border x:Name="Key" CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                            <!-- 键帽高光：上沿一道玻璃反光，下沿一道内阴影，实体键才不至于像色块 -->
                            <Border x:Name="Gloss" CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3DFFFFFF" Offset="0" />
                                        <GradientStop Color="#0FFFFFFF" Offset="0.34" />
                                        <GradientStop Color="#00000000" Offset="0.36" />
                                        <GradientStop Color="#2E000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Hover" CornerRadius="{TemplateBinding CornerRadius}"
                                Background="#14FFFFFF" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Hover.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Key.Opacity" Value="0.8" />
                                            <Setter Target="Hover.Opacity" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="AudioEffectsStates">
            <VisualState x:Name="AudioEffectsInactive">
                <VisualState.Setters>
                    <Setter Target="EffectsHalo.Visibility" Value="Collapsed" />
                    <Setter Target="EffectsIcon.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="AudioEffectsActive">
                <VisualState.Setters>
                    <Setter Target="EffectsHalo.Visibility" Value="Visible" />
                    <Setter Target="EffectsIcon.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!--
        KeyboardAcceleratorPlacementMode="Hidden" 是必须的，不是可选装饰。

        快捷键声明在 Page 上时，WinUI 默认会把「第一个快捷键」塞进**页内所有**控件的
        tooltip（KeyboardAcceleratorPlacementMode 的 Auto 行为）—— 于是鼠标划过页面上
        任何没有自己 tooltip 的地方都会冒出一个「Esc」。这里数组第一个正是 Escape，
        所以只有它出现。下面那几颗按钮的 tooltip 是自己写的（「收起歌词 (Esc)」），
        显式 tooltip 会覆盖默认行为，所以它们看着正常。

        置成 Hidden 只关掉自动 tooltip，快捷键本身照常生效。
    -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        <KeyboardAccelerator Key="F11" Invoked="OnFullscreenInvoked" />
        <KeyboardAccelerator Key="Space" Invoked="OnPlayPauseInvoked" />
    </Page.KeyboardAccelerators>
    <Grid x:Name="LyricsRoot" Background="Transparent" SizeChanged="OnRootSizeChanged">
        <!--
            背景单独一层：收起时整块向下退场（与 LyciaMusic 的 600 ms 一致），
            底色从 LyricsRoot 挪到这里，root 本身保持透明，位移时不会留一条不动的底边。
        -->
        <Grid x:Name="BackdropLayer" Background="#0B1222">
            <controls:LyricsBackdrop x:Name="BackdropView" CoverUri="{x:Bind Player.CurrentCoverUri, Mode=OneWay}" />
            <controls:AmbientBackdrop x:Name="AmbientView" Opacity="0.18" />
            <!-- 自定义图片的暗度蒙版：必须在图片之上，Grid.Background 画在子元素后面压不到。 -->
            <Border x:Name="BackgroundDimLayer" IsHitTestVisible="False" Background="Black" Opacity="0" />
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#08000000" Offset="0" />
                        <GradientStop Color="#08000000" Offset="0.5" />
                        <GradientStop Color="#58000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>
        <!-- 内容整体淡出；封面本身由共享封面动画独立回位。 -->
        <Grid x:Name="ContentLayer">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="80" />
            </Grid.RowDefinitions>
            <TitleBar x:Name="LyricsTitleBar" Height="48" VerticalAlignment="Top"
                Background="Transparent" Foreground="#CCFFFFFF" AutomationProperties.Name="全屏歌词标题栏">
                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                    <x:Double x:Key="TitleBarExpandedHeight">48</x:Double>
                    <x:Double x:Key="TitleBarLeftPaddingWidth">0</x:Double>
                    <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
                    <Thickness x:Key="TitleBarCompactContentMargin">0</Thickness>
                    <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
                    <!-- WinUI 默认在窗口失焦时把标题栏内容压到 50% 不透明度；这里保持原样。 -->
                    <x:Double x:Key="TitleBarDeactivatedOpacity">1</x:Double>
                </TitleBar.Resources>
                <TitleBar.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="LeftChromeHost" Grid.Column="0" Width="186">
                            <Button x:Name="CollapseButton" Click="OnBackClick" Style="{StaticResource PlayerRoundIconButtonStyle}"
                                HorizontalAlignment="Left" Margin="16,0,0,0"
                                AutomationProperties.Name="收起歌词" ToolTipService.ToolTip="收起歌词 (Esc)">
                                <Button.Resources>
                                    <!-- 图标按钮禁用时不该有底色：默认模板的 Disabled 态会铺 ButtonBackgroundDisabled，
                                        盖住 Background="Transparent"。这里连同描边一起置空，只用前景色变淡表示禁用。 -->
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                </Button.Resources>

                                <controls:Icon Data="{StaticResource IconChevronDown}" Size="{StaticResource SizeIconMd}" />
                            </Button>
                        </Grid>

                        <Button x:Name="FullscreenButton" Grid.Column="2" Click="OnFullscreenClick"
                            Style="{StaticResource PlayerRoundIconButtonStyle}"
                            AutomationProperties.Name="切换全屏" ToolTipService.ToolTip="进入全屏 (F11)">
                            <Button.Resources>
                                <!-- 图标按钮禁用时不该有底色：默认模板的 Disabled 态会铺 ButtonBackgroundDisabled，
                                    盖住 Background="Transparent"。这里连同描边一起置空，只用前景色变淡表示禁用。 -->
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                            </Button.Resources>

                            <controls:Icon x:Name="FullscreenIcon" Data="{StaticResource IconFullScreen}" Size="{StaticResource SizeIconMd}" />
                        </Button>
                    </Grid>
                </TitleBar.Content>
            </TitleBar>
            <Grid x:Name="HeadingHost" Height="48" Margin="64,0,64,0" VerticalAlignment="Top"
                IsHitTestVisible="False" SizeChanged="OnHeadingHostSizeChanged">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <!--
                        标题与付费徽标放同一个横向 StackPanel，徽标才会紧跟标题。
                        用 `*`/`Auto` 两列时 `*` 列会吃满标题行，徽标被推到最右边、和标题拉开一大截。
                        代价是 StackPanel 不约束子元素，标题要自己带上限 ——
                        **上限由 code-behind 在尺寸变化时设，不在这里绑**，原因见 UpdateHeadingWidth。
                    -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <TextBlock x:Name="HeadingTitle" Text="{x:Bind SongHeading(Player.Title, Player.ArtistText), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold"
                            VerticalAlignment="Center" Foreground="#CCFFFFFF" />
                        <Border x:Name="PayBadge" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                            Background="#24FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1"
                            Visibility="{x:Bind local:Formats.Visible(Player.HasPayLabel), Mode=OneWay}">
                            <TextBlock Text="{x:Bind Player.PayLabel, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Player.AlbumText, Mode=OneWay}" TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#80FFFFFF" />
                </StackPanel>
            </Grid>
            <Grid x:Name="MainStage" Grid.Row="1" Margin="32,0,24,80" ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Canvas x:Name="CoverDeck" Width="320" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind local:Formats.Visible(Player.HasTrack), Mode=OneWay}">
                    <controls:AlbumCoverReflection x:Name="ReflectionView" Width="320" Height="176" Canvas.Top="322"
                        Opacity="0.25" CoverUri="{x:Bind Player.CurrentCoverUri, Mode=OneWay}" />
                    <!--
                        黑胶旋转只作用于这一层：方形封面与中心标签共用同一个 CoverFrame，
                        倒影和唱臂留在层外——否则倒影会跟着转、唱臂会跟着盘面转。
                    -->
                    <!--
                        放台不参与换碟动画：碟在它上面滑走，它留在原地。
                        它必须放在裁剪层外面，否则会跟着唱片一起被裁掉。
                    -->
                    <Ellipse x:Name="VinylPlatter" Fill="#19191C" Stroke="#1FFFFFFF" StrokeThickness="1"
                        Visibility="Collapsed" />
                    <!--
                        机身与按键压在 DetailCover 之下：屏幕里的专辑图仍然是 DetailCover，
                        共享封面动画的落点不用另起一张图。
                    -->
                    <Canvas x:Name="Mp3DeviceBack" Width="320" Height="320" Visibility="Collapsed">
                        <!-- 落在桌面上的投影 -->
                        <Rectangle Width="196" Height="22" Canvas.Left="62" Canvas.Top="288" RadiusX="11" RadiusY="11"
                            IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#99000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Grid Canvas.Left="48" Canvas.Top="16" Width="224" Height="288" IsHitTestVisible="False">
                            <!-- 哑光机身：一整块干净的圆角面，只有一圈极细的亮边 -->
                            <Border x:Name="Mp3Shell" CornerRadius="26" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#22262C" Offset="0" />
                                        <GradientStop Color="#171A1E" Offset="0.55" />
                                        <GradientStop Color="#111317" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#4A525C" Offset="0" />
                                        <GradientStop Color="#242A31" Offset="0.35" />
                                        <GradientStop Color="#1B1F24" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <!-- 屏幕：上置的宽屏面板，纯平面板，不做玻璃与内凹 -->
                            <Grid Width="184" Height="124" Margin="20,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Border CornerRadius="10" Background="#0B0D10" BorderBrush="#272D34" BorderThickness="1" />
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <!-- 状态栏：左电量、右时钟 -->
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <!-- 电池：外框 15×9，右侧 2 宽的正极；填充条内侧左右各留 1px -->
                                            <Grid Width="17" Height="9" VerticalAlignment="Center">
                                                <Rectangle Width="15" Height="9" RadiusX="2" RadiusY="2"
                                                    Stroke="#6F7983" StrokeThickness="1" HorizontalAlignment="Left" />
                                                <Rectangle x:Name="Mp3BatteryFill" Width="7" Height="5"
                                                    RadiusX="1" RadiusY="1" Fill="#C9D6E2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
                                                <Rectangle Width="2" Height="5" RadiusX="1" RadiusY="1"
                                                    Fill="#6F7983" HorizontalAlignment="Right" />
                                            </Grid>
                                            <TextBlock x:Name="Mp3BatteryText" FontSize="8" Foreground="#6F7983"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="Mp3ClockText" FontSize="9" Foreground="#6F7983"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <!-- 主信息：封面在左，曲名、歌手、下一首在右；整块水平居中 -->
                                    <Grid Grid.Row="2" HorizontalAlignment="Center" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="60" Height="60" CornerRadius="7" VerticalAlignment="Top"
                                            Background="#14181D" BorderBrush="#232A31" BorderThickness="1" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock x:Name="Mp3TitleText" FontSize="12" Foreground="#E3E9F0"
                                                TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                            <TextBlock x:Name="Mp3ArtistText" FontSize="9" Foreground="#8A939C"
                                                TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock x:Name="Mp3NextText" FontSize="8" Foreground="#6B757E"
                                                TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- 进度 -->
                                    <Grid x:Name="Mp3ProgressTrack" Grid.Row="3" Height="2" Margin="0,5,0,0">
                                        <Rectangle Height="2" Fill="#232A31" />
                                        <Rectangle x:Name="Mp3ProgressFill" Width="0" Height="2"
                                            HorizontalAlignment="Left" Fill="#C9D6E2" />
                                    </Grid>
                                    <!-- 已播 / 总时长 -->
                                    <Grid Grid.Row="4" Margin="0,3,0,0">
                                        <TextBlock x:Name="Mp3ElapsedText" FontSize="8" Foreground="#5C666F" />
                                        <TextBlock x:Name="Mp3DurationText" FontSize="8" Foreground="#5C666F"
                                            HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                        <!--
                            方向键：一个完整的圆切成四块 90° 扇形，每块是一个独立按钮。
                            扇形之间不留楔形空隙，改用等宽的分割线切过去，看起来才像「圆被切开」；
                            分割线和内外圈都画在按钮之上，且不参与命中。
                        -->
                        <Button x:Name="Mp3UpButton" Canvas.Left="92" Canvas.Top="156" Style="{StaticResource Mp3SectorButtonStyle}"
                            Click="OnMp3VolumeUpClick" PointerEntered="OnMp3SectorEntered" PointerExited="OnMp3SectorExited"
                            AutomationProperties.Name="音量加" ToolTipService.ToolTip="音量加">
                            <Path Data="M44,44 L20,20 A68,68 0 0 1 116,20 L92,44 A34,34 0 0 0 44,44 Z" Fill="#1C2126" />
                        </Button>
