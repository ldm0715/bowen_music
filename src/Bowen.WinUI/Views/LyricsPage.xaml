                        <Line X1="47" Y1="21.5" X2="50" Y2="24.5" Stroke="#6E7479" StrokeThickness="0.75" IsHitTestVisible="False" />
                        <Line X1="270" Y1="21.5" X2="273" Y2="24.5" Stroke="#6E7479" StrokeThickness="0.75" IsHitTestVisible="False" />
                        <Line X1="47" Y1="296.5" X2="50" Y2="299.5" Stroke="#6E7479" StrokeThickness="0.75" IsHitTestVisible="False" />
                        <Line X1="270" Y1="296.5" X2="273" Y2="299.5" Stroke="#6E7479" StrokeThickness="0.75" IsHitTestVisible="False" />

                        <!-- 底部刻度：code-behind 批量生成 -->
                        <Canvas x:Name="CassetteTicks" Width="120" Height="8" Canvas.Left="100" Canvas.Top="292"
                            IsHitTestVisible="False" />
                    </Canvas>
                    <!-- 换碟滑动只裁这块区域：滑出去的唱片不会压到窗口左侧，倒影和唱臂不受影响。 -->
                    <Grid x:Name="VinylClipHost" Width="320" Height="320" controls:Motion.ClipToBounds="True">
                    <Grid x:Name="VinylSpinLayer" Width="320" Height="320">
                        <Grid x:Name="VinylDisc" Visibility="Collapsed">
                            <Ellipse x:Name="VinylDiscBase" Fill="#0B0B0C" />
                            <Ellipse x:Name="VinylDiscRim" Width="318" Height="318"
                                Stroke="#2EFFFFFF" StrokeThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- 纹路由 code-behind 批量生成：密密麻麻的细圈，间距不能靠手写 XAML。 -->
                        </Grid>
                        <Border x:Name="CoverFrame" Width="320" Height="320" CornerRadius="16" Background="#18FFFFFF">
                            <Image x:Name="DetailCover" controls:Motion.SharedCoverKey="{x:Bind local:Formats.TrackCoverKey(Player.CurrentTrackId), Mode=OneWay}" Source="{x:Bind Player.CoverImage, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                        <!-- 轴孔：压住中心标签，黑胶模式下随盘面一起转（圆形所以看不出来）。 -->
                        <Ellipse x:Name="VinylSpindle" Width="12" Height="12" Visibility="Collapsed"
                            Fill="#0B0B0C" Stroke="#40FFFFFF" StrokeThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!--
                            换碟时盖住已经更新的真实标签，让滑出去的那张碟仍是旧封面。
                            只在滑出阶段显示，完成后收起，滑入的就是新封面。
                        -->
                        <Border x:Name="CoverSwapLabel" Width="120" Height="120" CornerRadius="60"
                            Background="#18FFFFFF" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="CoverSwapLabelImage" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                    </Grid>
                    <!--
                        磁带机前层：仓窗玻璃、标签描边、曲名铭牌与底部机械按键。
                        按键是正视图里的一排实体键，与机身底边平行，不做顶面视角。
                    -->
                    <Canvas x:Name="CassetteDeviceFront" Width="320" Height="320" Visibility="Collapsed">
                        <!-- 仓窗玻璃：极淡的反光，压在磁带与标签之上；开盖时跟着淡出 -->
                        <Border x:Name="CassetteGlass" Canvas.Left="60" Canvas.Top="40" Width="200" Height="150" CornerRadius="4"
                            BorderBrush="#7B7F82" BorderThickness="1" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0FFFFFFF" Offset="0" />
                                    <GradientStop Color="#03FFFFFF" Offset="0.45" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- 曲名与歌手印在磁带的纸标签上，仓门下方只留出厂印刷 -->

                        <!-- 出厂印刷 -->
                        <TextBlock Canvas.Left="56" Canvas.Top="28" FontSize="6.5" Foreground="#55595C"
                            Text="BOWEN" IsHitTestVisible="False" />
                        <TextBlock Canvas.Left="212" Canvas.Top="224" FontSize="5.5" Foreground="#6A6E72"
                            Text="AUTO REVERSE" IsHitTestVisible="False" />

                        <!-- 底部机械按键：上一首 / 播放 / 停止 / 下一首 -->
                        <Button x:Name="CassettePreviousButton" Canvas.Left="61" Canvas.Top="246" Width="40" Height="26"
                            CornerRadius="4" Style="{StaticResource CassetteKeyStyle}" BorderThickness="1"
                            Command="{x:Bind Player.PreviousCommand}" IsEnabled="{x:Bind Player.CanGoPrevious, Mode=OneWay}"
                            AutomationProperties.Name="上一首" ToolTipService.ToolTip="上一首">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#5D6266" Offset="0" />
                                    <GradientStop Color="#454A4E" Offset="0.35" />
                                    <GradientStop Color="#272B2F" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#7B8084" Offset="0" />
                                    <GradientStop Color="#1E2226" Offset="1" />
                                </LinearGradientBrush>
                            </Button.BorderBrush>
                            <controls:Icon Size="9" Data="{StaticResource IconChevronDown}" Foreground="#D5DADF"
                                RenderTransformOrigin="0.5,0.5">
                                <controls:Icon.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </controls:Icon.RenderTransform>
                            </controls:Icon>
                        </Button>
                        <Button x:Name="CassettePlayButton" Canvas.Left="107" Canvas.Top="246" Width="60" Height="26"
                            CornerRadius="4" Style="{StaticResource CassetteKeyStyle}" BorderThickness="1"
                            Command="{x:Bind Player.TogglePlayPauseCommand}" IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                            AutomationProperties.Name="播放或暂停" ToolTipService.ToolTip="播放或暂停 (Space)">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F26454" Offset="0" />
                                    <GradientStop Color="#D8352A" Offset="0.45" />
                                    <GradientStop Color="#AC2018" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF8A7D" Offset="0" />
                                    <GradientStop Color="#8E1C15" Offset="1" />
                                </LinearGradientBrush>
                            </Button.BorderBrush>
                            <Grid>
                                <controls:Icon Size="11" Data="{StaticResource IconPlay}" Foreground="#FFFFFFFF"
                                    Visibility="{x:Bind local:Formats.VisibleWhenFalse(Player.IsPlaying), Mode=OneWay}" />
                                <controls:Icon Size="11" Data="{StaticResource IconPause}" Foreground="#FFFFFFFF"
                                    Visibility="{x:Bind local:Formats.Visible(Player.IsPlaying), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button x:Name="CassetteStopButton" Canvas.Left="173" Canvas.Top="246" Width="40" Height="26"
                            CornerRadius="4" Style="{StaticResource CassetteKeyStyle}" BorderThickness="1"
                            Click="OnCassetteStopClick" IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                            AutomationProperties.Name="停止" ToolTipService.ToolTip="停止">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#5D6266" Offset="0" />
                                    <GradientStop Color="#454A4E" Offset="0.35" />
                                    <GradientStop Color="#272B2F" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#7B8084" Offset="0" />
                                    <GradientStop Color="#1E2226" Offset="1" />
                                </LinearGradientBrush>
                            </Button.BorderBrush>
                            <Rectangle Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="#D5DADF" />
                        </Button>
                        <Button x:Name="CassetteNextButton" Canvas.Left="219" Canvas.Top="246" Width="40" Height="26"
                            CornerRadius="4" Style="{StaticResource CassetteKeyStyle}" BorderThickness="1"
                            Command="{x:Bind Player.NextCommand}" IsEnabled="{x:Bind Player.CanGoNext, Mode=OneWay}"
                            AutomationProperties.Name="下一首" ToolTipService.ToolTip="下一首">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#5D6266" Offset="0" />
                                    <GradientStop Color="#454A4E" Offset="0.35" />
                                    <GradientStop Color="#272B2F" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#7B8084" Offset="0" />
                                    <GradientStop Color="#1E2226" Offset="1" />
                                </LinearGradientBrush>
                            </Button.BorderBrush>
                            <controls:Icon Size="9" Data="{StaticResource IconChevronDown}" Foreground="#D5DADF"
                                RenderTransformOrigin="0.5,0.5">
                                <controls:Icon.RenderTransform>
                                    <RotateTransform Angle="270" />
                                </controls:Icon.RenderTransform>
                            </controls:Icon>
                        </Button>

                        <!-- 键名 -->
                        <TextBlock Canvas.Left="61" Canvas.Top="276" Width="40" FontSize="5.5" TextAlignment="Center"
                            Foreground="#5C6064" Text="PREV" IsHitTestVisible="False" />
                        <TextBlock Canvas.Left="107" Canvas.Top="276" Width="60" FontSize="5.5" TextAlignment="Center"
                            Foreground="#5C6064" Text="PLAY" IsHitTestVisible="False" />
                        <TextBlock Canvas.Left="173" Canvas.Top="276" Width="40" FontSize="5.5" TextAlignment="Center"
                            Foreground="#5C6064" Text="STOP" IsHitTestVisible="False" />
                        <TextBlock Canvas.Left="219" Canvas.Top="276" Width="40" FontSize="5.5" TextAlignment="Center"
                            Foreground="#5C6064" Text="NEXT" IsHitTestVisible="False" />
                    </Canvas>
                    <!-- 唱臂：枢轴固定在盘面左上，臂杆绕枢轴在「落到盘面」与「抬起」之间摆动。 -->
                    <Canvas x:Name="TonearmHost" Width="320" Height="320" Visibility="Collapsed">
                        <!--
                            折线唱臂：上段从枢轴往下，折点后下段朝左下伸到盘缘。
                            Angle 与枢轴、各段长度一样按封面槽尺寸在 code-behind 里重算。
                        -->
                        <Canvas x:Name="TonearmRotor" Width="30" Height="150">
                            <Rectangle x:Name="TonearmWeight" Width="12" Height="15" RadiusX="4" RadiusY="4" Fill="#DADADA"
                                Tapped="OnTonearmTapped" />
                            <!-- 整根杆是一笔 Path：折点用圆角过渡，不画成两根直杆硬拼。 -->
                            <Path x:Name="TonearmRod" Stroke="#EDEDED"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <!-- 命中区：沿臂杆铺一条透明粗线，杆本身太细，点不准。 -->
                            <Path x:Name="TonearmHitPath" Stroke="Transparent"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                Tapped="OnTonearmTapped" AutomationProperties.Name="播放或暂停" />
                            <Rectangle x:Name="TonearmHead" Width="14" Height="24" RadiusX="4" RadiusY="4"
                                Fill="#F5F5F5" RenderTransformOrigin="0.5,0.5" Tapped="OnTonearmTapped">
                                <Rectangle.RenderTransform>
                                    <RotateTransform x:Name="TonearmHeadTilt" Angle="78" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Canvas>
                        <Ellipse x:Name="TonearmPivot" Width="18" Height="18" Fill="#F0F0F0" Tapped="OnTonearmTapped" />
                    </Canvas>
                </Canvas>
                <Grid Grid.Column="1" Margin="0,0,0,4">
                    <ContentControl x:Name="CanvasHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <!--
                        译文开关。原本挂在标题栏右端、与全屏并排；搬到歌词区域右下角，是因为
                        歌词画布占满整列，浮在右上角时鼠标过去容易先落到歌词行上（点行是跳转）。

                        ★ 压在「回到当前歌词」下面一档：这颗占最底，那颗的底边距见下面它自己的 Margin。
                          两者同时出现时上下错开，不会叠在一起。

                        ★ 这首歌没有译文时整颗不显示（判据见 code-behind 的 SyncTranslationButtonVisibility）——
                          留一颗点不动的按钮比没有它更让人困惑。显隐统一由那个方法一处算：
                          没译文 / chrome 收起（沉浸） / 全屏，三条任一成立就藏。
                          这里是 Collapsed 起步，免得页面刚加载、那个方法还没跑时先闪出来一下。
                    -->
                    <Button x:Name="TranslationButton" Click="OnTranslationClick" Style="{StaticResource PlayerRoundIconButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,0"
                        IsEnabled="{x:Bind Lyrics.HasTranslation, Mode=OneWay}"
                        Visibility="Collapsed"
                        AutomationProperties.Name="显示译文">
                        <Button.Resources>
                            <!-- 图标按钮禁用时不该有底色：默认模板的 Disabled 态会铺 ButtonBackgroundDisabled，
                                盖住 Background="Transparent"。这里连同描边一起置空，只用前景色变淡表示禁用。 -->
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Button.Resources>

                        <controls:Icon x:Name="TranslationIcon" Data="{StaticResource IconTranslate}" Size="{StaticResource SizeIconMd}" />
                    </Button>

                    <!-- ★ 底边距给译文按钮让位：那颗压在最底（底边距 0、高 32），这颗上抬到 56，
                         两者之间留 24 的间隙。改按钮尺寸时这一个数要跟着重算。 -->
                    <Button x:Name="FollowButton" Content="回到当前歌词" Click="OnFollowClick"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,56"
                        Visibility="Collapsed" AutomationProperties.Name="回到当前歌词" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="420">
                        <ProgressRing Width="24" Height="24" IsActive="{x:Bind Lyrics.IsLoading, Mode=OneWay}"
                            Visibility="{x:Bind local:Formats.Visible(Lyrics.IsLoading), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Lyrics.StatusText, Mode=OneWay}" Foreground="#A6FFFFFF" FontSize="18"
                            TextAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind local:Formats.Visible(Lyrics.HasStatusText), Mode=OneWay}" />
                        <Button Content="重试" Command="{x:Bind Lyrics.RetryCommand}" HorizontalAlignment="Center"
                            Visibility="{x:Bind local:Formats.Visible(Lyrics.LoadFailed), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <ContentControl x:Name="SpectrumHost" Grid.Row="1" Height="64" Margin="20,0,20,12"
                VerticalAlignment="Bottom" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                IsHitTestVisible="False" />
            <!--
                ★ 上边距 17 是为了让播放键**落在和播放条同一个高度**上 ——
                  点封面进歌词页时那颗键不该跳。算式：
                    播放条   进度行 2 + 内容区 78/2 = 距窗口底部 39
                    这一页   行高 80 − 上边距 − 传输行 48/2 = 距窗口底部 39  →  上边距 = 80 − 39 − 24 = 17
                  改播放条的 78 或这里的 80 / 48 时，这个数要跟着重算。
            -->
            <Grid x:Name="ControlDeck" Grid.Row="2" Margin="24,17,24,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--
                    传输组：外观 · 播放模式 · 上一首 · 播放/暂停 · 下一首 · 播放列表。
                    中间五颗与底部播放条**同一套尺寸**（模式 26 / 上下一首 28 / 播放 24 / 队列 22）。
                    改这里时播放条也要一起改，两边别各走各的。

                    外观按钮只在歌词页出现。右侧放一颗等宽的透明占位，
                    抵消左侧新增的按钮与间距，播放/暂停才能继续落在窗口水平中线。
                -->
                <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AppearanceButton" Width="36" Height="36" MinWidth="0" Padding="0"
                        Margin="0,0,24,0" Style="{StaticResource PlayerBareIconButtonStyle}"
                        Click="OnAppearanceClick"
                        AutomationProperties.Name="歌词外观" ToolTipService.ToolTip="歌词外观">
                        <TextBlock Text="A" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24">
                        <Button AutomationProperties.Name="播放模式"
                            Command="{x:Bind Player.CyclePlayModeCommand}"
                            Style="{StaticResource PlayerBareIconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind Player.PlayModeText, Mode=OneWay}">
                            <Grid>
                                <controls:Icon Data="{StaticResource IconSequential}" Size="26"
                                    Visibility="{x:Bind local:Formats.Visible(Player.IsSequentialMode), Mode=OneWay}" />
                                <controls:Icon Data="{StaticResource IconListLoop}" Size="26"
                                    Visibility="{x:Bind local:Formats.Visible(Player.IsListLoopMode), Mode=OneWay}" />
                                <controls:Icon Data="{StaticResource IconSingleLoop}" Size="26"
                                    Visibility="{x:Bind local:Formats.Visible(Player.IsSingleLoopMode), Mode=OneWay}" />
                                <controls:Icon Data="{StaticResource IconShuffle}" Size="26"
                                    Visibility="{x:Bind local:Formats.Visible(Player.IsShuffleMode), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource PlayerBareIconButtonStyle}" Command="{x:Bind Player.PreviousCommand}"
                            IsEnabled="{x:Bind Player.CanGoPrevious, Mode=OneWay}" AutomationProperties.Name="上一首" ToolTipService.ToolTip="上一首">
                            <controls:Icon Data="{StaticResource IconPrevious}" Size="28" />
                        </Button>
                        <Button Style="{StaticResource PlayerAccentButtonStyle}" Command="{x:Bind Player.TogglePlayPauseCommand}"
                            IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}" AutomationProperties.Name="播放 / 暂停" ToolTipService.ToolTip="播放 / 暂停 (Space)">
                            <Grid>
                                <controls:Icon Size="24" Data="{StaticResource IconPlay}"
                                    Visibility="{x:Bind local:Formats.VisibleWhenFalse(Player.IsPlaying), Mode=OneWay}" />
                                <controls:Icon Size="24" Data="{StaticResource IconPause}"
                                    Visibility="{x:Bind local:Formats.Visible(Player.IsPlaying), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource PlayerBareIconButtonStyle}" Command="{x:Bind Player.NextCommand}"
                            IsEnabled="{x:Bind Player.CanGoNext, Mode=OneWay}" AutomationProperties.Name="下一首" ToolTipService.ToolTip="下一首">
                            <controls:Icon Data="{StaticResource IconNext}" Size="28" />
                        </Button>
                        <!-- 队列抽屉归主窗口管（要盖住内容区），这里只抛给它去开合。 -->
                        <Button AutomationProperties.Name="播放列表" Click="OnQueueClick"
                            Style="{StaticResource PlayerBareIconButtonStyle}"
                            ToolTipService.ToolTip="播放列表">
                            <controls:Icon Data="{StaticResource IconQueue}" Size="22" />
                        </Button>
                    </StackPanel>
                    <Border Grid.Column="2" Width="36" Margin="24,0,0,0" IsHitTestVisible="False" />
                </Grid>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="8">
                    <controls:TrackStatisticButton x:Name="FavoriteButton" Data="{StaticResource IconHeart}" ActiveData="{StaticResource IconHeartFilled}"
                        Foreground="#CCFFFFFF"
                        IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                        IsActive="{x:Bind Player.Statistics.IsFavorite, Mode=OneWay}"
                        Command="{x:Bind Player.ToggleFavoriteCommand}"
                        Label="{x:Bind Player.Statistics.FavoriteAutomationName, Mode=OneWay}"
                        BadgeText="{x:Bind Player.Statistics.FavoriteBadgeText, Mode=OneWay}"
                        HasBadgeCount="{x:Bind Player.Statistics.HasFavoriteCount, Mode=OneWay}" />
                    <controls:TrackStatisticButton x:Name="ShareButton" Data="{StaticResource IconShare}" Foreground="#CCFFFFFF"
                        IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                        Label="{x:Bind Player.Statistics.ShareAutomationName, Mode=OneWay}"
                        BadgeText="{x:Bind Player.Statistics.ShareBadgeText, Mode=OneWay}"
                        HasBadgeCount="{x:Bind Player.Statistics.HasShareCount, Mode=OneWay}">
                        <controls:TrackStatisticButton.Flyout>
                            <Flyout
                                x:Name="ShareFlyout"
                                Closed="OnShareFlyoutClosed"
                                Opened="OnShareFlyoutOpened"
                                Opening="OnShareFlyoutOpening"
                                Placement="Top">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="Background" Value="{ThemeResource BowenAcrylicBrush}" />
                                        <Setter Property="Padding" Value="6" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>

                                <StackPanel x:Name="ShareMenu" MaxWidth="280">
                                    <Button Click="OnCopyShareLinkClick" Style="{StaticResource ShareMenuRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:Icon
                                                Size="18"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource IconShare}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="复制分享链接" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Opacity="0.6"
                                                    Text="链接包含你的 uid"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <Button
                                        x:Name="MakePosterButton"
                                        Click="OnMakePosterClick"
                                        Style="{StaticResource ShareMenuRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:Icon
                                                Size="18"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource IconNote}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="制作歌词海报" />
                                                <TextBlock
                                                    x:Name="MakePosterSubtitle"
                                                    FontSize="12"
                                                    Opacity="0.6"
                                                    Text="把歌词做成一张图片"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </controls:TrackStatisticButton.Flyout>
                    </controls:TrackStatisticButton>
                    <TextBlock Text="试听" Foreground="#70FFFFFF" FontSize="12" VerticalAlignment="Center"
                        Visibility="{x:Bind local:Formats.Visible(Player.IsAudition), Mode=OneWay}" />
                </StackPanel>
                <!--
                    ★ Spacing 16 而不是左边那组的 8：音质标签是撑满按钮的方块，
                      旁边「评论」「音量」都是外圈留白的图标按钮 —— 数值一样时，
                      方块那侧的视觉空隙只有一半，看着就挤。
                      左边收藏 / 分享两颗都是图标按钮，没有这个问题，保持 8。
                -->
                <StackPanel x:Name="VolumeDeck" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="16">
                    <!--
                        更多：菜单内容与曲目行那颗完全同源（TrackActionsMenu），所以查看歌手/专辑、
                        加入歌单这些不用在这一页重写一遍。

                        **常显**（不靠悬停出现），没有曲目时整颗折叠 —— 与旁边 MV 那颗同一口径。
                        放在这一组最左端，是为了让音量继续守在屏幕最右角；整组右锚定，
                        加一颗不会移动中间传输键的整窗中线。
                    -->
                    <Button
                        x:Name="MoreButton"
                        AutomationProperties.Name="更多"
                        Style="{StaticResource PlayerRoundIconButtonStyle}"
                        ToolTipService.ToolTip="更多"
                        Visibility="{x:Bind local:Formats.Visible(Player.HasTrack), Mode=OneWay}">
                        <Button.Resources>
                            <!-- 图标按钮禁用时不该有底色：默认模板的 Disabled 态会铺 ButtonBackgroundDisabled，
                                 盖住 Background="Transparent"。这里连同描边一起置空，只用前景色变淡表示禁用。 -->
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Button.Resources>

                        <controls:Icon Data="{StaticResource IconMore}" Size="14" />

                        <Button.Flyout>
                            <Flyout
                                x:Name="MoreFlyout"
                                Closed="OnMoreFlyoutClosed"
                                Opened="OnMoreFlyoutOpened"
                                Opening="OnMoreFlyoutOpening"
                                Placement="Top">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="Background" Value="{ThemeResource BowenAcrylicBrush}" />
                                        <Setter Property="Padding" Value="6" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>

                                <!--
                                    Scope="Player"：去掉「我喜欢 / 下一首播放 / 加入播放队列」——
                                    喜欢在这一页左下角本来就有颗带计数的按钮，另两项对一首已经在放的歌也没用。
                                -->
                                <controls:TrackActionsMenu
                                    x:Name="MoreMenu"
                                    CloseRequested="OnMoreMenuCloseRequested"
                                    Scope="Player" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!--
                        评论入口与左下角的收藏 / 分享用同一个控件，尺寸和角标样式天然一致；
                        面板打开时用 IsActive 换成强调色图标，不再由代码改前景色。
                    -->
                    <!-- MV 入口。与播放条一致：没有 MV 就整颗折叠，不置灰。 -->
                    <Button x:Name="MvButton" Click="OnMvClick" Style="{StaticResource PlayerRoundIconButtonStyle}"
                        Visibility="{x:Bind local:Formats.Visible(Player.HasMv), Mode=OneWay}"
                        AutomationProperties.Name="播放 MV" ToolTipService.ToolTip="播放 MV">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Button.Resources>
                        <controls:Icon Data="{StaticResource IconMv}" Size="16" />
                    </Button>
                    <controls:TrackStatisticButton x:Name="CommentsButton" Data="{StaticResource IconComment}" ActiveData="{StaticResource IconComment}"
                        Foreground="#CCFFFFFF"
                        IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                        IsActive="{x:Bind Comments.IsOpen, Mode=OneWay}"
                        Click="OnCommentsClick"
                        Label="{x:Bind Comments.BadgeAutomationName, Mode=OneWay}"
                        BadgeText="{x:Bind Comments.BadgeText, Mode=OneWay}"
                        HasBadgeCount="{x:Bind Comments.HasBadgeCount, Mode=OneWay}" />
                    <!-- 音效入口。开启时换强调色并加一层光圈，图标本身不变。 -->
                    <Button x:Name="EffectsButton" Style="{StaticResource PlayerRoundIconButtonStyle}"
                        AutomationProperties.Name="音效" ToolTipService.ToolTip="音效">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Button.Resources>
                        <Grid Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border
                                x:Name="EffectsHalo"
                                Width="30"
                                Height="30"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"
                                CornerRadius="15"
                                Visibility="Collapsed" />
                            <controls:Icon
                                x:Name="EffectsIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource IconEqualizer}"
                                Size="16" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="Background" Value="{ThemeResource BowenAcrylicBrush}" />
                                        <Setter Property="Padding" Value="10" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <controls:AudioEffectsPanel ViewModel="{x:Bind Effects}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- 音质按钮回到扁平药丸那一版：36 宽、圆角 8，胶囊横向撑满、纵向居中。 -->
                    <Button x:Name="QualityButton" Width="36" Height="36" CornerRadius="8" Padding="0"
                        Style="{StaticResource PlayerRoundIconButtonStyle}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                        IsEnabled="{x:Bind Player.CanChangeQuality, Mode=OneWay}" AutomationProperties.Name="音质切换"
                        ToolTipService.ToolTip="{x:Bind Player.QualityText, Mode=OneWay}">
                        <Button.Resources>
                            <!-- 图标按钮禁用时不该有底色：默认模板的 Disabled 态会铺 ButtonBackgroundDisabled，
                                盖住 Background="Transparent"。这里连同描边一起置空，只用前景色变淡表示禁用。 -->
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Button.Resources>

                        <controls:AudioQualityChip
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Label="{x:Bind Player.QualityLabel, Mode=OneWay}"
                            Quality="{x:Bind Player.CurrentQuality, Mode=OneWay}" />
                        <Button.Flyout>
                            <Flyout
                                x:Name="QualityFlyout"
                                Opened="OnQualityFlyoutOpened"
                                Opening="OnQualityFlyoutOpening"
                                Placement="Top">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="Background" Value="{ThemeResource BowenAcrylicBrush}" />
                                        <Setter Property="Padding" Value="6" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <controls:AudioQualityPicker
                                    x:Name="QualityPicker"
                                    ViewModel="{x:Bind Player}"
                                    SelectionRequested="OnQualitySelected" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- 与播放条同一个音量控件：一颗图标按钮，悬停才在上方展开竖向滑条，不外显。 -->
                    <controls:VolumeButton
                        x:Name="VolumeControl"
                        ViewModel="{x:Bind Player, Mode=OneWay}" />
                </StackPanel>
                <!--
                    第 1 行（原来的提示文字）**空着**：提示条已经收到外壳里那一个浮层上了，
                    见 MainWindow 的 NotificationBar。留着这一行是为了不动传输组的纵向位置 ——
                    传输组居中在第 0 行那 48 里，合并两行会把它下移半个差值。
                -->
            </Grid>

            <Slider x:Name="PositionSlider" Grid.Row="2" MinWidth="0" Height="22" Margin="0,-11,0,0"
                Padding="0" VerticalAlignment="Top" Maximum="{x:Bind Player.ProgressMaximum, Mode=OneWay}"
                Value="{x:Bind Player.PositionSeconds, Mode=OneWay}" ValueChanged="OnProgressValueChanged"
                IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}" AutomationProperties.Name="播放进度">
                <Slider.Resources>
                    <!-- 与 MV 页共用的那一份，见文件顶部。 -->
                    <ResourceDictionary Source="ms-appx:///Themes/Styles/ImmersiveProgressSlider.xaml" />
                </Slider.Resources>
            </Slider>
        </Grid>
        <!--
            歌词外观：与评论面板同一套浮层形态，从左侧滑出，盖住封面、让右侧歌词保持可见。
            底色用应用统一的亚克力刷；关闭亚克力时它自动退回实色兜底。空白区点击收起。
        -->
        <Grid x:Name="AppearanceOverlay" Margin="0,72,0,94" Visibility="Collapsed">
            <Rectangle Fill="Transparent" Tapped="OnAppearanceDismissTapped" />
            <!--
                叠加层上边距 72、下边距 94，已经排除标题栏与播放条。
                面板在这块剩余区域里垂直居中，上下各留 12。
            -->
            <Border x:Name="AppearancePane" Width="360" HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="20,12,12,12" Background="{ThemeResource BowenAcrylicBrush}"
                BorderBrush="{ThemeResource CommentBorderBrush}" BorderThickness="1" CornerRadius="16">
                <Border.Resources>
                    <!-- 对齐分段沿用评论面板的选中态：品牌强调色底 + 深色字。 -->
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource BrandAccent}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource BrandAccentSecondary}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource BrandAccentTertiary}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource BrandOnAccent}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource BrandOnAccent}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource BrandOnAccent}" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                </Border.Resources>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="20,18,20,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="歌词外观" FontSize="{StaticResource FontSizeTitle}"
                                FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="字体、字号、间距与颜色" FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <Button x:Name="AppearanceCloseButton" Click="OnAppearanceCloseClick"
                            HorizontalAlignment="Right" Style="{StaticResource PlayerRoundIconButtonStyle}"
                            AutomationProperties.Name="关闭歌词外观" ToolTipService.ToolTip="关闭">
                            <controls:Icon Data="{StaticResource IconDismiss}" Size="12" />
                        </Button>
                    </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <!-- 滚动区铺到卡片右缘，滚动条贴边；内容单独留出左侧 20、右侧 32 的槽位。 -->
                            <StackPanel Spacing="{StaticResource SpaceSection}" Padding="20,0,32,20">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="字体" Style="{StaticResource LyricsSectionTitleStyle}"
                                    VerticalAlignment="Center" />
                                <controls:FontPicker x:Name="LyricsFontPicker" Grid.Column="1" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="封面" Style="{StaticResource LyricsSectionTitleStyle}"
                                    VerticalAlignment="Center" />
                                <ComboBox x:Name="LyricsCoverStyleCombo" Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OnLyricsCoverStyleSelectionChanged"
                                    AutomationProperties.Name="歌词页封面样式">
                                    <ComboBoxItem Content="方形封面" />
                                    <ComboBoxItem Content="黑胶唱片" />
                                    <ComboBoxItem Content="简易随身听" />
                                    <ComboBoxItem Content="磁带机" />
                                </ComboBox>
                            </Grid>

                            <!-- 播放器外壳颜色：只在「简易随身听」样式下显示 -->
                            <StackPanel x:Name="ShellColorPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="外壳颜色" Style="{StaticResource LyricsSectionTitleStyle}" />
                                <StackPanel x:Name="ShellPalette" Orientation="Horizontal" Spacing="6"
                                    HorizontalAlignment="Center" Margin="0,4,0,0" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="跟随封面" FontSize="{StaticResource FontSizeBody}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="按当前封面自动取暗色" FontSize="{StaticResource FontSizeCaption}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ShellAutoToggle" Grid.Column="1"
                                        MinWidth="0" OffContent="" OnContent=""
                                        Toggled="OnShellAutoToggled" AutomationProperties.Name="外壳颜色跟随封面自动取色" />
                                </Grid>
                                <TextBlock x:Name="ShellHex" FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="背景" Style="{StaticResource LyricsSectionTitleStyle}"
                                    VerticalAlignment="Center" />
                                <ComboBox x:Name="LyricsBackgroundCombo" Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OnLyricsBackgroundSelectionChanged"
                                    AutomationProperties.Name="歌词背景">
                                    <ComboBoxItem Content="封面模糊" />
                                    <ComboBoxItem x:Name="LyricsBackgroundMicaItem" Content="Mica" />
                                    <ComboBoxItem Content="自定义图片" />
                                    <ComboBoxItem Content="纯色" />
                                </ComboBox>
                            </Grid>

                            <StackPanel x:Name="CoverBlurPanel" Spacing="8" Visibility="Collapsed">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="暗度" FontSize="{StaticResource FontSizeBody}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource LyricsResetButtonStyle}" Click="OnResetCoverBlurDimClick"
                                                AutomationProperties.Name="恢复默认封面模糊暗度" ToolTipService.ToolTip="恢复默认暗度">
                                                <controls:Icon Data="{StaticResource IconRefresh}" Size="{StaticResource SizeIconSm}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="CoverBlurDimValue" HorizontalAlignment="Right"
                                            Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="−" Style="{StaticResource LyricsValueTextStyle}" />
                                        <Slider x:Name="CoverBlurDimSlider" Grid.Column="1" Minimum="0" Maximum="80"
                                            StepFrequency="1" Style="{StaticResource LyricsSliderStyle}"
                                            ValueChanged="OnCoverBlurDimChanged" AutomationProperties.Name="封面模糊暗度" />
                                        <TextBlock Grid.Column="2" Text="+" Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="模糊" FontSize="{StaticResource FontSizeBody}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource LyricsResetButtonStyle}" Click="OnResetCoverBlurAmountClick"
                                                AutomationProperties.Name="恢复默认封面模糊强度" ToolTipService.ToolTip="恢复默认模糊">
                                                <controls:Icon Data="{StaticResource IconRefresh}" Size="{StaticResource SizeIconSm}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="CoverBlurAmountValue" HorizontalAlignment="Right"
                                            Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="−" Style="{StaticResource LyricsValueTextStyle}" />
                                        <Slider x:Name="CoverBlurAmountSlider" Grid.Column="1" Minimum="0" Maximum="80"
                                            StepFrequency="1" Style="{StaticResource LyricsSliderStyle}"
                                            ValueChanged="OnCoverBlurAmountChanged" AutomationProperties.Name="封面模糊强度" />
                                        <TextBlock Grid.Column="2" Text="+" Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="压暗封面亮部，亮色封面下歌词更清楚"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="MicaTintPanel" Spacing="6" Visibility="Collapsed">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="着色" Style="{StaticResource LyricsSectionTitleStyle}"
                                        VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="MicaTintToggle" Grid.Column="1"
                                        MinWidth="0" OffContent="" OnContent=""
                                        Toggled="OnMicaTintToggled"
                                        AutomationProperties.Name="Mica 着色" />
                                </Grid>
                                <TextBlock Text="在系统 Mica 上叠一层当前封面氛围色"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel x:Name="BackgroundImagePanel" Spacing="8" Visibility="Collapsed">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="图片" Style="{StaticResource LyricsSectionTitleStyle}"
                                        VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="PickBackgroundImageButton" Content="选择图片…"
                                            Click="OnPickBackgroundImageClick"
                                            AutomationProperties.Name="选择背景图片" />
                                        <Button x:Name="ReCropBackgroundButton" Content="重新裁剪…"
                                            Click="OnReCropBackgroundClick" IsEnabled="False"
                                            AutomationProperties.Name="重新裁剪背景图片" />
                                        <TextBlock x:Name="BackgroundImageName" VerticalAlignment="Center"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="暗度" FontSize="{StaticResource FontSizeBody}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource LyricsResetButtonStyle}" Click="OnResetBackgroundDimClick"
                                                AutomationProperties.Name="恢复默认暗度" ToolTipService.ToolTip="恢复默认暗度">
                                                <controls:Icon Data="{StaticResource IconRefresh}" Size="{StaticResource SizeIconSm}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="BackgroundDimValue" HorizontalAlignment="Right"
                                            Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="−" Style="{StaticResource LyricsValueTextStyle}" />
                                        <Slider x:Name="BackgroundDimSlider" Grid.Column="1" Minimum="0" Maximum="80"
                                            StepFrequency="1" Style="{StaticResource LyricsSliderStyle}"
                                            ValueChanged="OnBackgroundDimChanged" AutomationProperties.Name="背景暗度" />
                                        <TextBlock Grid.Column="2" Text="+" Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="模糊" FontSize="{StaticResource FontSizeBody}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource LyricsResetButtonStyle}" Click="OnResetBackgroundBlurClick"
                                                AutomationProperties.Name="恢复默认背景模糊" ToolTipService.ToolTip="恢复默认背景模糊">
                                                <controls:Icon Data="{StaticResource IconRefresh}" Size="{StaticResource SizeIconSm}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="BackgroundBlurValue" HorizontalAlignment="Right"
                                            Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="−" Style="{StaticResource LyricsValueTextStyle}" />
                                        <Slider x:Name="BackgroundBlurSlider" Grid.Column="1" Minimum="0" Maximum="40"
                                            StepFrequency="1" Style="{StaticResource LyricsSliderStyle}"
                                            ValueChanged="OnBackgroundBlurChanged" AutomationProperties.Name="背景模糊" />
                                        <TextBlock Grid.Column="2" Text="+" Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="SolidColorPanel" Spacing="8" Visibility="Collapsed">
                                <StackPanel x:Name="SolidColorPalette" Orientation="Horizontal" Spacing="6"
                                    HorizontalAlignment="Center" Margin="0,4,0,0" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="跟随封面" FontSize="{StaticResource FontSizeBody}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="按当前封面自动取暗色" FontSize="{StaticResource FontSizeCaption}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SolidColorAutoToggle" Grid.Column="1"
                                        MinWidth="0" OffContent="" OnContent=""
                                        Toggled="OnSolidColorAutoToggled" AutomationProperties.Name="跟随封面自动取色" />
                                </Grid>

                                <TextBlock x:Name="SolidColorHex" VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LyricsSectionTitleStyle}" Text="字号与间距" />

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="字体大小" FontSize="{StaticResource FontSizeBody}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource LyricsResetButtonStyle}" Click="OnResetFontSizeClick"
                                                AutomationProperties.Name="恢复默认字号" ToolTipService.ToolTip="恢复默认字号">
                                                <controls:Icon Data="{StaticResource IconRefresh}" Size="{StaticResource SizeIconSm}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="LyricsFontSizeValue" HorizontalAlignment="Right"
                                            Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="A-" Style="{StaticResource LyricsValueTextStyle}" />
                                        <Slider x:Name="LyricsFontSizeSlider" Grid.Column="1" Minimum="24" Maximum="80"
                                            StepFrequency="1" Style="{StaticResource LyricsSliderStyle}"
                                            ValueChanged="OnLyricsFontSizeChanged" AutomationProperties.Name="歌词字号" />
                                        <TextBlock Grid.Column="2" Text="A+" Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="歌词间距" FontSize="{StaticResource FontSizeBody}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource LyricsResetButtonStyle}" Click="OnResetLineGapClick"
                                                AutomationProperties.Name="恢复默认间距" ToolTipService.ToolTip="恢复默认间距">
                                                <controls:Icon Data="{StaticResource IconRefresh}" Size="{StaticResource SizeIconSm}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="LyricsLineGapValue" HorizontalAlignment="Right"
                                            Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="−" Style="{StaticResource LyricsValueTextStyle}" />
                                        <Slider x:Name="LyricsLineGapSlider" Grid.Column="1" Minimum="0" Maximum="64"
                                            StepFrequency="1" Style="{StaticResource LyricsSliderStyle}"
                                            ValueChanged="OnLyricsLineGapChanged" AutomationProperties.Name="歌词行距" />
                                        <TextBlock Grid.Column="2" Text="+" Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="TranslationSettingsPanel" Spacing="8">
                                <TextBlock Style="{StaticResource LyricsSectionTitleStyle}" Text="译文" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="同步高亮" FontSize="{StaticResource FontSizeBody}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="译文跟随原文进度扫色" FontSize="{StaticResource FontSizeCaption}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LyricsTranslationSyncToggle" Grid.Column="1"
                                        MinWidth="0" OffContent="" OnContent=""
                                        Toggled="OnTranslationSyncToggled" AutomationProperties.Name="译文同步高亮" />
                                </Grid>

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="译文大小" FontSize="{StaticResource FontSizeBody}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource LyricsResetButtonStyle}" Click="OnResetTranslationFontScaleClick"
                                                AutomationProperties.Name="恢复默认译文大小" ToolTipService.ToolTip="恢复默认译文大小">
                                                <controls:Icon Data="{StaticResource IconRefresh}" Size="{StaticResource SizeIconSm}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="LyricsTranslationFontSizeValue" HorizontalAlignment="Right"
                                            Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="A-" Style="{StaticResource LyricsValueTextStyle}" />
                                        <Slider x:Name="LyricsTranslationFontSizeSlider" Grid.Column="1" Minimum="50" Maximum="100"
                                            StepFrequency="1" Style="{StaticResource LyricsSliderStyle}"
                                            ValueChanged="OnLyricsTranslationFontSizeChanged" AutomationProperties.Name="译文大小" />
                                        <TextBlock Grid.Column="2" Text="A+" Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="译文间距" FontSize="{StaticResource FontSizeBody}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource LyricsResetButtonStyle}" Click="OnResetTranslationLineGapClick"
                                                AutomationProperties.Name="恢复默认译文间距" ToolTipService.ToolTip="恢复默认译文间距">
                                                <controls:Icon Data="{StaticResource IconRefresh}" Size="{StaticResource SizeIconSm}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="LyricsTranslationLineGapValue" HorizontalAlignment="Right"
                                            Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="−" Style="{StaticResource LyricsValueTextStyle}" />
                                        <Slider x:Name="LyricsTranslationLineGapSlider" Grid.Column="1" Minimum="0" Maximum="32"
                                            StepFrequency="1" Style="{StaticResource LyricsSliderStyle}"
                                            ValueChanged="OnLyricsTranslationLineGapChanged" AutomationProperties.Name="译文间距" />
                                        <TextBlock Grid.Column="2" Text="+" Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LyricsSectionTitleStyle}" Text="歌词位置" />
                                <Border HorizontalAlignment="Center" Background="{ThemeResource CommentRaisedSurfaceBrush}"
                                    CornerRadius="{StaticResource RadiusMd}" Padding="3" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <ToggleButton x:Name="AlignLeftButton" Content="居左"
                                            Style="{StaticResource LyricsSegmentButtonStyle}" Click="OnAlignLeftClick" />
                                        <ToggleButton x:Name="AlignCenterButton" Content="居中"
                                            Style="{StaticResource LyricsSegmentButtonStyle}" Click="OnAlignCenterClick" />
                                        <ToggleButton x:Name="AlignRightButton" Content="居右"
                                            Style="{StaticResource LyricsSegmentButtonStyle}" Click="OnAlignRightClick" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="水平偏移" FontSize="{StaticResource FontSizeBody}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource LyricsResetButtonStyle}" Click="OnResetHorizontalOffsetClick"
                                                AutomationProperties.Name="恢复水平偏移" ToolTipService.ToolTip="恢复水平偏移">
                                                <controls:Icon Data="{StaticResource IconRefresh}" Size="{StaticResource SizeIconSm}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="LyricsHorizontalOffsetValue" HorizontalAlignment="Right"
                                            Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="左" Style="{StaticResource LyricsValueTextStyle}" />
                                        <Slider x:Name="LyricsHorizontalOffsetSlider" Grid.Column="1"
                                            Minimum="{x:Bind models:LyricsSettings.MinimumHorizontalOffsetPercent}"
                                            Maximum="{x:Bind models:LyricsSettings.MaximumHorizontalOffsetPercent}"
                                            StepFrequency="1" Style="{StaticResource LyricsSliderStyle}"
                                            ValueChanged="OnLyricsHorizontalOffsetChanged" AutomationProperties.Name="水平偏移" />
                                        <TextBlock Grid.Column="2" Text="右" Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="垂直偏移" FontSize="{StaticResource FontSizeBody}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource LyricsResetButtonStyle}" Click="OnResetVerticalOffsetClick"
                                                AutomationProperties.Name="恢复垂直偏移" ToolTipService.ToolTip="恢复垂直偏移">
                                                <controls:Icon Data="{StaticResource IconRefresh}" Size="{StaticResource SizeIconSm}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="LyricsVerticalOffsetValue" HorizontalAlignment="Right"
                                            Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="上" Style="{StaticResource LyricsValueTextStyle}" />
                                        <Slider x:Name="LyricsVerticalOffsetSlider" Grid.Column="1"
                                            Minimum="{x:Bind models:LyricsSettings.MinimumVerticalOffsetPercent}"
                                            Maximum="{x:Bind models:LyricsSettings.MaximumVerticalOffsetPercent}"
                                            StepFrequency="1" Style="{StaticResource LyricsSliderStyle}"
                                            ValueChanged="OnLyricsVerticalOffsetChanged" AutomationProperties.Name="垂直偏移" />
                                        <TextBlock Grid.Column="2" Text="下" Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LyricsSectionTitleStyle}" Text="模糊" />
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="边缘范围" FontSize="{StaticResource FontSizeBody}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource LyricsResetButtonStyle}" Click="OnResetEdgeBlurClick"
                                                AutomationProperties.Name="恢复默认边缘模糊" ToolTipService.ToolTip="恢复默认边缘模糊">
                                                <controls:Icon Data="{StaticResource IconRefresh}" Size="{StaticResource SizeIconSm}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="LyricsEdgeBlurValue" HorizontalAlignment="Right"
                                            Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="−" Style="{StaticResource LyricsValueTextStyle}" />
                                        <Slider x:Name="LyricsEdgeBlurSlider" Grid.Column="1" Minimum="0" Maximum="50"
                                            StepFrequency="1" Style="{StaticResource LyricsSliderStyle}"
                                            ValueChanged="OnLyricsEdgeBlurChanged" AutomationProperties.Name="边缘模糊范围" />
                                        <TextBlock Grid.Column="2" Text="+" Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource LyricsSectionTitleStyle}" Text="歌词颜色" />
                                <StackPanel x:Name="LyricsColorPalette" Orientation="Horizontal" Spacing="6"
                                    HorizontalAlignment="Center" Margin="0,4,0,0" />

                                <StackPanel Spacing="6">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="未高亮歌词" FontSize="{StaticResource FontSizeBody}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource LyricsResetButtonStyle}" Click="OnResetInactiveLineOpacityClick"
                                                AutomationProperties.Name="恢复默认未高亮歌词" ToolTipService.ToolTip="恢复默认">
                                                <controls:Icon Data="{StaticResource IconRefresh}" Size="{StaticResource SizeIconSm}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="InactiveLineOpacityValue" HorizontalAlignment="Right"
                                            Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="淡" Style="{StaticResource LyricsValueTextStyle}" />
                                        <Slider x:Name="InactiveLineOpacitySlider" Grid.Column="1" Minimum="20" Maximum="100"
                                            StepFrequency="1" Style="{StaticResource LyricsSliderStyle}"
                                            ValueChanged="OnInactiveLineOpacityChanged" AutomationProperties.Name="未高亮歌词不透明度" />
                                        <TextBlock Grid.Column="2" Text="亮" Style="{StaticResource LyricsValueTextStyle}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <!-- 实色面板保证封面颜色和动态背景不会透过正文；空白区点击收起。 -->
        <Grid x:Name="CommentsOverlay" Margin="0,72,0,94"
            Visibility="{x:Bind local:Formats.Visible(Comments.IsOpen), Mode=OneWay}">
            <Rectangle Fill="Transparent" Tapped="OnCommentsDismissTapped" />
            <Border x:Name="CommentsPane" Width="420" HorizontalAlignment="Right" Margin="12,0,20,12"
                Background="{ThemeResource CommentPanelBackgroundBrush}" BorderBrush="{ThemeResource CommentBorderBrush}" BorderThickness="1" CornerRadius="16">
                <Grid>
                    <ContentControl x:Name="CommentsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <!-- 原图查看仅覆盖整个评论面板，保留列表位置和回复上下文。 -->
                    <controls:CommentImageViewer x:Name="CommentsImageViewer" ImageUri="{x:Bind Comments.PreviewImageUri, Mode=OneWay}"
                        Visibility="{x:Bind local:Formats.Visible(Comments.IsImageOpen), Mode=OneWay}"
                        CloseRequested="OnImageCloseRequested" />
                </Grid>
            </Border>
        </Grid>
        <Popup x:Name="ProgressTimePopup" IsHitTestVisible="False">
            <Border x:Name="ProgressTimeBubble" Padding="9,5" Background="#EF191B22" CornerRadius="7"
                BorderBrush="#26FFFFFF" BorderThickness="1">
                <TextBlock x:Name="ProgressTimeText" FontSize="11" FontWeight="SemiBold"
                    FontFamily="Cascadia Mono" Foreground="White" />
            </Border>
        </Popup>
    </Grid>
</Page>
