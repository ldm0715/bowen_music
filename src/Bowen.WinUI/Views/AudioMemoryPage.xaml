<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bowen.WinUI.Views.AudioMemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bowen.WinUI.Controls"
    xmlns:local="using:Bowen.WinUI"
    xmlns:vm="using:Bowen.WinUI.ViewModels">

    <Page.Resources>
        <!--
            x:Bind 模板留在页面资源里，不挪进共享字典：共享字典里的 x:Bind 在 WinUI 3
            会编译通过但运行时不生效（见 FollowedArtistsPage.xaml 顶部注释）。
        -->
        <DataTemplate x:Key="WeeklyHeroTemplate" x:DataType="vm:PlayRankingRow">
            <Border
                Padding="16"
                Background="{ThemeResource BowenAcrylicBrush}"
                CornerRadius="{StaticResource RadiusMd}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="120"
                        Height="120"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource RadiusMd}">
                        <Image
                            Source="{x:Bind local:Formats.CoverSource(Track.CoverImage)}"
                            Stretch="UniformToFill" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="本周最爱" />
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind Track.Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Track.ArtistText}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind PlayCountLabel}" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="播放"
                        Click="OnWeeklyPlayClick"
                        Style="{StaticResource BowenIconButton}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="播放">
                        <controls:Icon Data="{StaticResource IconPlay}" Size="16" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WeeklyRowTemplate" x:DataType="vm:PlayRankingRow">
            <Grid Padding="4,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind RankLabel}" />

                <Border
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="{StaticResource RadiusSm}">
                    <Image
                        Source="{x:Bind local:Formats.RowCoverSource(Track.CoverImage)}"
                        Stretch="UniformToFill" />
                </Border>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Text="{x:Bind Track.Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Track.ArtistText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind PlayCountLabel}" />

                <Button
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="播放"
                    Click="OnWeeklyPlayClick"
                    Style="{StaticResource BowenIconButton}"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="播放">
                    <controls:Icon Data="{StaticResource IconPlay}" Size="16" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ReportTrackRowTemplate" x:DataType="vm:ReportTrackRow">
            <Grid Padding="4,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind RankLabel}" />

                <Border
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="{StaticResource RadiusSm}">
                    <Image
                        Source="{x:Bind local:Formats.RowCoverSource(Source.Cover)}"
                        Stretch="UniformToFill" />
                </Border>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Text="{x:Bind Source.Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Source.Artist}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind PlayCountLabel}" />

                <Button
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="播放"
                    Click="OnReportTrackPlayClick"
                    Style="{StaticResource BowenIconButton}"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="播放">
                    <controls:Icon Data="{StaticResource IconPlay}" Size="16" />
                </Button>
            </Grid>
        </DataTemplate>

        <!-- 擂台：冠军卡比两侧高一头，2/3 名底部对齐。 -->
        <DataTemplate x:Key="PodiumFirstTemplate" x:DataType="vm:ReportTrackRow">
            <Border
                Height="276"
                Padding="12"
                Background="{ThemeResource BowenAcrylicBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="{StaticResource RadiusMd}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Width="128"
                        Height="128"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource RadiusMd}">
                        <Grid>
                            <Image
                                Source="{x:Bind local:Formats.CoverSource(Source.Cover)}"
                                Stretch="UniformToFill" />
                            <Border
                                Width="30"
                                Height="30"
                                Margin="6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="{StaticResource RadiusPill}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{x:Bind RankLabel}" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock
                        Grid.Row="1"
                        MaxLines="2"
                        Text="{x:Bind Source.Title}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Source.Artist}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="4" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind PlayCountLabel}" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="播放"
                            Click="OnReportTrackPlayClick"
                            Style="{StaticResource BowenIconButton}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="播放">
                            <controls:Icon Data="{StaticResource IconPlay}" Size="16" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PodiumRunnerTemplate" x:DataType="vm:ReportTrackRow">
            <Border
                Height="240"
                Padding="10"
                Background="{ThemeResource BowenAcrylicBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Width="96"
                        Height="96"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="{StaticResource RadiusMd}">
                        <Grid>
                            <Image
                                Source="{x:Bind local:Formats.CoverSource(Source.Cover)}"
                                Stretch="UniformToFill" />
                            <Border
                                Width="26"
                                Height="26"
                                Margin="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="{StaticResource RadiusPill}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind RankLabel}" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock
                        Grid.Row="1"
                        MaxLines="2"
                        Text="{x:Bind Source.Title}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Source.Artist}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="4" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind PlayCountLabel}" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="播放"
                            Click="OnReportTrackPlayClick"
                            Style="{StaticResource BowenIconButton}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="播放">
                            <controls:Icon Data="{StaticResource IconPlay}" Size="16" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 专辑只有封面 URL，用轻微倾斜的相框墙代替平铺。 -->
        <DataTemplate x:Key="AlbumCoverTemplate" x:DataType="vm:AlbumCoverItem">
            <Border
                Width="104"
                Height="104"
                Margin="4"
                Padding="5"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusSm}"
                RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <RotateTransform Angle="{x:Bind Rotation}" />
                </Border.RenderTransform>
                <Image
                    Source="{x:Bind local:Formats.CoverSource(Uri)}"
                    Stretch="UniformToFill" />
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource BowenPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="音波回忆" />
            <controls:PillTabBar
                ItemsSource="{x:Bind ViewModel.Tabs}"
                SelectedIndex="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}" />
        </StackPanel>

        <Grid x:Name="TabHost" Grid.Row="1">
            <!-- ── 本周最爱 ─────────────────────────────────────────────── -->
            <Grid
                x:Name="WeeklyContent"
                Visibility="{x:Bind local:Formats.Visible(ViewModel.IsWeeklyTab), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="{StaticResource SpaceRowPadding}"
                        VerticalAlignment="Center"
                        Style="{StaticResource BowenPageStatusStrong}"
                        Text="{x:Bind ViewModel.Weekly.StatusText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="重新加载"
                        Command="{x:Bind ViewModel.Weekly.ReloadCommand}"
                        Style="{StaticResource BowenIconButton}"
                        ToolTipService.ToolTip="重新加载">
                        <controls:Icon Data="{StaticResource IconRefresh}" Size="16" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="{StaticResource SpaceVerticalScrollContentPadding}">
                    <StackPanel Spacing="8">
                        <ContentControl
                            HorizontalContentAlignment="Stretch"
                            Content="{x:Bind ViewModel.Weekly.Hero, Mode=OneWay}"
                            ContentTemplate="{StaticResource WeeklyHeroTemplate}"
                            Visibility="{x:Bind local:Formats.Visible(ViewModel.Weekly.HasHero), Mode=OneWay}" />

                        <ItemsControl
                            ItemTemplate="{StaticResource WeeklyRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.Weekly.Rest, Mode=OneWay}"
                            Visibility="{x:Bind local:Formats.Visible(ViewModel.Weekly.HasRest), Mode=OneWay}" />

                        <TextBlock
                            Margin="4,24,4,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="多听几首，下周这里就会出现你的最爱。"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind local:Formats.Visible(ViewModel.Weekly.ShowEmpty), Mode=OneWay}" />

                        <StackPanel
                            Margin="4,24,4,0"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind local:Formats.Visible(ViewModel.Weekly.ShowError), Mode=OneWay}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="加载失败" />
                            <Button Command="{x:Bind ViewModel.Weekly.ReloadCommand}" Content="重试" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <ProgressRing
                    Grid.Row="2"
                    Margin="4,8"
                    HorizontalAlignment="Left"
                    IsActive="{x:Bind ViewModel.Weekly.IsBusy, Mode=OneWay}"
                    Style="{StaticResource BowenPageBusyRing}" />
            </Grid>

            <!-- ── 听歌月报 ─────────────────────────────────────────────── -->
            <Grid
                x:Name="ReportContent"
                Visibility="{x:Bind local:Formats.Visible(ViewModel.IsReportTab), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="4">
                        <ComboBox
                            Width="100"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.Report.Years}"
                            SelectedItem="{x:Bind ViewModel.Report.SelectedYearOption, Mode=TwoWay}" />
                        <ComboBox
                            Width="80"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.Report.AvailableMonths}"
                            SelectedItem="{x:Bind ViewModel.Report.SelectedMonthChoice, Mode=TwoWay}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource BowenPageStatus}"
                        Text="{x:Bind ViewModel.Report.StatusText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            AutomationProperties.Name="重新加载"
                            Command="{x:Bind ViewModel.Report.ReloadCommand}"
                            Style="{StaticResource BowenIconButton}"
                            ToolTipService.ToolTip="重新加载">
                            <controls:Icon Data="{StaticResource IconRefresh}" Size="16" />
                        </Button>

                        <Button
                            AutomationProperties.Name="导出海报"
                            IsEnabled="{x:Bind ViewModel.Report.CanExport, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{StaticResource IconDownload}" Size="14" />
                                <TextBlock Text="导出海报" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Click="OnExportOverviewClick"
                                        Text="月度总览" />
                                    <MenuFlyoutItem
                                        Click="OnExportTracksClick"
                                        Text="歌曲总览" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            AutomationProperties.Name="新建月度歌单"
                            Click="OnCreatePlaylistClick"
                            IsEnabled="{x:Bind ViewModel.Report.CanCreatePlaylist, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{StaticResource IconPlaylistAdd}" Size="14" />
                                <TextBlock Text="新建月度歌单" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="{StaticResource SpaceVerticalScrollContentPadding}">
                    <StackPanel Spacing="16">
                        <StackPanel
                            Spacing="16"
                            Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.HasReport), Mode=OneWay}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Padding="14"
                                    Background="{ThemeResource BowenAcrylicBrush}"
                                    CornerRadius="{StaticResource RadiusMd}">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="听歌时长" />
                                        <TextBlock
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Report.ListenTotalText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="14"
                                    Background="{ThemeResource BowenAcrylicBrush}"
                                    CornerRadius="{StaticResource RadiusMd}">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="时长变化" />
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.ListenChangeIsNumeric), Mode=OneWay}">
                                            <TextBlock
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Text="{x:Bind ViewModel.Report.ListenChangeArrow, Mode=OneWay}" />
                                            <TextBlock
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                Text="{x:Bind ViewModel.Report.ListenChangeValueText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            MaxLines="2"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind ViewModel.Report.ListenChangeDescription, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.HasListenChangeDescription), Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Report.ListenChangeLabel, Mode=OneWay}"
                                            Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.ListenChangeIsNumeric), Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    Padding="14"
                                    Background="{ThemeResource BowenAcrylicBrush}"
                                    CornerRadius="{StaticResource RadiusMd}">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="播放次数" />
                                        <TextBlock
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Report.PlayCountText, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Report.PlayChangeText, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.HasPlayChange), Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="3"
                                    Padding="14"
                                    Background="{ThemeResource BowenAcrylicBrush}"
                                    CornerRadius="{StaticResource RadiusMd}">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="听过曲目" />
                                        <TextBlock
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Report.SongCountText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 两句服务端文案不直接铺出来，改成可扫读的亮点卡 -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.ColumnSpan="{x:Bind ViewModel.Report.LongestDayCardColumnSpan, Mode=OneWay}"
                                    Padding="14"
                                    Background="{ThemeResource BowenAcrylicBrush}"
                                    CornerRadius="{StaticResource RadiusMd}">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Report.LongestDayCardLabel, Mode=OneWay}" />
                                        <TextBlock
                                            MaxLines="2"
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Report.LongestDayCardValue, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Report.LongestDayCardSubtitle, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="14"
                                    Background="{ThemeResource BowenAcrylicBrush}"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.HasMostPlayedSong), Mode=OneWay}">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="单曲最多" />
                                        <TextBlock
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Report.MostPlayedSongPlayCountText, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Report.MostPlayedSongTitle, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border
                                Padding="16"
                                Background="{ThemeResource BowenAcrylicBrush}"
                                CornerRadius="{StaticResource RadiusMd}"
                                Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.HasArtist), Mode=OneWay}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="96"
                                        Height="96"
                                        Padding="3"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="2"
                                        CornerRadius="{StaticResource RadiusPill}">
                                        <PersonPicture
                                            Width="86"
                                            Height="86"
                                            DisplayName="{x:Bind ViewModel.Report.ArtistNameText, Mode=OneWay}"
                                            ProfilePicture="{x:Bind ViewModel.Report.ArtistCoverImage, Mode=OneWay}" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="本月最爱歌手" />
                                        <TextBlock
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Report.ArtistNameText, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.Report.ArtistContentText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        Width="120"
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.HasArtistMusic), Mode=OneWay}">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="常听" />
                                        <Border
                                            Width="72"
                                            Height="72"
                                            HorizontalAlignment="Right"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="{StaticResource RadiusSm}">
                                            <Image
                                                Source="{x:Bind ViewModel.Report.ArtistMusicCoverImage, Mode=OneWay}"
                                                Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            MaxLines="2"
                                            Text="{x:Bind ViewModel.Report.ArtistMusicNameText, Mode=OneWay}"
                                            TextAlignment="Right"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel
                                Spacing="8"
                                Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.HasPodium), Mode=OneWay}">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="最爱排行" />

                                <!--
                                    擂台：冠军居中且更高，2 / 3 名底部对齐。
                                    使用固定列宽而不是星号，少一首时整组仍然居中，不会被拉成半宽。
                                -->
                                <Grid HorizontalAlignment="Center" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>

                                    <ContentControl
                                        Grid.Column="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        Content="{x:Bind ViewModel.Report.PodiumSecond, Mode=OneWay}"
                                        ContentTemplate="{StaticResource PodiumRunnerTemplate}"
                                        Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.HasPodiumSecond), Mode=OneWay}" />
                                    <ContentControl
                                        Grid.Column="1"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        Content="{x:Bind ViewModel.Report.PodiumFirst, Mode=OneWay}"
                                        ContentTemplate="{StaticResource PodiumFirstTemplate}"
                                        Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.HasPodiumFirst), Mode=OneWay}" />
                                    <ContentControl
                                        Grid.Column="2"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        Content="{x:Bind ViewModel.Report.PodiumThird, Mode=OneWay}"
                                        ContentTemplate="{StaticResource PodiumRunnerTemplate}"
                                        Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.HasPodiumThird), Mode=OneWay}" />
                                </Grid>

                                <ItemsControl
                                    ItemTemplate="{StaticResource ReportTrackRowTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Report.TopRest, Mode=OneWay}"
                                    Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.HasTopRest), Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                Spacing="4"
                                Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.HasAlbumCovers), Mode=OneWay}">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="最爱专辑" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="本月播放最多的专辑封面" />
                                <ItemsControl
                                    ItemTemplate="{StaticResource AlbumCoverTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Report.AlbumCovers, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:WrapPanel HorizontalSpacing="2" VerticalSpacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            Margin="4,24,4,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Report.EmptyText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.ShowEmpty), Mode=OneWay}" />

                        <StackPanel
                            Margin="4,24,4,0"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind local:Formats.Visible(ViewModel.Report.ShowError), Mode=OneWay}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="加载失败" />
                            <Button Command="{x:Bind ViewModel.Report.ReloadCommand}" Content="重试" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <ProgressRing
                    Grid.Row="2"
                    Margin="4,8"
                    HorizontalAlignment="Left"
                    IsActive="{x:Bind ViewModel.Report.IsBusy, Mode=OneWay}"
                    Style="{StaticResource BowenPageBusyRing}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
