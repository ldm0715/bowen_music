<UserControl
    x:Class="Bowen.WinUI.Controls.AudioEffectsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bowen.WinUI.Controls"
    xmlns:local="using:Bowen.WinUI"
    xmlns:vm="using:Bowen.WinUI.ViewModels">

    <UserControl.Resources>
        <Style x:Key="EffectCardContainer" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <StackPanel Width="320" Spacing="8">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="音效" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ActiveEffectName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind local:Formats.OnOff(ViewModel.IsEnabled), Mode=OneWay}" />
                <ToggleSwitch
                    MinWidth="0"
                    AutomationProperties.Name="音效总开关"
                    IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />
            </StackPanel>
        </Grid>

        <controls:PillTabBar
            ItemsSource="{x:Bind ViewModel.Tabs}"
            SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}" />

        <!-- 经典 / 增强共用一套卡片，再次点击当前卡即取消。 -->
        <Grid Visibility="{x:Bind local:Formats.Visible(ViewModel.IsGalaxyTab), Mode=OneWay}">
            <GridView
                MaxHeight="324"
                Padding="0"
                HorizontalAlignment="Stretch"
                IsItemClickEnabled="True"
                ItemClick="OnPresetClick"
                ItemContainerStyle="{StaticResource EffectCardContainer}"
                ItemsSource="{x:Bind ViewModel.VisiblePresets}"
                SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemHeight="76" ItemWidth="160" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AudioEffectPresetItem">
                        <Grid Margin="2">
                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" />
                            <Border
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{x:Bind local:Formats.Visible(IsSelected), Mode=OneWay}" />
                            <StackPanel Margin="10,8" Spacing="3">
                                <Grid>
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <controls:Icon
                                        HorizontalAlignment="Right"
                                        Data="{StaticResource IconSelect}"
                                        Size="14"
                                        Visibility="{x:Bind local:Formats.Visible(IsSelected), Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="2"
                                    Text="{x:Bind Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <Grid Visibility="{x:Bind local:Formats.Visible(ViewModel.IsViperTab), Mode=OneWay}">
            <GridView
                MaxHeight="324"
                Padding="0"
                HorizontalAlignment="Stretch"
                IsItemClickEnabled="True"
                ItemClick="OnPresetClick"
                ItemContainerStyle="{StaticResource EffectCardContainer}"
                ItemsSource="{x:Bind ViewModel.VisiblePresets}"
                SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemHeight="76" ItemWidth="160" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AudioEffectPresetItem">
                        <Grid Margin="2">
                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" />
                            <Border
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{x:Bind local:Formats.Visible(IsSelected), Mode=OneWay}" />
                            <StackPanel Margin="10,8" Spacing="3">
                                <Grid>
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <controls:Icon
                                        HorizontalAlignment="Right"
                                        Data="{StaticResource IconSelect}"
                                        Size="14"
                                        Visibility="{x:Bind local:Formats.Visible(IsSelected), Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="2"
                                    Text="{x:Bind Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <!-- 环境音是叠加层，固定显示在预设下方，不占页签。 -->
        <Grid Margin="0,8,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="环境音" />
            <Button
                Grid.Column="1"
                MinWidth="0"
                MinHeight="0"
                Padding="2,0"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.Name="选择环境音"
                ToolTipService.ToolTip="选择环境音">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock FontSize="12" Text="{x:Bind ViewModel.AmbientButtonText, Mode=OneWay}" />
                        <controls:Icon Data="{StaticResource IconChevronDown}" Size="10" VerticalAlignment="Center" />
                    </StackPanel>
                </Button.Content>
                <Button.Flyout>
                    <Flyout x:Name="AmbientFlyout" Placement="Top">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="Background" Value="{ThemeResource BowenAcrylicBrush}" />
                                <Setter Property="Padding" Value="8" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <GridView
                            Width="300"
                            MaxHeight="300"
                            Padding="0,0,16,0"
                            IsItemClickEnabled="True"
                            ItemClick="OnAmbientClick"
                            ItemContainerStyle="{StaticResource EffectCardContainer}"
                            ItemsSource="{x:Bind ViewModel.AmbientSounds}"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid ItemHeight="64" ItemWidth="142" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:AmbientSoundItem">
                                    <Grid Margin="2">
                                        <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" />
                                        <Border
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{x:Bind local:Formats.Visible(IsSelected), Mode=OneWay}" />
                                        <StackPanel Margin="10,8" Spacing="3">
                                            <Grid>
                                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                <controls:Icon
                                                    HorizontalAlignment="Right"
                                                    Data="{StaticResource IconSelect}"
                                                    Size="14"
                                                    Visibility="{x:Bind local:Formats.Visible(IsSelected), Mode=OneWay}" />
                                            </Grid>
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="2"
                                                Text="{x:Bind Description}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Slider
                Grid.Column="2"
                Height="28"
                Margin="12,0,8,0"
                MinWidth="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                IsEnabled="{x:Bind ViewModel.HasAmbientSelected, Mode=OneWay}"
                IsThumbToolTipEnabled="False"
                Maximum="100"
                Minimum="0"
                Value="{x:Bind ViewModel.AmbientVolume, Mode=TwoWay}" />
            <TextBlock
                Grid.Column="3"
                MinWidth="30"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind local:Formats.Percent(ViewModel.AmbientVolume), Mode=OneWay}" />
        </Grid>

        <TextBlock
            FontSize="11"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind local:Formats.Visible(ViewModel.HasStatus), Mode=OneWay}" />
    </StackPanel>
</UserControl>
