<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.AlbumDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI">

    <Grid Style="{StaticResource BodianTrackPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 头部：封面 + 名字 + 副标题 ───────────────────────────────── -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="120"
                Height="120"
                VerticalAlignment="Top"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="8">
                <Image Source="{x:Bind local:Formats.CoverSource(ViewModel.Album.CoverImage)}" Stretch="UniformToFill" />
            </Border>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="4">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Tracks.StatusText, Mode=OneWay}" />
            </StackPanel>

        </Grid>

        <!--
            ── 简介 ───────────────────────────────────────────────────────
            折叠起来：实测这份文案是整篇专辑企划（几千字），摊开会把曲目列表顶到屏幕外。
        -->
        <Expander
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Header="专辑简介"
            Visibility="{x:Bind local:Formats.Visible(ViewModel.HasDescription), Mode=OneWay}">
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Expander>

        <controls:TrackListView
            Grid.Row="2"
            HasMore="{x:Bind ViewModel.Tracks.HasMore, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Tracks.Items}"
            LoadMoreCommand="{x:Bind ViewModel.Tracks.LoadMoreCommand}"
            TrackInvoked="OnTrackInvoked">
            <controls:TrackListView.Footer>
                <controls:PagingEndNote
                    RetryCommand="{x:Bind ViewModel.Tracks.LoadMoreCommand}"
                    ShowEnd="{x:Bind ViewModel.Tracks.ShowEnd, Mode=OneWay}"
                    ShowRetry="{x:Bind ViewModel.Tracks.ShowRetry, Mode=OneWay}" />
            </controls:TrackListView.Footer>
        </controls:TrackListView>

        <Grid Grid.Row="3" Style="{StaticResource BodianPageFooter}">
            <ProgressRing
                Style="{StaticResource BodianPageBusyRing}"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
