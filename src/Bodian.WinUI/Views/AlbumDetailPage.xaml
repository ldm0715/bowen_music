<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.AlbumDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI">

    <Grid Style="{StaticResource BodianPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 头部：封面 + 名字 + 歌手入口 + 操作 ──────────────────────── -->
        <Grid
            Grid.Row="0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                ★ 封面与右侧信息块都垂直居中：封面以前是 VerticalAlignment="Top"，
                  右边却是居中的，内容一高封面就被吊在上边、和下面的按钮拉开一大截。
                  SizeCoverGrid(150) 与信息块（标题 + 副标题 + 歌手入口 + 操作行）大致等高，
                  两块拼成一个整体。
            -->
            <Border
                Grid.Column="0"
                Width="{StaticResource SizeCoverGrid}"
                Height="{StaticResource SizeCoverGrid}"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="{StaticResource RadiusMd}">
                <Image Source="{x:Bind local:Formats.CoverSource(ViewModel.Album.CoverImage), Mode=OneWay}" Stretch="UniformToFill" />
            </Border>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="8">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <!-- 发行日 · 曲目数。歌手名不在这里 —— 下一行有可点的入口，重复一次是噪音 -->
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <!--
                    歌手入口：整块可点，进歌手页。
                    从曲目行的「查看专辑」进来时这里没有歌手 id，要等详情回来才出现 ——
                    所以是可见性绑定而不是始终显示。
                -->
                <!--
                    圆角取 ControlCornerRadius —— 与侧栏选中、页签条同一档，不用 RadiusPill(999)：
                    全圆角配矮按钮会拉成细长椭圆。MinWidth=0 是去掉 Button 默认的 120 最小宽度。
                -->
                <Button
                    Padding="8,4,12,4"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnArtistClick"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    MinWidth="0"
                    Visibility="{x:Bind local:Formats.Visible(ViewModel.HasArtist), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PersonPicture
                            Width="28"
                            Height="28"
                            DisplayName="{x:Bind ViewModel.Album.ArtistText, Mode=OneWay}"
                            ProfilePicture="{x:Bind local:Formats.CoverSource(ViewModel.Album.ArtistCover), Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Album.ArtistText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>

                <StackPanel
                    Margin="0,2,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        AutomationProperties.Name="播放全部"
                        Command="{x:Bind ViewModel.PlayAllCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:Icon Size="14" Data="{StaticResource IconPlay}" />
                            <TextBlock Text="播放全部" />
                        </StackPanel>
                    </Button>

                    <!--
                        收藏是两态；取消收藏要**先弹确认框**，所以用 Click 而不是 Command ——
                        弹窗是界面决策，XamlRoot 也拿不到 ViewModel 里去（见 code-behind）。
                    -->
                    <Button
                        AutomationProperties.Name="收藏"
                        Click="OnCollectClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:Icon Size="14"
                                Data="{x:Bind local:Formats.CollectIcon(ViewModel.IsCollected), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind local:Formats.CollectLabel(ViewModel.IsCollected), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button
                        AutomationProperties.Name="分享"
                        Command="{x:Bind ViewModel.ShareCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:Icon Size="14" Data="{StaticResource IconShare}" />
                            <TextBlock Text="分享" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--
            ── 简介 ───────────────────────────────────────────────────────
            折叠起来：实测这份文案是整篇专辑企划（几千字），摊开会把曲目列表顶到屏幕外。
        -->
        <Expander
            Grid.Row="1"
            Margin="0,16,0,0"
            HorizontalAlignment="Stretch"
            Header="专辑简介"
            Visibility="{x:Bind local:Formats.Visible(ViewModel.HasDescription), Mode=OneWay}">
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Expander>

        <controls:TrackListToolbar
            Grid.Row="2"
            Margin="0,16,0,8"
            ReloadCommand="{x:Bind ViewModel.Tracks.ReloadCommand}"
            Target="{x:Bind AlbumTracksList}" />

        <controls:TrackListView
            x:Name="AlbumTracksList"
            Grid.Row="3"
            HasMore="{x:Bind ViewModel.Tracks.HasMore, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Tracks.Items}"
            LoadMoreCommand="{x:Bind ViewModel.Tracks.LoadMoreCommand}"
            TrackInvoked="OnTrackInvoked">
            <controls:TrackListView.Footer>
                <controls:PagingEndNote
                    RetryCommand="{x:Bind ViewModel.Tracks.LoadMoreCommand}"
                    ShowEnd="{x:Bind ViewModel.Tracks.ShowEnd, Mode=OneWay}"
                    ShowRetry="{x:Bind ViewModel.Tracks.ShowRetry, Mode=OneWay}" />
            </controls:TrackListView.Footer>
        </controls:TrackListView>

        <Grid Grid.Row="4" Style="{StaticResource BodianPageFooter}">
            <ProgressRing
                Style="{StaticResource BodianPageBusyRing}"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
