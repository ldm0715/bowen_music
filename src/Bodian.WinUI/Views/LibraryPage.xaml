<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    xmlns:models="using:Bodian.Core.Models">

    <!-- 乐库首页只展示大类，点击后进入该分类的子类与专辑列表。 -->
    <Grid Style="{StaticResource BodianPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="乐库" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <GridView
            Grid.Row="1"
            Padding="0"
            controls:CoverCardLayout.IsEnabled="True"
            controls:CoverCardLayout.CoverSize="{StaticResource SizeCoverGrid}"
            controls:CoverCardLayout.TextHeight="40"
            IsItemClickEnabled="True"
            ItemClick="OnGroupClick"
            ItemContainerStyle="{StaticResource BodianCoverCardItem}"
            ItemsSource="{x:Bind ViewModel.Groups}"
            SelectionMode="None">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid
                        CacheLength="0.5"
                        ItemHeight="208"
                        ItemWidth="162"
                        Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:MusicCategoryGroup">
                    <Grid
                        Width="{StaticResource SizeCoverGrid}"
                        RowSpacing="6"
                        VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Width="{StaticResource SizeCoverGrid}"
                            Height="{StaticResource SizeCoverGrid}"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="{StaticResource RadiusMd}">
                            <Grid>
                                <Image Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Stretch="UniformToFill" />

                                <Border
                                    Margin="0,0,8,8"
                                    Padding="7,1,7,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource MediaOverlayBackgroundBrush}"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Visibility="{x:Bind local:Formats.HasTracks(AlbumCount)}">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource MediaOverlayForegroundBrush}"
                                        Text="{x:Bind local:Formats.AlbumTotal(AlbumCount)}" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel
                            Grid.Row="1"
                            Spacing="2">
                            <TextBlock
                                MaxLines="1"
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                MaxLines="1"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <ProgressRing
            Grid.Row="2"
            Style="{StaticResource BodianPageBusyRing}"
            HorizontalAlignment="Left"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>
</Page>
