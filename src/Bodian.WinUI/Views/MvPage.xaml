<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Bodian.WinUI.Views.MvPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    xmlns:vm="using:Bodian.WinUI.ViewModels"
    RequestedTheme="Dark">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        <KeyboardAccelerator Key="F11" Invoked="OnFullscreenInvoked" />
        <KeyboardAccelerator Key="Space" Invoked="OnPlayPauseInvoked" />
    </Page.KeyboardAccelerators>

    <!--
        与歌词页不同，这里不做控制台的自动隐藏、不做 F11 全屏：MV 的主体是画面，
        控制条本来就压在画面下沿，藏起来反而让人找不到。样式与图标仍与那两处共用。
    -->
    <Grid x:Name="MvRoot" Background="#000000">
        <!--
            画面宿主。MediaPlayerElement 的尺寸由代码按 FitMode 算（见 UpdateVideoRect），
            超出宿主的部分靠 Clip 裁掉 —— 这是「适应宽度 / 适应高度」能成立的前提。
        -->
        <Grid x:Name="VideoHost" SizeChanged="OnVideoHostSizeChanged">
            <MediaPlayerElement x:Name="VideoSurface" AreTransportControlsEnabled="False" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!--
            状态浮层：加载中 / 这首歌没有 MV / 加载失败。
            盖在画面上而不是替代它 —— 失败时黑底比空白页更容易看出「是这里出问题」。
        -->
        <StackPanel x:Name="StatusHost" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
            Visibility="{x:Bind local:Formats.Visible(ViewModel.HasStatus), Mode=OneWay}">
            <ProgressRing Width="36" Height="36" Foreground="#CCFFFFFF"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="14"
                TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap" Foreground="#CCFFFFFF" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="96" />
            </Grid.RowDefinitions>

            <TitleBar x:Name="MvTitleBar" AutoRefreshDragRegions="False" Height="48" VerticalAlignment="Top"
                Background="Transparent" Foreground="#CCFFFFFF" AutomationProperties.Name="MV 标题栏">
                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                    <x:Double x:Key="TitleBarExpandedHeight">48</x:Double>
                    <x:Double x:Key="TitleBarLeftPaddingWidth">0</x:Double>
                    <x:Double x:Key="TitleBarLeftHeaderPaddingWidth">0</x:Double>
                    <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
                    <Thickness x:Key="TitleBarCompactContentMargin">0</Thickness>
                    <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
                </TitleBar.Resources>

                <TitleBar.LeftHeader>
                    <Button x:Name="BackButton" Click="OnBackClick" Style="{StaticResource PlayerRoundIconButtonStyle}"
                        HorizontalAlignment="Left" Margin="16,0,0,0"
                        AutomationProperties.Name="退出 MV" ToolTipService.ToolTip="退出 MV (Esc)">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Button.Resources>
                        <controls:Icon Data="{StaticResource IconChevronDown}" Size="{StaticResource SizeIconMd}" />
                    </Button>
                </TitleBar.LeftHeader>

                <TitleBar.Content>
                    <Grid />
                </TitleBar.Content>

                <TitleBar.RightHeader>
                    <Button x:Name="FullscreenButton" Click="OnFullscreenClick"
                        Style="{StaticResource PlayerRoundIconButtonStyle}"
                        AutomationProperties.Name="切换全屏" ToolTipService.ToolTip="进入全屏 (F11)">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Button.Resources>
                        <controls:Icon x:Name="FullscreenIcon" Data="{StaticResource IconFullScreen}" Size="{StaticResource SizeIconMd}" />
                    </Button>
                </TitleBar.RightHeader>
            </TitleBar>

            <StackPanel x:Name="HeadingHost" Grid.Row="0" Margin="64,0,64,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                    TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#CCFFFFFF" />
                <TextBlock Text="{x:Bind ViewModel.ArtistText, Mode=OneWay}" FontSize="11"
                    TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#80FFFFFF" />
            </StackPanel>

            <Grid x:Name="ControlDeck" Grid.Row="2" Margin="48,0,48,0" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Slider x:Name="PositionSlider" Grid.Row="0" MinWidth="0" Height="22" Padding="0"
                    VerticalAlignment="Top" Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                    Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.HasSource, Mode=OneWay}"
                    AutomationProperties.Name="MV 播放进度">
                    <Slider.Resources>
                        <SolidColorBrush x:Key="SliderTrackFill" Color="#40FFFFFF" />
                        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#40FFFFFF" />
                        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#40FFFFFF" />
                        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F2FFFFFF" />
                        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
                        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="White" />
                        <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
                        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White" />
                    </Slider.Resources>
                </Slider>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock x:Name="PositionText" HorizontalAlignment="Left" VerticalAlignment="Center"
                        FontSize="12" Foreground="#CCFFFFFF" Text="0:00" />
                    <Button x:Name="PlayPauseButton" HorizontalAlignment="Center" Click="OnPlayPauseClick"
                        Style="{StaticResource PlayerAccentButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.HasSource, Mode=OneWay}"
                        AutomationProperties.Name="播放 / 暂停" ToolTipService.ToolTip="播放 / 暂停 (Space)">
                        <Grid>
                            <controls:Icon Size="24" Data="{StaticResource IconPlay}"
                                Visibility="{x:Bind local:Formats.VisibleWhenFalse(ViewModel.IsPlaying), Mode=OneWay}" />
                            <controls:Icon Size="24" Data="{StaticResource IconPause}"
                                Visibility="{x:Bind local:Formats.Visible(ViewModel.IsPlaying), Mode=OneWay}" />
                        </Grid>
                    </Button>
                    <!--
                        音量。**不复用播放条那个 VolumeButton** —— 那个控件绑死在 PlayerViewModel 上，
                        而 MV 走的是另一套引擎（MediaPlayer），音量是独立的。滑条直接绑 MV 自己的 Volume。
                    -->
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Name="DurationText" VerticalAlignment="Center"
                            FontSize="12" Foreground="#80FFFFFF" Text="0:00" />

                        <!-- 音/视频互切：同一首曲子翻回「只听」。与右边那颗同样是文字按钮。 -->
                        <Button x:Name="SwitchToAudioButton" Click="OnSwitchToAudioClick"
                            Background="Transparent" BorderThickness="0" Padding="10,4" CornerRadius="6"
                            Foreground="#CCFFFFFF"
                            AutomationProperties.Name="只听歌" ToolTipService.ToolTip="只听歌">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:Icon Data="{StaticResource IconLyrics}" Size="14" />
                                <TextBlock Text="听歌" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!--
                            画面比例。用当前模式名当按钮文字而不是再画一颗图标 ——
                            这个控件本身就要表达「现在是哪种缩放」，文字比图标直白。
                        -->
                        <Button x:Name="FitModeButton" Background="Transparent" BorderThickness="0"
                            Padding="10,4" CornerRadius="6" Foreground="#CCFFFFFF"
                            AutomationProperties.Name="画面比例">
                            <TextBlock Text="{x:Bind ViewModel.FitModeLabel, Mode=OneWay}" FontSize="12" />
                            <Button.Flyout>
                                <!--
                                    用 ListView 而不是 RadioMenuFlyoutItem：后者靠一颗单选圆点表示选中，
                                    和「音质」「主题」两处的观感不一致。这里与那两处同一套做法 ——
                                    关掉指示条与勾选标记，只留 ListView 自带的**背景高亮**。
                                    色值不覆盖，用系统默认的选中底（两套主题下都合适）。
                                -->
                                <Flyout Placement="Top">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="Background" Value="{ThemeResource ThemeFlyoutBackground}" />
                                            <Setter Property="Padding" Value="6" />
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <ListView Width="100" MinWidth="0"
                                        SelectionMode="Single" IsItemClickEnabled="True"
                                        ItemClick="OnFitOptionClick"
                                        ItemsSource="{x:Bind ViewModel.FitOptions}"
                                        SelectedItem="{x:Bind ViewModel.SelectedFitOption, Mode=OneWay}"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollMode="Disabled"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.HorizontalScrollMode="Disabled"
                                        AutomationProperties.Name="画面比例">
                                        <ListView.Resources>
                                            <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                                            <x:Boolean x:Key="ListViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                                        </ListView.Resources>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                                <Setter Property="MinWidth" Value="0" />
                                                <Setter Property="MinHeight" Value="32" />
                                                <Setter Property="Padding" Value="10,7" />
                                                <Setter Property="Margin" Value="0,1" />
                                                <Setter Property="CornerRadius" Value="6" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MvFitOption">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <controls:Icon Data="{StaticResource IconVolume}" Size="16" Foreground="#80FFFFFF" />
                        <Slider x:Name="VolumeSlider" Width="96" Height="22" Padding="0" Minimum="0" Maximum="1"
                            Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                            AutomationProperties.Name="MV 音量">
                            <Slider.Resources>
                                <SolidColorBrush x:Key="SliderTrackFill" Color="#40FFFFFF" />
                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#40FFFFFF" />
                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#40FFFFFF" />
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F2FFFFFF" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="White" />
                                <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White" />
                            </Slider.Resources>
                        </Slider>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
