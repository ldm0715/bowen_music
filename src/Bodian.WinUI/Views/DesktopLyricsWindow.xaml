<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Bodian.WinUI.Views.DesktopLyricsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    Title="桌面歌词">

    <Grid x:Name="Root" Background="Transparent" RequestedTheme="Dark">
        <Grid.Resources>
            <Style x:Key="DesktopLyricsToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonChrome.Background" Value="#28FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonChrome.Background" Value="#40FFFFFF" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ButtonChrome.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Foreground="{TemplateBinding Foreground}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <!-- 只在悬停、拖动或打开设置时显示；文字始终完全不透明。 -->
        <Border x:Name="HoverBackground" Background="#99000000" CornerRadius="12"
            Opacity="0" IsHitTestVisible="False" />

        <Grid Padding="20,10" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Grid x:Name="LyricStack" Grid.Row="1" Background="Transparent" />

            <!-- 两排操作始终保留布局空间，悬停时歌词位置不跳动。 -->
            <Grid x:Name="Toolbar" Grid.RowSpan="3" Opacity="0" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                        <Button x:Name="FontSizeButton" Click="OnFontSizeClick" Style="{StaticResource DesktopLyricsToolbarButtonStyle}"
                            AutomationProperties.Name="字号" ToolTipService.ToolTip="字号">
                            <controls:Icon Data="{StaticResource IconTextFontSize}" Size="20" />
                        </Button>
                        <Button x:Name="ColorButton" Click="OnColorClick" Style="{StaticResource DesktopLyricsToolbarButtonStyle}"
                            AutomationProperties.Name="高亮颜色" ToolTipService.ToolTip="高亮颜色">
                            <controls:Icon x:Name="ColorIcon" Data="{StaticResource IconColor}" Size="20" />
                        </Button>
                        <Button x:Name="DualLineButton" Click="OnDualLineClick"
                            Style="{StaticResource DesktopLyricsToolbarButtonStyle}"
                            AutomationProperties.Name="双行歌词" ToolTipService.ToolTip="显示下一句">
                            <controls:Icon Data="{StaticResource IconTextLineSpacing}" Size="20" />
                        </Button>
                        <Button x:Name="AlignmentButton" Click="OnAlignmentClick"
                            Style="{StaticResource DesktopLyricsToolbarButtonStyle}"
                            AutomationProperties.Name="错位排列" ToolTipService.ToolTip="上行居左，下行居右">
                            <controls:Icon Data="{StaticResource IconTextAlignLeft}" Size="20" />
                        </Button>
                        <Button x:Name="PassThroughButton" Click="OnPassThroughClick"
                            Style="{StaticResource DesktopLyricsToolbarButtonStyle}"
                            AutomationProperties.Name="鼠标穿透" ToolTipService.ToolTip="鼠标穿透">
                            <controls:Icon x:Name="PassThroughIcon" Data="{StaticResource IconCursor}" Size="20" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button x:Name="LockButton" Click="OnLockClick"
                            Style="{StaticResource DesktopLyricsToolbarButtonStyle}"
                            AutomationProperties.Name="锁定位置" ToolTipService.ToolTip="锁定位置">
                            <controls:Icon x:Name="LockIcon" Data="{StaticResource IconLockOpen}" Size="20" />
                        </Button>
                        <Button x:Name="CloseButton" Click="OnCloseClick"
                            Style="{StaticResource DesktopLyricsToolbarButtonStyle}"
                            AutomationProperties.Name="关闭桌面歌词" ToolTipService.ToolTip="关闭桌面歌词">
                            <controls:Icon Data="{StaticResource IconDismiss}" Size="20" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="28">
                        <Button x:Name="PreviousButton" Command="{x:Bind Player.PreviousCommand}"
                            IsEnabled="{x:Bind Player.CanGoPrevious, Mode=OneWay}"
                            Style="{StaticResource DesktopLyricsToolbarButtonStyle}"
                            AutomationProperties.Name="上一首" ToolTipService.ToolTip="上一首">
                            <controls:Icon Data="{StaticResource IconPrevious}" Size="24" />
                        </Button>
                        <Button x:Name="PlayPauseButton" Command="{x:Bind Player.TogglePlayPauseCommand}"
                            Style="{StaticResource DesktopLyricsToolbarButtonStyle}"
                            AutomationProperties.Name="播放 / 暂停" ToolTipService.ToolTip="播放 / 暂停">
                            <Grid>
                                <controls:Icon Data="{StaticResource IconPlay}" Size="26"
                                    Visibility="{x:Bind local:Formats.VisibleWhenFalse(Player.IsPlaying), Mode=OneWay}" />
                                <controls:Icon Data="{StaticResource IconPause}" Size="26"
                                    Visibility="{x:Bind local:Formats.Visible(Player.IsPlaying), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button x:Name="NextButton" Command="{x:Bind Player.NextCommand}"
                            IsEnabled="{x:Bind Player.CanGoNext, Mode=OneWay}"
                            Style="{StaticResource DesktopLyricsToolbarButtonStyle}"
                            AutomationProperties.Name="下一首" ToolTipService.ToolTip="下一首">
                            <controls:Icon Data="{StaticResource IconNext}" Size="24" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="FavoriteButton" HorizontalAlignment="Right"
                        Command="{x:Bind Player.ToggleFavoriteCommand}"
                        IsEnabled="{x:Bind Player.Statistics.CanToggleFavorite, Mode=OneWay}"
                        Style="{StaticResource DesktopLyricsToolbarButtonStyle}"
                        AutomationProperties.Name="收藏 / 取消收藏" ToolTipService.ToolTip="收藏 / 取消收藏">
                        <Grid>
                            <controls:Icon Data="{StaticResource IconHeart}" Size="24"
                                Visibility="{x:Bind local:Formats.VisibleWhenFalse(Player.Statistics.IsFavorite), Mode=OneWay}" />
                            <controls:Icon Data="{StaticResource IconHeartFilled}" Size="24"
                                Visibility="{x:Bind local:Formats.Visible(Player.Statistics.IsFavorite), Mode=OneWay}" />
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- 设置留在本窗口内，避免无焦点悬浮窗的原生 Flyout 抢占/丢失指针捕获。 -->
        <Border x:Name="FontSizePanel" Visibility="Collapsed" HorizontalAlignment="Left"
            VerticalAlignment="Top" Margin="20,48,0,0" Width="232" Padding="16,12"
            Background="#F51C1C1C" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="4">
                <Grid>
                    <TextBlock Text="字号" FontSize="12" />
                    <TextBlock x:Name="FontSizeValue" HorizontalAlignment="Right" FontSize="12" />
                </Grid>
                <Slider x:Name="FontSizeSlider" Minimum="20" Maximum="96" StepFrequency="1"
                    AutomationProperties.Name="歌词字号" IsThumbToolTipEnabled="False"
                    ValueChanged="OnFontSizeChanged" />
            </StackPanel>
        </Border>
        <Border x:Name="ColorPanel" Visibility="Collapsed" HorizontalAlignment="Left"
            VerticalAlignment="Top" Margin="56,48,0,0" Padding="12" Background="#F51C1C1C"
            BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="8">
                <TextBlock Text="高亮颜色" FontSize="12" />
                <StackPanel x:Name="ColorPalette" Orientation="Horizontal" Spacing="6" />
            </StackPanel>
        </Border>

        <!-- 右边缘由原生命中条处理，不让 XAML 与窗口光标争用。 -->
    </Grid>
</Window>
