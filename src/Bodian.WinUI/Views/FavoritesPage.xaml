<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls">

    <Grid Style="{StaticResource BodianPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 计数那行在下面的工具栏左侧，这里只留标题 -->
        <TextBlock
            Grid.Row="0"
            Style="{StaticResource BodianPageTitle}"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}" />

        <!-- 多选栏里的「移出喜欢」走取消喜欢那条路（要同步喜欢状态缓存，不能直连歌单接口）。 -->
        <controls:TrackListToolbar
            Grid.Row="1"
            Margin="0,12,0,8"
            IsLikedPlaylist="True"
            ReloadCommand="{x:Bind ViewModel.ReloadCommand}"
            SummaryText="{x:Bind ViewModel.CountText, Mode=OneWay}"
            Target="{x:Bind FavoritesTracksList}" />

        <controls:TrackListView
            x:Name="FavoritesTracksList"
            Grid.Row="2"
            HasMore="{x:Bind ViewModel.HasMore, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Tracks}"
            LoadMoreCommand="{x:Bind ViewModel.LoadMoreCommand}"
            TrackInvoked="OnTrackInvoked">
            <controls:TrackListView.Footer>
                <controls:PagingEndNote
                    RetryCommand="{x:Bind ViewModel.LoadMoreCommand}"
                    ShowEnd="{x:Bind ViewModel.ShowEnd, Mode=OneWay}"
                    ShowRetry="{x:Bind ViewModel.ShowRetry, Mode=OneWay}" />
            </controls:TrackListView.Footer>
        </controls:TrackListView>

        <!-- 页脚只剩进度环：刷新入口已经挪到上面的工具栏，「重新加载」按钮删掉了。 -->
        <ProgressRing
            Grid.Row="3"
            Style="{StaticResource BodianPageBusyRing}"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>
</Page>
