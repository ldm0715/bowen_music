<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.LibraryCategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    xmlns:models="using:Bodian.Core.Models">

    <!--
        乐库的一个大类：子类 chips + 精品/最新 + 专辑列表。
        压在栈上的详情页，侧栏仍高亮「乐库」。

        ★ 子类与专辑不是一回事：子类来自首页那一次 navigation（不用请求），
          而每个子类的专辑列表要单独请求，所以只有下半部分有加载状态。
    -->
    <Grid Style="{StaticResource BodianPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 头部 ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="{StaticResource SizeCoverMd}"
                Height="{StaticResource SizeCoverMd}"
                VerticalAlignment="Top"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="{StaticResource RadiusMd}">
                <Image Source="{x:Bind local:Formats.CoverSource(ViewModel.Group.CoverImage)}" Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Group.Name}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Group.Title}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind local:Formats.AlbumCount(ViewModel.Group.AlbumCount)}" />
            </StackPanel>

        </Grid>

        <!-- ── 子类 ─────────────────────────────────────────────────────── -->
        <controls:VirtualizedListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Children}"
            SelectedItem="{x:Bind ViewModel.SelectedChild, Mode=TwoWay}"
            SelectionMode="Single"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.VerticalScrollMode="Disabled">
            <controls:VirtualizedListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" CacheLength="0.5" />
                </ItemsPanelTemplate>
            </controls:VirtualizedListView.ItemsPanel>
            <controls:VirtualizedListView.ItemTemplate>
                <DataTemplate x:DataType="models:MusicCategoryChild">
                    <TextBlock Margin="4,0" Text="{x:Bind Name}" />
                </DataTemplate>
            </controls:VirtualizedListView.ItemTemplate>
        </controls:VirtualizedListView>

        <!-- ── 排序：精品 / 最新 ────────────────────────────────────────── -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="16">
            <RadioButton
                x:Name="CuratedRadio"
                Checked="OnSortChanged"
                Content="精品"
                GroupName="MusicLibSort" />
            <RadioButton
                x:Name="NewestRadio"
                Checked="OnSortChanged"
                Content="最新"
                GroupName="MusicLibSort" />

            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Albums.StatusText, Mode=OneWay}" />
        </StackPanel>

        <!-- ── 专辑网格 ─────────────────────────────────────────────────── -->
        <GridView
            Grid.Row="3"
            controls:AutoPaging.Command="{x:Bind ViewModel.Albums.LoadMoreCommand}"
            controls:AutoPaging.HasMore="{x:Bind ViewModel.Albums.HasMore, Mode=OneWay}"
            IsItemClickEnabled="True"
            ItemClick="OnAlbumClick"
            ItemsSource="{x:Bind ViewModel.Albums.Items}"
            SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Album">
                    <StackPanel Width="132" Spacing="6">
                        <Grid>
                            <Border
                                Width="132"
                                Height="132"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="8">
                                <Image Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Stretch="UniformToFill" />
                            </Border>

                            <!-- 曲目数角标压在封面右下角，与歌手页专辑卡上那个同一个样式。 -->
                            <Border
                                Margin="0,0,8,8"
                                Padding="7,1,7,2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource MediaOverlayBackgroundBrush}"
                                CornerRadius="{StaticResource RadiusSm}"
                                Visibility="{x:Bind local:Formats.HasTracks(MusicCount)}">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource MediaOverlayForegroundBrush}"
                                    Text="{x:Bind local:Formats.AlbumCount(MusicCount)}" />
                            </Border>
                        </Grid>

                        <TextBlock
                            MaxLines="2"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ArtistText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.Footer>
                <controls:PagingEndNote
                    RetryCommand="{x:Bind ViewModel.Albums.LoadMoreCommand}"
                    ShowEnd="{x:Bind ViewModel.Albums.ShowEnd, Mode=OneWay}"
                    ShowRetry="{x:Bind ViewModel.Albums.ShowRetry, Mode=OneWay}" />
            </GridView.Footer>
        </GridView>

        <Grid Grid.Row="4" Style="{StaticResource BodianPageFooter}">
            <ProgressRing
                Style="{StaticResource BodianPageBusyRing}"
                IsActive="{x:Bind ViewModel.Albums.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
