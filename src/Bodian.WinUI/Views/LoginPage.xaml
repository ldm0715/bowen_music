<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI">

    <!-- 页面只保留外壳背景；登录内容由原生 ContentDialog 居中显示。 -->
    <Grid>
        <!--
            刻意不设 Title：页签本身就是标题，再加一行「登录」是重复的，
            而且会把弹窗顶部的留白撑开。没有 Title 时内容直接顶到边距上。
        -->
        <ContentDialog
            x:Name="LoginDialog"
            Background="{ThemeResource ThemeFlyoutBackground}"
            CornerRadius="{StaticResource RadiusMd}"
            Closing="OnDialogClosing">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMinWidth">340</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">420</x:Double>
            </ContentDialog.Resources>

            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    MinItemWidth 让两个页签等宽（默认是按内容自适应，那样很窄）。
                    HorizontalAlignment=Center 居中整条 —— 它管不了单个页签的宽度，
                    所以两者要一起用。
                -->
                <controls:PillTabBar
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.LoginMethods}"
                    MinItemWidth="128"
                    SelectedIndex="{x:Bind ViewModel.SelectedMethod, Mode=TwoWay}" />

                <!--
                    两个面板占同一行、只切可见性：隐藏的那个不参与测量，
                    行高自然跟着可见的那个走，不会留下空白。
                -->

                <!-- ── 扫码 ─────────────────────────────────────────────── -->
                <Grid
                    Grid.Row="1"
                    RowSpacing="16"
                    Visibility="{x:Bind local:Formats.Visible(ViewModel.IsQrMethod), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="用波点 App 扫描下方二维码。项目为非官方第三方客户端，建议用小号。"
                        TextWrapping="Wrap" />

                    <Border
                        Grid.Row="1"
                        Padding="12"
                        HorizontalAlignment="Center"
                        Background="White"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMd}">
                        <Grid Width="220" Height="220">
                            <!-- 保持二维码等比显示，白底与足够的四周留白用于正常识别。 -->
                            <Image
                                Source="{x:Bind ViewModel.QrImage, Mode=OneWay}"
                                Stretch="Uniform" />
                            <ProgressRing
                                Width="32"
                                Height="32"
                                IsActive="{x:Bind ViewModel.IsWaiting, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <!-- 状态行留在本面板内：两条路径各有一条，不共用。 -->
                    <TextBlock
                        Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.QrStatusText, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Button
                        Grid.Row="3"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Content="刷新二维码"
                        IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}" />
                </Grid>

                <!-- ── 手机号 ───────────────────────────────────────────── -->
                <Grid
                    Grid.Row="1"
                    RowSpacing="12"
                    Visibility="{x:Bind local:Formats.Visible(ViewModel.IsPhoneMethod), Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="用手机号接收短信验证码登录。项目为非官方第三方客户端，建议用小号。"
                        TextWrapping="Wrap" />

                    <!--
                        刻意**不设** MaxLength：从通讯录粘进来的号码常带 +86 或分隔符
                        （「+86 138 0013 8000」是 16 个字符），限 11 位会把粘贴内容截成无效串，
                        而 MobileNumber 本来就负责剥掉这些。校验交给 ViewModel。
                    -->
                    <TextBox
                        Grid.Row="1"
                        Header="手机号"
                        InputScope="TelephoneNumber"
                        Text="{x:Bind ViewModel.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Header="验证码"
                            InputScope="Number"
                            MaxLength="6"
                            Text="{x:Bind ViewModel.VerifyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            Grid.Column="1"
                            MinWidth="112"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.RequestCodeCommand}"
                            Content="{x:Bind ViewModel.CodeButtonText, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanRequestCode, Mode=OneWay}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="3"
                        HorizontalAlignment="Stretch"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.PhoneStatusText, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Button
                        Grid.Row="4"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.LoginByPhoneCommand}"
                        Content="登录"
                        IsEnabled="{x:Bind ViewModel.CanSubmitPhone, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Grid>
        </ContentDialog>
    </Grid>
</Page>
