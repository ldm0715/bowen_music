<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 页面只保留外壳背景；登录内容由原生 ContentDialog 居中显示。 -->
    <Grid>
        <ContentDialog
            x:Name="LoginDialog"
            Title="扫码登录"
            Background="{ThemeResource ThemeFlyoutBackground}"
            CornerRadius="{StaticResource RadiusMd}"
            Closing="OnDialogClosing">
            <ContentDialog.Resources>
                <x:Double x:Key="ContentDialogMinWidth">320</x:Double>
                <x:Double x:Key="ContentDialogMaxWidth">400</x:Double>
            </ContentDialog.Resources>

            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="用波点 App 扫描下方二维码。项目为非官方第三方客户端，建议用小号。"
                    TextWrapping="Wrap" />

                <Border
                    Grid.Row="1"
                    Padding="12"
                    HorizontalAlignment="Center"
                    Background="White"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}">
                    <Grid Width="220" Height="220">
                        <!-- 保持二维码等比显示，白底与足够的四周留白用于正常识别。 -->
                        <Image
                            Source="{x:Bind ViewModel.QrImage, Mode=OneWay}"
                            Stretch="Uniform" />
                        <ProgressRing
                            Width="32"
                            Height="32"
                            IsActive="{x:Bind ViewModel.IsWaiting, Mode=OneWay}" />
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Button
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Content="刷新二维码"
                    IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}" />
            </Grid>
        </ContentDialog>
    </Grid>
</Page>
