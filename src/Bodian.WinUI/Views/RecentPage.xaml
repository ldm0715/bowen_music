<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.RecentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls">

    <Grid Style="{StaticResource BodianPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 计数那行在下面的工具栏左侧，这里只留标题 -->
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="最近播放" />

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="OnClearClick"
                Content="清空记录" />
        </Grid>

        <controls:TrackListToolbar
            Grid.Row="1"
            Margin="0,12,0,8"
            ReloadCommand="{x:Bind ViewModel.ReloadCommand}"
            SummaryText="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            Target="{x:Bind RecentTracksList}" />

        <controls:TrackListView
            x:Name="RecentTracksList"
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Tracks}"
            TrackInvoked="OnTrackInvoked" />

        <ProgressRing
            Grid.Row="3"
            Style="{StaticResource BodianPageBusyRing}"
            HorizontalAlignment="Left"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>
</Page>
