<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Bodian.WinUI.Views.LyricsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI" RequestedTheme="Dark">
    <Page.Resources>
        <!-- 按钮外观不再单写：与播放条共用 Themes/Styles/Player.xaml 那一套。 -->
        <Style TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        </Style>
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
        <KeyboardAccelerator Key="F11" Invoked="OnFullscreenInvoked" />
        <KeyboardAccelerator Key="Space" Invoked="OnPlayPauseInvoked" />
    </Page.KeyboardAccelerators>
    <Grid x:Name="LyricsRoot" Background="#0B1222" SizeChanged="OnRootSizeChanged">
        <controls:LyricsBackdrop x:Name="BackdropView" CoverUri="{x:Bind Player.CurrentCoverUri, Mode=OneWay}" />
        <controls:AmbientBackdrop Opacity="0.18" />
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#08000000" Offset="0" />
                    <GradientStop Color="#08000000" Offset="0.5" />
                    <GradientStop Color="#58000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="80" />
            </Grid.RowDefinitions>
            <TitleBar x:Name="LyricsTitleBar" AutoRefreshDragRegions="False" Height="48" VerticalAlignment="Top"
                Background="Transparent" Foreground="#CCFFFFFF" AutomationProperties.Name="全屏歌词标题栏">
                <TitleBar.Resources>
                    <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                    <x:Double x:Key="TitleBarExpandedHeight">48</x:Double>
                    <x:Double x:Key="TitleBarLeftPaddingWidth">0</x:Double>
                    <x:Double x:Key="TitleBarLeftHeaderPaddingWidth">0</x:Double>
                    <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
                    <Thickness x:Key="TitleBarCompactContentMargin">0</Thickness>
                    <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
                </TitleBar.Resources>
                <TitleBar.LeftHeader>
                    <Grid x:Name="LeftChromeHost" Width="186">
                        <Button x:Name="CollapseButton" Click="OnBackClick" Style="{StaticResource PlayerRoundIconButtonStyle}"
                            HorizontalAlignment="Left" Margin="16,0,0,0"
                            AutomationProperties.Name="收起歌词" ToolTipService.ToolTip="收起歌词 (Esc)">
                            <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource SizeIconMd}" />
                        </Button>
                    </Grid>
                </TitleBar.LeftHeader>
                <TitleBar.Content>
                    <Grid />
                </TitleBar.Content>
                <TitleBar.RightHeader>
                    <Button x:Name="FullscreenButton" Click="OnFullscreenClick" Style="{StaticResource PlayerRoundIconButtonStyle}"
                        AutomationProperties.Name="切换全屏" ToolTipService.ToolTip="进入全屏 (F11)">
                        <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="{StaticResource SizeIconMd}" />
                    </Button>
                </TitleBar.RightHeader>
            </TitleBar>
            <Grid x:Name="HeadingHost" Height="48" Margin="64,0,64,0" VerticalAlignment="Top" IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <!--
                        标题与付费徽标放同一个横向 StackPanel，徽标才会紧跟标题。
                        用 `*`/`Auto` 两列时 `*` 列会吃满标题行，徽标被推到最右边、和标题拉开一大截。
                        代价是 StackPanel 不约束子元素，标题要自己带上限（见 MaxWidth）。
                    -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="{x:Bind SongHeading(Player.Title, Player.ArtistText), Mode=OneWay}"
                            MaxWidth="{x:Bind local:Formats.LyricsHeadingMaxWidth(HeadingHost.ActualWidth, Player.HasPayLabel), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold"
                            VerticalAlignment="Center" Foreground="#CCFFFFFF" />
                        <Border x:Name="PayBadge" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                            Background="#24FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1"
                            Visibility="{x:Bind local:Formats.Visible(Player.HasPayLabel), Mode=OneWay}">
                            <TextBlock Text="{x:Bind Player.PayLabel, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Player.AlbumText, Mode=OneWay}" TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#80FFFFFF" />
                </StackPanel>
            </Grid>
            <Grid x:Name="MainStage" Grid.Row="1" Margin="32,0,24,80" ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Canvas x:Name="CoverDeck" Width="320" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind local:Formats.Visible(Player.HasTrack), Mode=OneWay}">
                    <controls:AlbumCoverReflection x:Name="ReflectionView" Width="320" Height="176" Canvas.Top="322"
                        Opacity="0.25" CoverUri="{x:Bind Player.CurrentCoverUri, Mode=OneWay}" />
                    <Border x:Name="CoverFrame" Width="320" Height="320" CornerRadius="16" Background="#18FFFFFF">
                        <Image Source="{x:Bind Player.CoverImage, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                </Canvas>
                <Grid Grid.Column="1" Margin="0,0,0,4">
                    <ContentControl x:Name="CanvasHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <Button x:Name="FollowButton" Content="回到当前歌词" Click="OnFollowClick"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,20"
                        Visibility="Collapsed" AutomationProperties.Name="回到当前歌词" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="420">
                        <ProgressRing Width="24" Height="24" IsActive="{x:Bind Lyrics.IsLoading, Mode=OneWay}"
                            Visibility="{x:Bind local:Formats.Visible(Lyrics.IsLoading), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Lyrics.StatusText, Mode=OneWay}" Foreground="#A6FFFFFF" FontSize="18"
                            TextAlignment="Center" TextWrapping="Wrap" Visibility="{x:Bind local:Formats.Visible(Lyrics.HasStatusText), Mode=OneWay}" />
                        <Button Content="重试" Command="{x:Bind Lyrics.RetryCommand}" HorizontalAlignment="Center"
                            Visibility="{x:Bind local:Formats.Visible(Lyrics.LoadFailed), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <ContentControl x:Name="SpectrumHost" Grid.Row="1" Height="64" Margin="20,0,20,12"
                VerticalAlignment="Bottom" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                IsHitTestVisible="False" />
            <Grid x:Name="ControlDeck" Grid.Row="2" Margin="24,12,24,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                    <Button Style="{StaticResource PlayerBareIconButtonStyle}" Command="{x:Bind Player.PreviousCommand}"
                        IsEnabled="{x:Bind Player.CanGoPrevious, Mode=OneWay}" AutomationProperties.Name="上一首" ToolTipService.ToolTip="上一首">
                        <FontIcon Glyph="&#xE892;" FontSize="28" />
                    </Button>
                    <Button Style="{StaticResource PlayerAccentButtonStyle}" Command="{x:Bind Player.TogglePlayPauseCommand}"
                        IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}" AutomationProperties.Name="播放 / 暂停" ToolTipService.ToolTip="播放 / 暂停 (Space)">
                        <FontIcon Glyph="{x:Bind PlayPauseGlyph(Player.IsPlaying), Mode=OneWay}" FontSize="24" />
                    </Button>
                    <Button Style="{StaticResource PlayerBareIconButtonStyle}" Command="{x:Bind Player.NextCommand}"
                        IsEnabled="{x:Bind Player.CanGoNext, Mode=OneWay}" AutomationProperties.Name="下一首" ToolTipService.ToolTip="下一首">
                        <FontIcon Glyph="&#xE893;" FontSize="28" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="8">
                    <controls:TrackStatisticButton x:Name="FavoriteButton" Glyph="&#xEB51;" ActiveGlyph="&#xEB52;"
                        Foreground="#CCFFFFFF"
                        IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                        IsActive="{x:Bind Player.Statistics.IsFavorite, Mode=OneWay}"
                        Command="{x:Bind Player.ToggleFavoriteCommand}"
                        Label="{x:Bind Player.Statistics.FavoriteAutomationName, Mode=OneWay}"
                        BadgeText="{x:Bind Player.Statistics.FavoriteBadgeText, Mode=OneWay}"
                        HasBadgeCount="{x:Bind Player.Statistics.HasFavoriteCount, Mode=OneWay}" />
                    <controls:TrackStatisticButton x:Name="ShareButton" Glyph="&#xE72D;" Foreground="#CCFFFFFF"
                        IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                        Command="{x:Bind Player.ShareCommand}"
                        Label="{x:Bind Player.Statistics.ShareAutomationName, Mode=OneWay}"
                        BadgeText="{x:Bind Player.Statistics.ShareBadgeText, Mode=OneWay}"
                        HasBadgeCount="{x:Bind Player.Statistics.HasShareCount, Mode=OneWay}" />
                    <TextBlock Text="试听" Foreground="#70FFFFFF" FontSize="12" VerticalAlignment="Center"
                        Visibility="{x:Bind local:Formats.Visible(Player.IsAudition), Mode=OneWay}" />
                </StackPanel>
                <!--
                    ★ Spacing 16 而不是左边那组的 8：音质标签是撑满按钮的方块，
                      旁边「评论」「音量」都是外圈留白的图标按钮 —— 数值一样时，
                      方块那侧的视觉空隙只有一半，看着就挤。
                      左边收藏 / 分享两颗都是图标按钮，没有这个问题，保持 8。
                -->
                <StackPanel x:Name="VolumeDeck" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="16">
                    <!--
                        评论入口与左下角的收藏 / 分享用同一个控件，尺寸和角标样式天然一致；
                        面板打开时用 IsActive 换成强调色图标，不再由代码改前景色。
                    -->
                    <controls:TrackStatisticButton x:Name="CommentsButton" Glyph="&#xE90A;" ActiveGlyph="&#xE90A;"
                        Foreground="#CCFFFFFF"
                        IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}"
                        IsActive="{x:Bind Comments.IsOpen, Mode=OneWay}"
                        Click="OnCommentsClick"
                        Label="{x:Bind Comments.BadgeAutomationName, Mode=OneWay}"
                        BadgeText="{x:Bind Comments.BadgeText, Mode=OneWay}"
                        HasBadgeCount="{x:Bind Comments.HasBadgeCount, Mode=OneWay}" />
                    <!-- 音质按钮回到扁平药丸那一版：36 宽、圆角 8，胶囊横向撑满、纵向居中。 -->
                    <Button x:Name="QualityButton" Width="36" Height="36" CornerRadius="8" Padding="0"
                        Style="{StaticResource PlayerRoundIconButtonStyle}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                        IsEnabled="{x:Bind Player.CanChangeQuality, Mode=OneWay}" AutomationProperties.Name="音质切换"
                        ToolTipService.ToolTip="{x:Bind Player.QualityText, Mode=OneWay}">
                        <controls:AudioQualityChip
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Label="{x:Bind Player.QualityLabel, Mode=OneWay}"
                            Quality="{x:Bind Player.CurrentQuality, Mode=OneWay}" />
                        <Button.Flyout>
                            <Flyout x:Name="QualityFlyout" Placement="Top">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="Background" Value="{ThemeResource ThemeFlyoutBackground}" />
                                        <Setter Property="Padding" Value="6" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <controls:AudioQualityPicker ViewModel="{x:Bind Player}" SelectionRequested="OnQualitySelected" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- 与播放条同一个音量控件：一颗图标按钮，悬停才在上方展开竖向滑条，不外显。 -->
                    <controls:VolumeButton
                        x:Name="VolumeControl"
                        ViewModel="{x:Bind Player, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{x:Bind Player.Notice, Mode=OneWay}" FontSize="12"
                    Foreground="#BCFFFFFF" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind local:Formats.Visible(Player.HasNotice), Mode=OneWay}" />
            </Grid>

            <Slider x:Name="PositionSlider" Grid.Row="2" MinWidth="0" Height="22" Margin="0,-11,0,0"
                Padding="0" VerticalAlignment="Top" Maximum="{x:Bind Player.ProgressMaximum, Mode=OneWay}"
                Value="{x:Bind Player.PositionSeconds, Mode=OneWay}" ValueChanged="OnProgressValueChanged"
                IsEnabled="{x:Bind Player.HasTrack, Mode=OneWay}" AutomationProperties.Name="播放进度">
                <Slider.Resources>
                    <SolidColorBrush x:Key="SliderTrackFill" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F2FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="White" />
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White" />
                    <SolidColorBrush x:Key="SliderInnerThumbBackground" Color="White" />
                    <SolidColorBrush x:Key="SliderInnerThumbBackgroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="SliderInnerThumbBackgroundPressed" Color="White" />
                    <x:Double x:Key="SliderTrackThemeHeight">2</x:Double>
                    <x:Double x:Key="SliderHorizontalHeight">22</x:Double>
                    <x:Double x:Key="SliderPreContentMargin">0</x:Double>
                    <x:Double x:Key="SliderPostContentMargin">0</x:Double>
                    <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
                    <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
                    <x:Double x:Key="SliderInnerThumbWidth">10</x:Double>
                    <x:Double x:Key="SliderInnerThumbHeight">10</x:Double>
                </Slider.Resources>
            </Slider>
        </Grid>
        <!-- 实色面板保证封面颜色和动态背景不会透过正文；空白区点击收起。 -->
        <Grid x:Name="CommentsOverlay" Margin="0,72,0,94"
            Visibility="{x:Bind local:Formats.Visible(Comments.IsOpen), Mode=OneWay}">
            <Rectangle Fill="Transparent" Tapped="OnCommentsDismissTapped" />
            <Border x:Name="CommentsPane" Width="420" HorizontalAlignment="Right" Margin="12,0,20,12"
                Background="{ThemeResource CommentPanelBackgroundBrush}" BorderBrush="{ThemeResource CommentBorderBrush}" BorderThickness="1" CornerRadius="16">
                <Grid>
                    <ContentControl x:Name="CommentsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <!-- 原图查看仅覆盖整个评论面板，保留列表位置和回复上下文。 -->
                    <controls:CommentImageViewer x:Name="CommentsImageViewer" ImageUri="{x:Bind Comments.PreviewImageUri, Mode=OneWay}"
                        Visibility="{x:Bind local:Formats.Visible(Comments.IsImageOpen), Mode=OneWay}"
                        CloseRequested="OnImageCloseRequested" />
                </Grid>
            </Border>
        </Grid>
        <Popup x:Name="ProgressTimePopup" IsHitTestVisible="False">
            <Border x:Name="ProgressTimeBubble" Padding="9,5" Background="#EF191B22" CornerRadius="7"
                BorderBrush="#26FFFFFF" BorderThickness="1">
                <TextBlock x:Name="ProgressTimeText" FontSize="11" FontWeight="SemiBold"
                    FontFamily="Cascadia Mono" Foreground="White" />
            </Border>
        </Popup>
    </Grid>
</Page>
