<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.BangDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bodian.WinUI"
    xmlns:vm="using:Bodian.WinUI.ViewModels">

    <Grid Padding="24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="64"
                Height="64"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="8">
                <Image Source="{x:Bind local:Formats.CoverSource(ViewModel.CoverImage)}" Stretch="UniformToFill" />
            </Border>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="3">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.UpdateText}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Tracks.StatusText, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <ListView
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemsSource="{x:Bind ViewModel.Tracks.Items}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:RankedTrack">
                    <Grid Padding="8,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{x:Bind vm:BangVisuals.RankBrush(Rank)}"
                            Text="{x:Bind RankText}" />

                        <!-- 封面。与榜列表页同一套行样式 -->
                        <Border
                            Grid.Column="1"
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="4">
                            <Image Source="{x:Bind local:Formats.CoverSource(Track.CoverImage)}" Stretch="UniformToFill" />
                        </Border>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Text="{x:Bind Track.Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Track.ArtistText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Track.AlbumName}"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="200" />

                        <TextBlock
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind local:Formats.Duration(Track.Duration)}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressRing
                Grid.Column="0"
                Width="16"
                Height="16"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.Tracks.IsBusy, Mode=OneWay}" />

            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.Tracks.LoadMoreCommand}"
                Content="加载更多"
                Visibility="{x:Bind ViewModel.Tracks.HasMore, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
