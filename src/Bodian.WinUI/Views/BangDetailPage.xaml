<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.BangDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    xmlns:vm="using:Bodian.WinUI.ViewModels">

    <Grid Style="{StaticResource BodianPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="64"
                Height="64"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="8">
                <Image Source="{x:Bind local:Formats.CoverSource(ViewModel.CoverImage)}" Stretch="UniformToFill" />
            </Border>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="3">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.UpdateText}" />
            </StackPanel>
        </Grid>

        <!--
            行模板用共享的 TrackListView。
            它认得 RankedTrack（用条目自带的名次、不补零），所以榜单详情不必再维护
            第二套行样式 —— 之前这里与榜列表页各写了一份，样式改一处漏一处。

            代价是列的构成统一成曲目列表那套（多了音质列、付费徽标、
            序号列的悬停与「正在播放」三态），这是有意的。
        -->
        <controls:TrackListToolbar
            Grid.Row="1"
            Margin="0,0,0,8"
            ReloadCommand="{x:Bind ViewModel.Tracks.ReloadCommand}"
            SummaryText="{x:Bind ViewModel.Tracks.StatusText, Mode=OneWay}"
            Target="{x:Bind BangTracksList}" />

        <controls:TrackListView
            x:Name="BangTracksList"
            Grid.Row="2"
            HasMore="{x:Bind ViewModel.Tracks.HasMore, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Tracks.Items}"
            LoadMoreCommand="{x:Bind ViewModel.Tracks.LoadMoreCommand}"
            TrackInvoked="OnTrackInvoked">
            <controls:TrackListView.Footer>
                <controls:PagingEndNote
                    RetryCommand="{x:Bind ViewModel.Tracks.LoadMoreCommand}"
                    ShowEnd="{x:Bind ViewModel.Tracks.ShowEnd, Mode=OneWay}"
                    ShowRetry="{x:Bind ViewModel.Tracks.ShowRetry, Mode=OneWay}" />
            </controls:TrackListView.Footer>
        </controls:TrackListView>

        <Grid Grid.Row="3" Style="{StaticResource BodianPageFooter}">
            <ProgressRing
                Style="{StaticResource BodianPageBusyRing}"
                IsActive="{x:Bind ViewModel.Tracks.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
