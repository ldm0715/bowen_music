<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.CollectedPlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    xmlns:models="using:Bodian.Core.Models">

    <Page.Resources>
        <!--
            ★★ 卡片模板**只能留在页面里，不能挪进共享资源字典**（踩过，理由见 `SearchPage.xaml` 里那段长注释）：
              `x:Bind` 放进 ResourceDictionary 会报 `WMC1119`；补 `x:Class` 之后编译能过、
              但运行时绑定全不生效（文字图片为空、`Visibility` 退回默认的 `Visible`）。

            ★ 这一份与 `SearchPage.xaml` 的 `SearchPlaylistCardTemplate` 是**复制关系，改一处要同步另一处**。
              尺寸口径：封面 132、卡片宽 132、RowSpacing 6、文字区按 CoverCardLayout 的 TextHeight="60" 预留。

            ★ **没有隐私锁**。列表行模板上有那一颗，但卡片挂一颗只会让人以为「这个是我的私密歌单」；
              而且这一页的歌单本来就是收藏来的，私密的根本收藏不了。

            ★ 曲目数画在封面右下角角标里，与专辑卡同形（歌单不像专辑有「艺人」那一行可放，
              单独占一行会让这张卡比专辑卡空一块）。歌单名因此放宽到两行。
        -->
        <DataTemplate x:Key="CollectedPlaylistCardTemplate" x:DataType="models:Playlist">
            <Grid
                Width="132"
                RowSpacing="6"
                VerticalAlignment="Top">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <Border
                    Width="132"
                    Height="132"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource RadiusMd}">
                    <Grid>
                        <Image controls:Motion.SharedCoverKey="{x:Bind local:Formats.PlaylistCoverKey(Id)}" Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Stretch="UniformToFill" />

                        <Border
                            Margin="0,0,8,8"
                            Padding="7,1,7,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource MediaOverlayBackgroundBrush}"
                            CornerRadius="{StaticResource RadiusSm}"
                            Visibility="{x:Bind local:Formats.HasTracks(MusicCount)}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource MediaOverlayForegroundBrush}"
                                Text="{x:Bind local:Formats.AlbumCount(MusicCount)}" />
                        </Border>
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="1"
                    LineHeight="20"
                    MaxLines="2"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Style="{StaticResource BodianPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="收藏的歌单" />

                <!--
                    与「收藏的专辑」同一套：状态文案会把「没有收藏」和「查询没成功」两种可能都说出来。
                    样式同样对齐工具栏那格。
                -->
                <TextBlock
                    Style="{StaticResource BodianPageStatusStrong}"
                    Text="{x:Bind ViewModel.Playlists.StatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- 刷新在左、视图切换在右。理由与「收藏的专辑」那页同一份注释。 -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center">
                <Button
                    AutomationProperties.Name="重新加载"
                    Command="{x:Bind ViewModel.Playlists.ReloadCommand}"
                    Style="{StaticResource BodianIconButton}"
                    ToolTipService.ToolTip="重新加载">
                    <controls:Icon Size="16" Data="{StaticResource IconRefresh}" />
                </Button>

                <Button
                    AutomationProperties.Name="{x:Bind local:Formats.ViewToggleLabel(ViewModel.ViewMode.UseGrid), Mode=OneWay}"
                    Command="{x:Bind ViewModel.ViewMode.ToggleCommand}"
                    Style="{StaticResource BodianIconButton}"
                    ToolTipService.ToolTip="{x:Bind local:Formats.ViewToggleLabel(ViewModel.ViewMode.UseGrid), Mode=OneWay}">
                    <controls:Icon Data="{x:Bind local:Formats.ViewToggleIcon(ViewModel.ViewMode.UseGrid), Mode=OneWay}" Size="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!--
            列表与网格都留在可视树上、只切 Visibility。同一份集合喂给两者，
            但任一时刻只有一个在布局里 —— 能实现容器的只有它，
            所以不会一边滚一边被另一边再触发一次翻页（见 Controls/AutoPaging.cs）。
        -->
        <controls:PlaylistListView
            Grid.Row="1"
            HasMore="{x:Bind ViewModel.Playlists.HasMore, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Playlists.Items}"
            LoadMoreCommand="{x:Bind ViewModel.Playlists.LoadMoreCommand}"
            PlaylistInvoked="OnPlaylistInvoked"
            Visibility="{x:Bind local:Formats.Visible(ViewModel.ViewMode.IsList), Mode=OneWay}">
            <controls:PlaylistListView.Footer>
                <controls:PagingEndNote
                    RetryCommand="{x:Bind ViewModel.Playlists.LoadMoreCommand}"
                    ShowEnd="{x:Bind ViewModel.Playlists.ShowEnd, Mode=OneWay}"
                    ShowRetry="{x:Bind ViewModel.Playlists.ShowRetry, Mode=OneWay}" />
            </controls:PlaylistListView.Footer>
        </controls:PlaylistListView>

        <GridView
            Grid.Row="1"
            Style="{StaticResource BodianCoverCardGrid}"
            controls:CoverCardLayout.CoverSize="132"
            controls:CoverCardLayout.IsEnabled="True"
            controls:CoverCardLayout.TextHeight="60"
            controls:AutoPaging.Command="{x:Bind ViewModel.Playlists.LoadMoreCommand}"
            controls:AutoPaging.HasMore="{x:Bind ViewModel.Playlists.HasMore, Mode=OneWay}"
            ItemClick="OnPlaylistClick"
            ItemTemplate="{StaticResource CollectedPlaylistCardTemplate}"
            ItemsSource="{x:Bind ViewModel.Playlists.Items}"
            Visibility="{x:Bind local:Formats.Visible(ViewModel.ViewMode.UseGrid), Mode=OneWay}">
            <!-- ItemHeight / ItemWidth 必须与上面那三个 CoverCardLayout 值对得上（132+2*4+4 / 132+6+60+2*4+4） -->
            <GridView.ItemsPanel>
                <ItemsPanelTemplate><ItemsWrapGrid CacheLength="0.5" ItemHeight="210" ItemWidth="144" Orientation="Horizontal" /></ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.Footer>
                <controls:PagingEndNote
                    RetryCommand="{x:Bind ViewModel.Playlists.LoadMoreCommand}"
                    ShowEnd="{x:Bind ViewModel.Playlists.ShowEnd, Mode=OneWay}"
                    ShowRetry="{x:Bind ViewModel.Playlists.ShowRetry, Mode=OneWay}" />
            </GridView.Footer>
        </GridView>

        <!-- 刷新入口在标题右侧，这里只剩转圈（与其余页的页脚同形） -->
        <ProgressRing
            Grid.Row="2"
            Style="{StaticResource BodianPageBusyRing}"
            IsActive="{x:Bind ViewModel.Playlists.IsBusy, Mode=OneWay}" />
    </Grid>
</Page>
