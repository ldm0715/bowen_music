<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:home="using:Bodian.Core.Models.Home">

    <Grid Padding="24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="发现" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!--
            一个模块 = 一段（标题 + 若干组）。用 ListView 而不是 ScrollViewer + StackPanel：
            滚动到底要靠 ListView 内部那个 ScrollViewer 的 ViewChanged 来触发懒加载。

            ★ ScrollViewer 的附加属性必须写在 ListView 上，内部那个才会带上纵向滚动。
        -->
        <ListView
            x:Name="FeedList"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Feeds}"
            SelectionMode="None"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollMode="Enabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <!-- 模块之间靠内容自己的间距分开，容器不要内边距与选中效果 -->
                    <Setter Property="Padding" Value="0,0,0,16" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="home:HomeFeed">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Margin="4,0,0,0"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title}" />

                        <ItemsControl ItemsSource="{x:Bind Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="home:HomeSection">
                                    <controls:HomeSectionView
                                        Margin="0,0,0,12"
                                        CardInvoked="OnCardInvoked"
                                        Section="{x:Bind}"
                                        SectionInvoked="OnSectionInvoked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressRing
                Grid.Column="0"
                Width="16"
                Height="16"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <!-- 兜底入口：滚动检测失效时用户还能手动拉下一批 -->
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.LoadMoreCommand}"
                Content="加载更多"
                Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
