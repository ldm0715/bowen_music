<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:home="using:Bodian.Core.Models.Home"
    xmlns:vm="using:Bodian.WinUI.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="DiscoverHeaderTemplate" x:DataType="vm:ListSectionHeader">
            <TextBlock Margin="4,12,0,8" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
        </DataTemplate>
        <DataTemplate x:Key="DiscoverSectionTemplate" x:DataType="home:HomeSection">
            <controls:HomeSectionView Margin="0,0,0,12" CardInvoked="OnCardInvoked" Section="{x:Bind}"
                SectionInvoked="OnSectionInvoked" />
        </DataTemplate>
        <controls:ResultTemplateSelector x:Key="DiscoverTemplateSelector"
            HeaderTemplate="{StaticResource DiscoverHeaderTemplate}" HomeSectionTemplate="{StaticResource DiscoverSectionTemplate}" />
    </Page.Resources>
    <Grid Style="{StaticResource BodianPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="发现" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- 模块标题与每个横向卡片区都是可回收的独立条目；不会实现整组离屏卡片。 -->
        <!--
            翻页靠末尾条目被实现来触发。首屏若不足一屏会自动补到填满 ——
            否则列表根本滚不动，后面的模块就永远够不到了。
        -->
        <controls:VirtualizedListView x:Name="FeedList" Grid.Row="1"
            Padding="{StaticResource SpaceVerticalScrollContentPadding}" ItemsSource="{x:Bind ViewModel.Rows}"
            controls:AutoPaging.Command="{x:Bind ViewModel.LoadMoreCommand}"
            controls:AutoPaging.HasMore="{x:Bind ViewModel.HasMore, Mode=OneWay}"
            ItemTemplateSelector="{StaticResource DiscoverTemplateSelector}" SelectionMode="None"
            ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled">
            <controls:VirtualizedListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </controls:VirtualizedListView.ItemContainerStyle>
            <controls:VirtualizedListView.Footer>
                <controls:PagingEndNote
                    RetryCommand="{x:Bind ViewModel.LoadMoreCommand}"
                    ShowEnd="{x:Bind ViewModel.ShowEnd, Mode=OneWay}"
                    ShowRetry="{x:Bind ViewModel.ShowRetry, Mode=OneWay}" />
            </controls:VirtualizedListView.Footer>
        </controls:VirtualizedListView>

        <Grid Grid.Row="2" Style="{StaticResource BodianPageFooter}">
            <ProgressRing
                Style="{StaticResource BodianPageBusyRing}"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
