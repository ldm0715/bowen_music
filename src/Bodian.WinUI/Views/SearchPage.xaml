<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Bodian.WinUI.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    xmlns:models="using:Bodian.Core.Models"
    xmlns:vm="using:Bodian.WinUI.ViewModels">
    <Page.Resources>
        <DataTemplate x:Key="SearchPlaylistTemplate" x:DataType="models:Playlist">
            <Grid Padding="4,8" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Width="64" Height="64" Stretch="UniformToFill" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="{x:Bind MusicCount}" /><TextBlock Text="首歌曲" /></StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SearchAlbumTemplate" x:DataType="models:Album">
            <Grid Padding="4,8" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Width="64" Height="64" Stretch="UniformToFill" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ArtistText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SearchArtistTemplate" x:DataType="models:Artist">
            <Grid Padding="4,8" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Width="64" Height="64" Stretch="UniformToFill" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="OverviewHeaderTemplate" x:DataType="vm:ListSectionHeader">
            <Grid Margin="0,16,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <HyperlinkButton Grid.Column="1" Content="更多" Tag="{x:Bind Category}" Click="OnOverviewMoreClick" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="OverviewTrackTemplate" x:DataType="vm:TrackRow">
            <Grid
                MinHeight="{StaticResource SizeRowHeight}"
                Padding="{StaticResource SpaceRowPadding}"
                Background="Transparent"
                ColumnSpacing="{StaticResource SpaceRow}"
                PointerEntered="OnOverviewRowPointerEntered"
                PointerExited="OnOverviewRowPointerExited">
                <!--
                    列宽写的是字面量而不是 token：ColumnDefinition.Width 是 GridLength，
                    而 token 定义的是 x:Double —— {StaticResource} 返回的是 double 对象，
                    赋给 GridLength 会类型不匹配。数值与 Tokens.xaml 里的
                    SizeRowOrdinalColumn / SizeRowDurationColumn 一致，改的时候两处一起改。
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.7*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>

                <!--
                    序号列：三态互斥。正在播放 → 频谱条；悬停 → 播放键；其余 → 序号。
                    三个 Visibility 由 TrackRow 统一算好，这里不拼条件。
                -->
                <Grid Grid.Column="0">
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeBody}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind OrdinalText}"
                        Visibility="{x:Bind IndexVisibility, Mode=OneWay}" />

                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Glyph="&#xE768;"
                        Visibility="{x:Bind PlayGlyphVisibility, Mode=OneWay}" />

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2"
                        Visibility="{x:Bind BarsVisibility, Mode=OneWay}">
                        <Rectangle
                            Width="3"
                            Height="8"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            RadiusX="1.5"
                            RadiusY="1.5" />
                        <Rectangle
                            Width="3"
                            Height="14"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            RadiusX="1.5"
                            RadiusY="1.5" />
                        <Rectangle
                            Width="3"
                            Height="10"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            RadiusX="1.5"
                            RadiusY="1.5" />
                    </StackPanel>
                </Grid>

                <!-- 封面。没有封面时留一块底色，行高不跳。 -->
                <Border
                    Grid.Column="1"
                    Width="{StaticResource SizeCoverRow}"
                    Height="{StaticResource SizeCoverRow}"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource RadiusMd}">
                    <Image Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Stretch="UniformToFill" />
                </Border>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            FontSize="{StaticResource FontSizeBodyLarge}"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />

                        <!-- 付费标识：让用户在点之前就知道要不要会员 -->
                        <Border
                            Padding="5,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="{StaticResource RadiusXs}"
                            Visibility="{x:Bind PayLabelVisibility}">
                            <TextBlock FontSize="{StaticResource FontSizeCaption}" Text="{x:Bind PayLabel}" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ArtistText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeCaption}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind AlbumName}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeCaption}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind Quality}" />

                <!--
                    时长。TextBlock 没有 OpenType feature 属性（等宽数字做不到），
                    所以只能靠固定列宽 + 右对齐。
                -->
                <TextBlock
                    Grid.Column="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeCaption}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind DurationText}" />
            </Grid>
        </DataTemplate>
        <controls:ResultTemplateSelector x:Key="OverviewTemplateSelector"
            HeaderTemplate="{StaticResource OverviewHeaderTemplate}" TrackTemplate="{StaticResource OverviewTrackTemplate}"
            PlaylistTemplate="{StaticResource SearchPlaylistTemplate}" AlbumTemplate="{StaticResource SearchAlbumTemplate}"
            ArtistTemplate="{StaticResource SearchArtistTemplate}" />
    </Page.Resources>
    <Grid Style="{StaticResource BodianTrackPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="搜索" />
            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Pivot Grid.Row="1" SelectedIndex="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}">
            <PivotItem Header="综合">
                <controls:VirtualizedListView x:Name="OverviewList" ItemsSource="{x:Bind ViewModel.OverviewItems}"
                    ItemTemplateSelector="{StaticResource OverviewTemplateSelector}" SelectionMode="None"
                    IsItemClickEnabled="True" ItemClick="OnOverviewItemClick"
                    ContainerContentChanging="OnOverviewContainerContentChanging">
                    <controls:VirtualizedListView.ItemsPanel>
                        <ItemsPanelTemplate><ItemsStackPanel CacheLength="0.5" /></ItemsPanelTemplate>
                    </controls:VirtualizedListView.ItemsPanel>
                    <controls:VirtualizedListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </controls:VirtualizedListView.ItemContainerStyle>
                </controls:VirtualizedListView>
            </PivotItem>
            <!--
                四个分页页签各自挂一份末尾提示：只有当前页签的列表会实现容器，
                所以翻页与提示天然跟着选中的那个走。「综合」不分页，不挂。
            -->
            <PivotItem Header="单曲">
                <controls:TrackListView
                    HasMore="{x:Bind ViewModel.HasMore, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.Results}"
                    LoadMoreCommand="{x:Bind ViewModel.LoadMoreCommand}"
                    TrackInvoked="OnTrackInvoked">
                    <controls:TrackListView.Footer>
                        <controls:PagingEndNote
                            RetryCommand="{x:Bind ViewModel.LoadMoreCommand}"
                            ShowEnd="{x:Bind ViewModel.ShowEnd, Mode=OneWay}"
                            ShowRetry="{x:Bind ViewModel.ShowRetry, Mode=OneWay}" />
                    </controls:TrackListView.Footer>
                </controls:TrackListView>
            </PivotItem>
            <PivotItem Header="歌单">
                <controls:VirtualizedListView ItemsSource="{x:Bind ViewModel.Playlists}" ItemTemplate="{StaticResource SearchPlaylistTemplate}" IsItemClickEnabled="True" ItemClick="OnPlaylistClick" SelectionMode="None"
                    controls:AutoPaging.Command="{x:Bind ViewModel.LoadMoreCommand}"
                    controls:AutoPaging.HasMore="{x:Bind ViewModel.HasMore, Mode=OneWay}">
                    <controls:VirtualizedListView.Footer>
                        <controls:PagingEndNote
                            RetryCommand="{x:Bind ViewModel.LoadMoreCommand}"
                            ShowEnd="{x:Bind ViewModel.ShowEnd, Mode=OneWay}"
                            ShowRetry="{x:Bind ViewModel.ShowRetry, Mode=OneWay}" />
                    </controls:VirtualizedListView.Footer>
                </controls:VirtualizedListView>
            </PivotItem>
            <PivotItem Header="专辑">
                <controls:VirtualizedListView ItemsSource="{x:Bind ViewModel.Albums}" ItemTemplate="{StaticResource SearchAlbumTemplate}" IsItemClickEnabled="True" ItemClick="OnAlbumClick" SelectionMode="None"
                    controls:AutoPaging.Command="{x:Bind ViewModel.LoadMoreCommand}"
                    controls:AutoPaging.HasMore="{x:Bind ViewModel.HasMore, Mode=OneWay}">
                    <controls:VirtualizedListView.Footer>
                        <controls:PagingEndNote
                            RetryCommand="{x:Bind ViewModel.LoadMoreCommand}"
                            ShowEnd="{x:Bind ViewModel.ShowEnd, Mode=OneWay}"
                            ShowRetry="{x:Bind ViewModel.ShowRetry, Mode=OneWay}" />
                    </controls:VirtualizedListView.Footer>
                </controls:VirtualizedListView>
            </PivotItem>
            <PivotItem Header="歌手">
                <controls:VirtualizedListView ItemsSource="{x:Bind ViewModel.Artists}" ItemTemplate="{StaticResource SearchArtistTemplate}" IsItemClickEnabled="True" ItemClick="OnArtistClick" SelectionMode="None"
                    controls:AutoPaging.Command="{x:Bind ViewModel.LoadMoreCommand}"
                    controls:AutoPaging.HasMore="{x:Bind ViewModel.HasMore, Mode=OneWay}">
                    <controls:VirtualizedListView.Footer>
                        <controls:PagingEndNote
                            RetryCommand="{x:Bind ViewModel.LoadMoreCommand}"
                            ShowEnd="{x:Bind ViewModel.ShowEnd, Mode=OneWay}"
                            ShowRetry="{x:Bind ViewModel.ShowRetry, Mode=OneWay}" />
                    </controls:VirtualizedListView.Footer>
                </controls:VirtualizedListView>
            </PivotItem>
        </Pivot>
        <Grid Grid.Row="2" Style="{StaticResource BodianPageFooter}">
            <ProgressRing Style="{StaticResource BodianPageBusyRing}" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
