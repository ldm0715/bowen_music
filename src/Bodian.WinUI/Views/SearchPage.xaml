<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls">

    <!--
        搜索页**没有自己的搜索框**：输入在内容区顶部那个常驻的框里（外壳提供），
        提交之后才切到这一页。两处各放一个框会出现「框里是 A、结果是 B」。
    -->
    <Grid Style="{StaticResource BodianPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="搜索" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <controls:TrackListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Results}"
            TrackInvoked="OnTrackInvoked" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressRing
                Grid.Column="0"
                Style="{StaticResource BodianPageBusyRing}"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.LoadMoreCommand}"
                Content="加载更多"
                Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
