<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Bodian.WinUI.Converters"
    xmlns:local="using:Bodian.WinUI"
    xmlns:models="using:Bodian.Core.Models">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="KeywordBox"
                Grid.Column="0"
                KeyDown="OnKeywordKeyDown"
                PlaceholderText="搜索歌曲、歌手"
                Text="{x:Bind ViewModel.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.SearchCommand}"
                Content="搜索"
                Style="{StaticResource AccentButtonStyle}" />

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <!-- 头像：老凭据文件里没有它，那时这里是一块空底色，不占额外空间 -->
                <Border
                    Width="28"
                    Height="28"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="14">
                    <Image Source="{x:Bind ViewModel.Avatar}" Stretch="UniformToFill" />
                </Border>

                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.AccountText}"
                    TextTrimming="CharacterEllipsis" />

                <!-- 会员徽标只是展示：播放权限一律以服务端 checkRight 为准 -->
                <Border
                    Padding="6,1"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                    CornerRadius="4"
                    Visibility="{x:Bind ViewModel.IsVip, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="11" Text="VIP" />
                </Border>
            </StackPanel>

            <Button
                Grid.Column="3"
                Command="{x:Bind ViewModel.SignOutCommand}"
                Content="退出登录"
                ToolTipService.ToolTip="清除本机保存的会话，回到扫码登录" />
        </Grid>

        <ListView
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemsSource="{x:Bind ViewModel.Results}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid Padding="8,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 封面。没有封面时留一块底色，行高不跳。 -->
                        <Border
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="4">
                            <Image Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Stretch="UniformToFill" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />

                                <!-- 付费标识：让用户在点之前就知道要不要会员 -->
                                <Border
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                    CornerRadius="3"
                                    Padding="5,0"
                                    Visibility="{x:Bind local:Formats.PayLabelVisibility(RequiresVip, RequiresPurchase)}">
                                    <TextBlock
                                        FontSize="11"
                                        Text="{x:Bind local:Formats.PayLabel(RequiresVip, RequiresPurchase)}" />
                                </Border>
                            </StackPanel>

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ArtistText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind AlbumName}"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="200" />

                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind local:Formats.Quality(AvailableQualities)}" />

                        <TextBlock
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind local:Formats.Duration(Duration)}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.LoadMoreCommand}"
                Content="加载更多"
                Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
