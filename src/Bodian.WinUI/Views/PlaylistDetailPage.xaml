<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI">

    <Grid Style="{StaticResource BodianPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── 头部：封面 + 名字 + 副标题 + 创建者 + 操作 ──────────────────
             与专辑详情页同构。两处会一起改，别只改一边。 -->
        <Grid
            Grid.Row="0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <!-- 右上角那颗「更多」的位置。Auto：没有它时宽度为 0，不占地方。 -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 封面与右侧信息块都垂直居中，理由同专辑页：只让一边居中的话，
                 信息块一高封面就被吊在上边，和下面的按钮拉开一大截。 -->
            <Border
                Grid.Column="0"
                Width="{StaticResource SizeCoverGrid}"
                Height="{StaticResource SizeCoverGrid}"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="{StaticResource RadiusMd}">
                <Image Source="{x:Bind local:Formats.CoverSource(ViewModel.CoverImage), Mode=OneWay}" Stretch="UniformToFill" />
            </Border>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="8">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <!-- 副标题：177 首 · 565w7+ 播放 · 2.1w 收藏。详情没回来时整个不显示。 -->
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind local:Formats.Visible(ViewModel.HasMeta), Mode=OneWay}" />

                <!--
                    状态行：只在副标题为空（详情没拿到）时出现。
                    它承担「加载失败：…」与「这个歌单里还没有歌」，那两条没有别的出口；
                    详情正常时不显示是因为副标题里已经有曲目数了，两个「177 首」是重复。
                -->
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind local:Formats.Visible(ViewModel.ShowStatusText), Mode=OneWay}" />

                <!--
                    创建者。**不可点是故意的** —— 本项目没有用户主页，做成可点的按钮会点出个死路。
                    自己的歌单不显示这一行（HasCreator 里已经排除了）。
                -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind local:Formats.Visible(ViewModel.HasCreator), Mode=OneWay}">
                    <PersonPicture
                        Width="28"
                        Height="28"
                        DisplayName="{x:Bind ViewModel.CreatorName, Mode=OneWay}"
                        ProfilePicture="{x:Bind local:Formats.CoverSource(ViewModel.CreatorCover), Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.CreatorName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Margin="0,2,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        AutomationProperties.Name="播放全部"
                        Command="{x:Bind ViewModel.PlayAllCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock Text="播放全部" />
                        </StackPanel>
                    </Button>

                    <!--
                        收藏按钮**只对别人的歌单出现**：收藏自己创建的歌单没有意义，
                        挂在那儿只是给人误点的机会。可见性走 CanCollect。
                        取消收藏要**先弹确认框**，所以用 Click 而不是 Command ——
                        弹窗是界面决策，XamlRoot 也拿不到 ViewModel 里去（同 RecentPage 的清空记录）。
                    -->
                    <Button
                        AutomationProperties.Name="收藏"
                        Click="OnCollectClick"
                        Visibility="{x:Bind local:Formats.Visible(ViewModel.CanCollect), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                FontSize="14"
                                Glyph="{x:Bind local:Formats.CollectGlyph(ViewModel.IsCollected), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind local:Formats.CollectLabel(ViewModel.IsCollected), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button
                        AutomationProperties.Name="分享"
                        Command="{x:Bind ViewModel.ShareCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE72D;" />
                            <TextBlock Text="分享" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </StackPanel>

            <!--
                右上角的「更多」。**只在自己创建的歌单上出现** —— 菜单里两项（编辑、删除）
                只对自己的歌单成立，摆在别人的歌单上是误导；可见性走 IsOwnPlaylist，
                正好是收藏按钮 CanCollect 的反面。

                ★ 刻意做得不显眼：一颗 ⋯ 图标、透明底、无边框，压在页头右上角。
                  它跟「播放全部 / 收藏 / 分享」不是一类东西 —— 那三个是这一页的主要动作，
                  它是低频且带破坏性的管理入口，摆在按钮排里会诱导误点。
            -->
            <Button
                Grid.Column="2"
                Width="32"
                Height="32"
                MinWidth="0"
                MinHeight="0"
                Padding="0"
                VerticalAlignment="Top"
                AutomationProperties.Name="更多"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="{StaticResource RadiusSm}"
                ToolTipService.ToolTip="更多"
                Visibility="{x:Bind local:Formats.Visible(ViewModel.IsOwnPlaylist), Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE712;" />

                <Button.Flyout>
                    <!--
                        ★ **右对齐展开**，不是默认的 Bottom：这颗按钮贴在右上角，
                          默认摆放会让菜单从它的左边缘往右铺，直接顶出窗口右边。
                        ★ 宽度也收一下：presenter 模板里的 MinWidth 是按「最宽的菜单项」
                          算的（给二级菜单对齐用），这里只有两项短文案，用不上。
                    -->
                    <MenuFlyout
                        Placement="BottomEdgeAlignedRight"
                        ShouldConstrainToRootBounds="True">
                        <MenuFlyout.MenuFlyoutPresenterStyle>
                            <Style TargetType="MenuFlyoutPresenter">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MaxWidth" Value="200" />

                                <!--
                                    背景用与其它弹出菜单同一个画刷 —— 曲目行那颗「更多」就是这么写的。
                                    MenuFlyout 的默认背景是系统那套半透明亚克力，在这个外壳里显得太透，
                                    与项目里其余弹层也不是一个观感。
                                -->
                                <Setter Property="Background" Value="{ThemeResource ThemeFlyoutBackground}" />
                                <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                            </Style>
                        </MenuFlyout.MenuFlyoutPresenterStyle>

                        <MenuFlyoutItem Click="OnEditPlaylistClick" Text="编辑">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem Click="OnDeletePlaylistClick" Text="删除">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!--
            ── 简介 ───────────────────────────────────────────────────────
            折叠起来：实测这份文案可能很长（整篇企划文案），摊开会把曲目列表顶到屏幕外。
        -->
        <Expander
            Grid.Row="1"
            Margin="0,16,0,0"
            HorizontalAlignment="Stretch"
            Header="歌单简介"
            Visibility="{x:Bind local:Formats.Visible(ViewModel.HasDescription), Mode=OneWay}">
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Expander>

        <!-- RemovablePlaylistId 只在自建歌单上非 0（归属是异步算出来的，所以用 OneWay）。 -->
        <controls:TrackListToolbar
            Grid.Row="2"
            Margin="0,16,0,8"
            ReloadCommand="{x:Bind ViewModel.ReloadCommand}"
            RemovablePlaylistId="{x:Bind ViewModel.RemovablePlaylistId, Mode=OneWay}"
            Target="{x:Bind PlaylistTracksList}" />

        <controls:TrackListView
            x:Name="PlaylistTracksList"
            Grid.Row="3"
            HasMore="{x:Bind ViewModel.HasMore, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Tracks}"
            LoadMoreCommand="{x:Bind ViewModel.LoadMoreCommand}"
            TrackInvoked="OnTrackInvoked">
            <controls:TrackListView.Footer>
                <controls:PagingEndNote
                    RetryCommand="{x:Bind ViewModel.LoadMoreCommand}"
                    ShowEnd="{x:Bind ViewModel.ShowEnd, Mode=OneWay}"
                    ShowRetry="{x:Bind ViewModel.ShowRetry, Mode=OneWay}" />
            </controls:TrackListView.Footer>
        </controls:TrackListView>

        <!-- 页脚只剩进度环：刷新入口已经挪到上面的工具栏，「重新加载」按钮删掉了。 -->
        <ProgressRing
            Grid.Row="4"
            Style="{StaticResource BodianPageBusyRing}"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>
</Page>
