<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Bodian.WinUI.Views.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    xmlns:models="using:Bodian.Core.Models">
    <Grid Style="{StaticResource BodianTrackPageRoot}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Image Source="{x:Bind local:Formats.CoverSource(ViewModel.Artist.CoverImage)}" Width="88" Height="88" Stretch="UniformToFill" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{x:Bind ViewModel.Artist.Name}" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="{x:Bind ViewModel.Artist.Summary}" /></StackPanel>
            <Button Grid.Column="2" Content="返回" Click="OnBackClick" VerticalAlignment="Top" />
        </Grid>
        <Pivot Grid.Row="1" SelectionChanged="OnSelectionChanged">
            <PivotItem Header="歌曲">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.Tracks.StatusText, Mode=OneWay}" Margin="0,8" />
                    <controls:TrackListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Tracks.Items}" TrackInvoked="OnTrackInvoked" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"><ProgressRing IsActive="{x:Bind ViewModel.Tracks.IsBusy, Mode=OneWay}" Style="{StaticResource BodianPageBusyRing}" /><Button Content="重新加载" Command="{x:Bind ViewModel.Tracks.ReloadCommand}" /><Button Content="加载更多" Command="{x:Bind ViewModel.Tracks.LoadMoreCommand}" Visibility="{x:Bind ViewModel.Tracks.HasMore, Mode=OneWay}" /></StackPanel>
                </Grid>
            </PivotItem>
            <PivotItem Header="专辑">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.Albums.StatusText, Mode=OneWay}" Margin="0,8" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Albums.Items}" IsItemClickEnabled="True" ItemClick="OnAlbumClick" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate x:DataType="models:Album"><StackPanel Orientation="Horizontal" Spacing="16" Padding="4,8"><Image Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Width="64" Height="64" Stretch="UniformToFill" /><StackPanel VerticalAlignment="Center"><TextBlock Text="{x:Bind Name}" /><TextBlock Text="{x:Bind ReleaseDate}" /></StackPanel></StackPanel></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"><ProgressRing IsActive="{x:Bind ViewModel.Albums.IsBusy, Mode=OneWay}" Style="{StaticResource BodianPageBusyRing}" /><Button Content="重新加载" Command="{x:Bind ViewModel.Albums.ReloadCommand}" /><Button Content="加载更多" Command="{x:Bind ViewModel.Albums.LoadMoreCommand}" Visibility="{x:Bind ViewModel.Albums.HasMore, Mode=OneWay}" /></StackPanel>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
