<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    xmlns:models="using:Bodian.Core.Models">

    <!--
        「专辑」页签是一格一张封面的卡片网格，与乐库分类页的专辑网格同形
        （GridView + 132 封面 + AutoPaging + PagingEndNote 挂在 GridView.Footer 上）。
    -->
    <Grid Style="{StaticResource BodianPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 头部：头像 + 名字 + 别名 + 计数 + 关注 ────────────────────── -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,16"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                PersonPicture 自带圆形裁剪与姓名首字占位，不必手写 Ellipse 蒙版。
                详情没回来之前头像用的是导航带过来的那张，所以不需要占位骨架。
            -->
            <PersonPicture
                Width="96"
                Height="96"
                VerticalAlignment="Top"
                DisplayName="{x:Bind ViewModel.Artist.Name, Mode=OneWay}"
                ProfilePicture="{x:Bind local:Formats.CoverSource(ViewModel.Artist.CoverImage), Mode=OneWay}" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Artist.Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <!-- 别名紧跟本名，底边对齐；没有别名时整块不显示 -->
                    <TextBlock
                        Margin="0,0,0,4"
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Artist.AliasName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind local:Formats.Visible(ViewModel.Artist.HasAlias), Mode=OneWay}" />
                </StackPanel>

                <!-- 粉丝 · 单曲 · 专辑；一个计数都没有时整行不显示 -->
                <TextBlock
                    Style="{StaticResource BodianPageStatus}"
                    Text="{x:Bind local:Formats.ArtistMeta(ViewModel.Artist), Mode=OneWay}"
                    Visibility="{x:Bind local:Formats.ArtistMetaVisibility(ViewModel.Artist), Mode=OneWay}" />

                <!--
                    关注与分享并排。

                    关注是两态：未关注显示「关注」，已关注显示「已关注」，图标也跟着换。
                    取关要**先弹确认框**，所以用 Click 而不是 Command —— 弹窗是界面决策，
                    XamlRoot 也拿不到 ViewModel 里去（见 code-behind 的 OnFollowClick）。
                    分享只复制本地拼的链接，不发请求，见 Share。

                    圆角取 ControlCornerRadius —— 与侧栏选中、页签条同一档。
                    不要用 RadiusPill(999)：全圆角配这种矮按钮会拉成细长椭圆。
                    MinWidth=0 是顺带把 Button 默认的 120 最小宽度去掉，让宽度贴合内容。
                -->
                <StackPanel
                    Margin="0,2,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        AutomationProperties.Name="关注"
                        Click="OnFollowClick"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        MinWidth="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:Icon Size="14"
                                Data="{x:Bind local:Formats.FollowIcon(ViewModel.IsFollowed), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind local:Formats.FollowLabel(ViewModel.IsFollowed), Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- 图标与播放条的分享按钮同一个（E72D） -->
                    <Button
                        AutomationProperties.Name="分享"
                        Command="{x:Bind ViewModel.ShareCommand}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        MinWidth="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:Icon Size="14" Data="{StaticResource IconShare}" />
                            <TextBlock Text="分享" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <controls:PillTabBar
            Grid.Row="1"
            Margin="0,0,0,12"
            ItemsSource="{x:Bind ViewModel.Tabs}"
            SelectedIndex="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}" />

        <!-- ── 歌曲 ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Visibility="{x:Bind local:Formats.Visible(ViewModel.IsSongsTab), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 曲目数在工具栏左侧，不再占上面一整行 -->
            <controls:TrackListToolbar
                Grid.Row="0"
                Margin="0,0,0,8"
                ReloadCommand="{x:Bind ViewModel.Tracks.ReloadCommand}"
                SummaryText="{x:Bind ViewModel.Tracks.StatusText, Mode=OneWay}"
                Target="{x:Bind ArtistTracksList}" />

            <controls:TrackListView
                x:Name="ArtistTracksList"
                Grid.Row="1"
                HasMore="{x:Bind ViewModel.Tracks.HasMore, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Tracks.Items}"
                LoadMoreCommand="{x:Bind ViewModel.Tracks.LoadMoreCommand}"
                TrackInvoked="OnTrackInvoked">
                <controls:TrackListView.Footer>
                    <controls:PagingEndNote
                        RetryCommand="{x:Bind ViewModel.Tracks.LoadMoreCommand}"
                        ShowEnd="{x:Bind ViewModel.Tracks.ShowEnd, Mode=OneWay}"
                        ShowRetry="{x:Bind ViewModel.Tracks.ShowRetry, Mode=OneWay}" />
                </controls:TrackListView.Footer>
            </controls:TrackListView>

            <ProgressRing
                Grid.Row="2"
                IsActive="{x:Bind ViewModel.Tracks.IsBusy, Mode=OneWay}"
                Style="{StaticResource BodianPageBusyRing}" />
        </Grid>

        <!-- ── 专辑（卡片网格）───────────────────────────────────────────── -->
        <Grid Grid.Row="2" Visibility="{x:Bind local:Formats.Visible(ViewModel.IsAlbumsTab), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 左计数、右刷新，与歌曲页签那条工具栏同一套排法 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    缩进 8 是为了和卡片左对齐：GridViewItem 的 Padding 是 8，
                    卡片实际从底色内边距之后开始。
                -->
                <TextBlock
                    Grid.Column="0"
                    Margin="8,0,0,0"
                    Style="{StaticResource BodianPageStatusStrong}"
                    Text="{x:Bind ViewModel.Albums.StatusText, Mode=OneWay}" />

                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="重新加载"
                    Command="{x:Bind ViewModel.Albums.ReloadCommand}"
                    Style="{StaticResource BodianIconButton}"
                    ToolTipService.ToolTip="重新加载">
                    <controls:Icon Size="16" Data="{StaticResource IconRefresh}" />
                </Button>
            </Grid>

            <!--
                卡片网格：一格一张封面。

                ★ 单元格宽度由代码按可用宽度等分（UpdateAlbumCardMetrics），不是写死的 132 ——
                  写死的话右边必然剩一条不足一格的空档，窗口越宽空得越多。

                ★ 封面尺寸不绑任何东西：卡片是两行的 Grid，封面在 `*` 行里撑满，
                  文字区固定 SizeAlbumCardText 高。ItemHeight 由代码按
                  「卡片宽 + 文字区 + 行距」算出来，封面那行剩下的正好等于卡片宽 ——
                  正方形是算出来的，不是绑出来的。
                  （★ 别改成把封面的宽高绑到父元素的 ActualWidth：父元素的宽度会反过来依赖
                    子元素，成为循环，实测两边都算成 0，封面直接不见。）

                ★ ItemHeight 必须够高：ItemsWrapGrid 给所有条目用同一个高度，
                  由第一个实现的条目定下来。长标题撑到两行时超出就会被裁掉 ——
                  「时间显示不出来」就是这么来的。所以标题占位固定两行高（MinHeight），
                  文字区高度也固定，让每张卡片一样高。
            -->
            <GridView
                x:Name="AlbumGrid"
                Grid.Row="1"
                IsItemClickEnabled="True"
                ItemClick="OnAlbumClick"
                ItemsSource="{x:Bind ViewModel.Albums.Items}"
                Loaded="OnAlbumGridLoaded"
                SelectionMode="None"
                SizeChanged="OnAlbumGridSizeChanged"
                Unloaded="OnAlbumGridUnloaded"
                controls:AutoPaging.Command="{x:Bind ViewModel.Albums.LoadMoreCommand}"
                controls:AutoPaging.HasMore="{x:Bind ViewModel.Albums.HasMore, Mode=OneWay}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!--
                            ★★ CacheLength 必须写 0.5，两处都不能省：

                            1. WinUI 的默认值是 4 —— 提前实现四个视口的内容。对一屏装不下的
                               长列表这没问题，但 28 张卡片只有 5 行，四个视口足够把**全部 28 个
                               容器**都实现；而自动翻页挂在「末尾容器被实现」上（见 AutoPaging.cs），
                               于是刚进页面就多拉一页。

                            （早先这里把「28 张显示成 56 张」记在预取上，其实根因是歌手专辑
                              接口的页码是 1 基、我们按 0 基发了请求 —— 见 PagingConvention 的说明。
                              这一行仍然要留：短列表没有下一页时，它挡掉的就是一次白拉的请求。）
                            2. 项目里每一处手写的 ItemsPanel 都写着这一行（TrackListView、
                               SongCommentsPanel、HomeSectionView、BangListPage），
                              共享的 VirtualizedListView 也把面板强制成 0.5 的那份。
                               换控件时漏抄这一行，就等于悄悄换掉了预取策略。

                            ★ ItemWidth/ItemHeight 也要给初值：留空时面板按**第一个条目量出来的
                              大小**排所有格子，而卡片在尺寸算出来之前量出来只有文字那么高
                              （封面那行是 `*`，没有确定高度就塌成 0），几十张会被判成「一屏塞得下」，
                              同样会把末尾容器实现掉。真实尺寸随后由 UpdateAlbumCardMetrics 修正。
                        -->
                        <ItemsWrapGrid
                            CacheLength="0.5"
                            ItemHeight="254"
                            ItemWidth="160"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />

                        <!--
                            ★ 悬停/选中底色（GridViewItemBackgroundPointerOver）铺满容器，
                              而卡片是容器去掉 Padding 之后的那一块 —— 所以 Padding 就是
                              「底色比卡片大多少」。8 是四周各让出 8。
                            ★ Padding 必须四周相等，卡片才会在底色里居中。
                              早先图省事把间距写成卡片自己的外边距，卡片被挤到左边、底色右边空一截，
                              看着就是「卡片贴在背景左边」。
                        -->
                        <Setter Property="Padding" Value="8" />

                        <!-- 底色与底色之间的缝隙。卡片之间的实际间隔是它加上两侧的 Padding -->
                        <Setter Property="Margin" Value="0,0,4,4" />
                        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:Album">
                        <Grid
                            x:Name="CardRoot"
                            RowSpacing="10"
                            VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <!-- 封面撑满剩下的高度，剩下的正好等于卡片宽 -->
                                <RowDefinition Height="*" />
                                <!-- 文字区固定高，封面那行才会恰好是正方形 -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="{StaticResource RadiusMd}">
                                <Grid>
                                    <Image Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Stretch="UniformToFill" />

                                    <!-- 右下角的曲目数角标。压在图上，用 MediaOverlay 那一对色 -->
                                    <Border
                                        Margin="0,0,8,8"
                                        Padding="7,1,7,2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource MediaOverlayBackgroundBrush}"
                                        CornerRadius="{StaticResource RadiusSm}"
                                        Visibility="{x:Bind local:Formats.HasTracks(MusicCount)}">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource MediaOverlayForegroundBrush}"
                                            Text="{x:Bind local:Formats.AlbumCount(MusicCount)}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel
                                Grid.Row="1"
                                Height="{StaticResource SizeAlbumCardText}"
                                Spacing="4">
                                <!--
                                    ★ 不要给标题设 MinHeight。
                                      设了就是把标题框死两行高，一行标题的卡片里，
                                      发行时间会被推到两行之后 —— 标题和时间之间空出一大截。
                                      现在标题多高就多高，发行时间紧跟其后。
                                      代价是各卡片的发行时间不在同一水平线上 —— 这是有意的：
                                      为了对齐而把时间和标题拆开，比对不齐更难接受。
                                -->
                                <TextBlock
                                    MaxLines="2"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ReleaseDate}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
                <GridView.Footer>
                    <controls:PagingEndNote
                        RetryCommand="{x:Bind ViewModel.Albums.LoadMoreCommand}"
                        ShowEnd="{x:Bind ViewModel.Albums.ShowEnd, Mode=OneWay}"
                        ShowRetry="{x:Bind ViewModel.Albums.ShowRetry, Mode=OneWay}" />
                </GridView.Footer>
            </GridView>

            <!-- 刷新入口在计数那行的右端，这里只剩转圈（与其余页的页脚同形） -->
            <ProgressRing
                Grid.Row="2"
                Style="{StaticResource BodianPageBusyRing}"
                IsActive="{x:Bind ViewModel.Albums.IsBusy, Mode=OneWay}" />
        </Grid>

        <!-- ── 介绍 ─────────────────────────────────────────────────────── -->
        <!-- 实测这份文案是整篇人物生平（周杰伦那条 12466 字符），必须单独滚动 -->
        <ScrollViewer
            Grid.Row="2"
            Padding="0,0,24,0"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind local:Formats.Visible(ViewModel.IsIntroTab), Mode=OneWay}">
            <TextBlock
                Margin="0,0,0,16"
                Text="{x:Bind ViewModel.Artist.Description, Mode=OneWay}"
                TextWrapping="Wrap" />
        </ScrollViewer>
    </Grid>
</Page>
