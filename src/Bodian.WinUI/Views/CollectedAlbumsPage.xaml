<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.CollectedAlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls">

    <Grid Style="{StaticResource BodianPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="收藏的专辑" />

                <!--
                    这段文案会把「没有收藏」和「查询没成功」两种可能都说出来，见 ViewModel。
                    样式与工具栏那格统一：它也是「这里有几条」那类信息，小字淡灰会和
                    其余列表页的数字对不上。长文案靠 Wrap 换行，不靠省略号。
                -->
                <TextBlock
                    Style="{StaticResource BodianPageStatusStrong}"
                    Text="{x:Bind ViewModel.Albums.StatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- 刷新入口在标题右侧，与歌手页专辑页签同一套排法 -->
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.Name="重新加载"
                Command="{x:Bind ViewModel.Albums.ReloadCommand}"
                Style="{StaticResource BodianIconButton}"
                ToolTipService.ToolTip="重新加载">
                <controls:Icon Size="16" Data="{StaticResource IconRefresh}" />
            </Button>
        </Grid>

        <controls:AlbumListView
            Grid.Row="1"
            AlbumInvoked="OnAlbumInvoked"
            HasMore="{x:Bind ViewModel.Albums.HasMore, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Albums.Items}"
            LoadMoreCommand="{x:Bind ViewModel.Albums.LoadMoreCommand}">
            <controls:AlbumListView.Footer>
                <controls:PagingEndNote
                    RetryCommand="{x:Bind ViewModel.Albums.LoadMoreCommand}"
                    ShowEnd="{x:Bind ViewModel.Albums.ShowEnd, Mode=OneWay}"
                    ShowRetry="{x:Bind ViewModel.Albums.ShowRetry, Mode=OneWay}" />
            </controls:AlbumListView.Footer>
        </controls:AlbumListView>

        <!-- 刷新入口在标题右侧，这里只剩转圈（与其余页的页脚同形） -->
        <ProgressRing
            Grid.Row="2"
            Style="{StaticResource BodianPageBusyRing}"
            IsActive="{x:Bind ViewModel.Albums.IsBusy, Mode=OneWay}" />
    </Grid>
</Page>
