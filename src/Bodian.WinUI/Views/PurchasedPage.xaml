<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bodian.WinUI.Views.PurchasedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls">

    <!--
        上下两节：已购单曲 / 已购专辑。两个列表等高、各自滚动。

        ★ 不做成页签：页签要维护一套选中状态，而这种「两节都不长」的内容并排放着更省事，
          用户也不用先点一下才知道另一边有什么。

        ★ 每节自己的末尾提示（「没有更多了哦~」/ 失败重试）挂在各自列表的 Footer 上，
          跟着那一节的列表滚 —— 两节的翻页状态本来就是分开的。
    -->
    <Grid Style="{StaticResource BodianTrackPageRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="已购音乐" />

        <!-- ── 已购单曲 ─────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="单曲" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Singles.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <controls:TrackListView
            Grid.Row="2"
            HasMore="{x:Bind ViewModel.Singles.HasMore, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Singles.Items}"
            LoadMoreCommand="{x:Bind ViewModel.Singles.LoadMoreCommand}"
            TrackInvoked="OnTrackInvoked">
            <controls:TrackListView.Footer>
                <controls:PagingEndNote
                    RetryCommand="{x:Bind ViewModel.Singles.LoadMoreCommand}"
                    ShowEnd="{x:Bind ViewModel.Singles.ShowEnd, Mode=OneWay}"
                    ShowRetry="{x:Bind ViewModel.Singles.ShowRetry, Mode=OneWay}" />
            </controls:TrackListView.Footer>
        </controls:TrackListView>

        <!-- ── 已购专辑 ─────────────────────────────────────────────────── -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Spacing="10">
            <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="专辑" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Albums.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <controls:AlbumListView
            Grid.Row="4"
            AlbumInvoked="OnAlbumInvoked"
            HasMore="{x:Bind ViewModel.Albums.HasMore, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.Albums.Items}"
            LoadMoreCommand="{x:Bind ViewModel.Albums.LoadMoreCommand}">
            <controls:AlbumListView.Footer>
                <controls:PagingEndNote
                    RetryCommand="{x:Bind ViewModel.Albums.LoadMoreCommand}"
                    ShowEnd="{x:Bind ViewModel.Albums.ShowEnd, Mode=OneWay}"
                    ShowRetry="{x:Bind ViewModel.Albums.ShowRetry, Mode=OneWay}" />
            </controls:AlbumListView.Footer>
        </controls:AlbumListView>
    </Grid>
</Page>
