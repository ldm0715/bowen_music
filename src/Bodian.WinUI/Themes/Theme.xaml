<?xml version="1.0" encoding="utf-8"?>
<!--
    浅色 / 深色 / 高对比度三套颜色。

    ★ 为什么三套内联在一个文件里，而不是用
        <ResourceDictionary x:Key="Light" Source="ms-appx:///Themes/Colors.Light.xaml" />
      引外部文件：
      那种写法能编译、能启动，但运行期做主题查找时会遮蔽掉系统的那份主题字典 ——
      我们没覆盖的键（例如 NavigationViewDefaultPaneBackground）会落空并退化成默认值。
      表现是「切成深色后侧栏一片白、导航项不可见、其他控件样式丢失」。
      实测踩过，别再改回去。

    覆盖的是系统已有的键，靠的是合并顺序「后合并的优先」（见 App.xaml）。
    只定义了我们真正要改的那些键，其余一律交给系统。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ══ 浅色 ══════════════════════════════════════════════════════════ -->
        <!--
            #00F3B0 对白底的对比度只有 1.45:1，当文字色完全不可读，所以强调色拆成两条轨道：
              - 填充轨道：色块 / 徽标 / 进度条 / 按钮底，上面配近黑青
              - 文字轨道：浅底上的文字与图标，压暗到 5.13:1，过 WCAG AA
        -->
        <ResourceDictionary x:Key="Light">

            <!-- 评论抽屉、回复详情与原图查看：实色背景保证文字可读。 -->
            <SolidColorBrush x:Key="CommentPanelBackgroundBrush" Color="#FFFAFBFD" />
            <SolidColorBrush x:Key="CommentRaisedSurfaceBrush" Color="#FFF0F3F7" />
            <SolidColorBrush x:Key="CommentBorderBrush" Color="#FFD1D9E6" />
            <SolidColorBrush x:Key="CommentSeparatorBrush" Color="#FFE1E6EF" />
            <SolidColorBrush x:Key="CommentPrimaryTextBrush" Color="#FF18212F" />
            <SolidColorBrush x:Key="CommentSecondaryTextBrush" Color="#FF4E5B6F" />
            <SolidColorBrush x:Key="CommentTertiaryTextBrush" Color="#FF637086" />
            <SolidColorBrush x:Key="CommentAuthorTextBrush" Color="#FF34445B" />
            <SolidColorBrush x:Key="CommentAccentBrush" Color="#FF007A57" />
            <SolidColorBrush x:Key="CommentErrorBrush" Color="#FFAA3030" />
            <SolidColorBrush x:Key="CommentPlaceholderBrush" Color="#FF68778D" />
            <SolidColorBrush x:Key="CommentImageBackgroundBrush" Color="#FFF6F8FC" />
            <SolidColorBrush x:Key="CommentEditorBorderBrush" Color="#FFB7C2D3" />

            <Color x:Key="BrandAccent">#FF00F3B0</Color>
            <Color x:Key="BrandAccentOnSurface">#FF007A57</Color>
            <Color x:Key="BrandOnAccent">#FF002019</Color>

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF00F3B0" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF00D9A0" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF00BE8C" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#4D00F3B0" />
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#3300F3B0" />
            <SolidColorBrush x:Key="AccentFillColorDisabled" Color="#4D00F3B0" />

            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF007A57" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF006B4C" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#99007A57" />
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#66007A57" />
            <SolidColorBrush x:Key="AccentTextFillColorDisabled" Color="#66007A57" />

            <!-- 强调填充之上的前景：近黑青，11.83:1。系统浅色下这个键是 #FFFFFF，压在薄荷绿上只有 1.45:1 -->
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF002019" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3002019" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#66002019" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FF002019" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDefaultBrush" Color="#FF002019" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabled" Color="#66002019" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF00F3B0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF00D9A0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF00BE8C" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#4D00F3B0" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF002019" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF002019" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#B3002019" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#66002019" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="Transparent" />

            <!-- 付费徽标直接读它（PlayerBar.xaml:89、TrackListView.xaml:57）。默认是 SystemAccentColorLight2 -->
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF00F3B0" />

            <Color x:Key="SystemAccentColor">#FF00F3B0</Color>

            <!-- 界面底色。参照物是 #FAFAFA（系统默认 #F3F3F3） -->
            <Color x:Key="SolidBackgroundFillColorBase">#FFFAFAFA</Color>
            <Color x:Key="SolidBackgroundFillColorSecondary">#FFF0F0F0</Color>
            <Color x:Key="SolidBackgroundFillColorTertiary">#FFFFFFFF</Color>

            <!--
                ★ 窗口底色，由 MainWindow 铺在 NavigationView 下面。

                为什么必须自己铺、不能靠系统：
                  NavigationViewDefaultPaneBackground 是 AcrylicBrush（要采样背板），
                  NavigationViewContentBackground 是半透明层刷（浅色 #80FFFFFF / 深色 #4C3A3A3A），
                  两者都设计成叠在 Mica 之上。本应用不设背板（氛围渐变才是背景），
                  没有东西可叠时：浅色下 #80FFFFFF 叠在浅色桌面上碰巧像白，
                  深色下 #4C3A3A3A 叠在浅色桌面上变成灰、亚克力退回浅色 ——
                  表现就是「深色模式侧栏一片白、导航项白字压白底看不见」。
            -->
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFAFAFA" />

            <!-- 浅色用清晰的彩色光晕；局部衰减保留文字区域的明暗层次 -->
            <x:Double x:Key="AmbientOpacity">0.55</x:Double>

            <!--
                ★ 侧栏与内容区一律**全透明**，让氛围渐变连续地流过去。

                曾经给侧栏叠过一层极淡的底做「分层」，结果是渐变被切成两块、中间一条硬边 ——
                在连续渐变上叠平色，边界一定看得出来。

                参考项目那种毛玻璃分层能成立，是因为它**真的采样背后的模糊**；
                这里没有背板可采样，叠上去就只是一块平色。所以不做。

                数值直接写，**不要用 <StaticResource ResourceKey="..."/> 别名** ——
                主题字典里的 StaticResource 解析时机不可靠（实测：别名没生效，
                面板退回了系统的亚克力刷，整块侧栏变成不透明的灰板）。
            -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />

            <!-- ── 侧栏导航项状态色 ──
                 选中用底色表示（不用边框、不用左侧竖条，竖条已在 Tokens.xaml 里设 0）。
                 数值对应参照物的 black/5（hover）与 black/10（选中）。 -->
            <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0D000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#14000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#1A000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#24000000" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#2E000000" />

            <!-- 未选中是次级文字色，选中/hover 提到主文字色 —— 这是参照物层级感的来源 -->
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#9E000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#E4000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#9E000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#E4000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#E4000000" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#9E000000" />

            <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#73000000" />

            <!-- ── 曲目行的悬停底色 ──
                 与导航项用同一套数值，两种列表的悬停反馈保持一致。
                 选中态不在这里：曲目列表是 SelectionMode=None，高亮由 TrackRow.IsCurrent 自己画。 -->
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0D000000" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#14000000" />

            <!-- 单选主题列表仅使用背景表示选中，与侧栏使用同一套状态色。 -->
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1A000000" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#24000000" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#2E000000" />

            <!--
                ── 弹层与浮层面板的底色（主题 / 搜索 / 音质 / 登录卡片 / 各处菜单）──
                **实色**。曾经是 80% 不透明（#CC），想透出窗口的氛围背景；但那让浮层里的
                文字压在页面上发虚 —— 尤其登录卡片这种整屏面板。现在与 AppSurfaceBrush
                同色（#FAFAFA），靠外圈阴影与描边分层，不再靠透明度。
            -->
            <SolidColorBrush x:Key="ThemeFlyoutBackground" Color="#FFFAFAFA" />

            <!-- ── 压在封面图上的小角标（曲目数这类）──
                 底色不是主题无关的：它压在图片上，深浅两个主题用同一档半透明黑，
                 白字才在任何封面上都读得出来。高对比度下改跟系统配色走。 -->
            <SolidColorBrush x:Key="MediaOverlayBackgroundBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="MediaOverlayForegroundBrush" Color="#FFFFFFFF" />

            <!-- ── 发现页卡片区两侧的翻页箭头 ──
                 同样压在封面上，所以深浅两个主题用同一档半透明黑 + 白箭头。
                 ★ 不复用 SubtleButton 那几个键:那套的悬停底色只有 4~6%，
                   一悬停底就没了，白箭头压在浅色封面上会直接消失。
                 悬停/按下是「越压越实」而不是换色。 -->
            <SolidColorBrush x:Key="CardPagerButtonBackgroundBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="CardPagerButtonBackgroundPointerOverBrush" Color="#CC000000" />
            <SolidColorBrush x:Key="CardPagerButtonBackgroundPressedBrush" Color="#E6000000" />
            <SolidColorBrush x:Key="CardPagerButtonForegroundBrush" Color="#FFFFFFFF" />

            <!--
                发现页里那些歌单卡的底色。
                ★ 必须是**实色**：页面背景是一层氛围渐变，用系统的
                  CardBackgroundFillColorDefaultBrush（70% 白）会被透掉，卡片看起来根本不存在。
            -->
            <SolidColorBrush x:Key="HomeCardBackgroundBrush" Color="#FFF6F8FB" />
        </ResourceDictionary>

        <!-- ══ 深色 ══════════════════════════════════════════════════════════ -->
        <!--
            与浅色的关键差别：文字轨道直接用原色。
            #00F3B0 在 #121212 上有 12.89:1，比浅色那套压暗变体还宽裕，不需要再压暗。
            「强调填充之上的前景」两套相同，因为填充色本身没变。
        -->
        <ResourceDictionary x:Key="Dark">

            <!-- 评论抽屉、回复详情与原图查看：实色背景保证文字可读。 -->
            <SolidColorBrush x:Key="CommentPanelBackgroundBrush" Color="#FF171D29" />
            <SolidColorBrush x:Key="CommentRaisedSurfaceBrush" Color="#FF222A39" />
            <SolidColorBrush x:Key="CommentBorderBrush" Color="#FF333D50" />
            <SolidColorBrush x:Key="CommentSeparatorBrush" Color="#FF2A3242" />
            <SolidColorBrush x:Key="CommentPrimaryTextBrush" Color="#FFF1F4FA" />
            <SolidColorBrush x:Key="CommentSecondaryTextBrush" Color="#FFAFB9CC" />
            <SolidColorBrush x:Key="CommentTertiaryTextBrush" Color="#FF9EABC1" />
            <SolidColorBrush x:Key="CommentAuthorTextBrush" Color="#FFC3CDDE" />
            <SolidColorBrush x:Key="CommentAccentBrush" Color="#FF00F3B0" />
            <SolidColorBrush x:Key="CommentErrorBrush" Color="#FFE6B3AC" />
            <SolidColorBrush x:Key="CommentPlaceholderBrush" Color="#FF75849D" />
            <SolidColorBrush x:Key="CommentImageBackgroundBrush" Color="#FF111722" />
            <SolidColorBrush x:Key="CommentEditorBorderBrush" Color="#FF3D4960" />

            <Color x:Key="BrandAccent">#FF00F3B0</Color>
            <Color x:Key="BrandAccentOnSurface">#FF00F3B0</Color>
            <Color x:Key="BrandOnAccent">#FF002019</Color>

            <!-- 深色下 hover 是「提亮」而不是「压暗」，与浅色相反 -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF00F3B0" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF1AFFBF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF00D9A0" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#4D00F3B0" />
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#3300F3B0" />
            <SolidColorBrush x:Key="AccentFillColorDisabled" Color="#4D00F3B0" />

            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF00F3B0" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#B300F3B0" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#8000F3B0" />
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#6600F3B0" />
            <SolidColorBrush x:Key="AccentTextFillColorDisabled" Color="#6600F3B0" />

            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF002019" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3002019" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#66002019" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="#FF002019" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDefaultBrush" Color="#FF002019" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabled" Color="#66002019" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF00F3B0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF1AFFBF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF00D9A0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#4D00F3B0" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF002019" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF002019" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#B3002019" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#66002019" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="Transparent" />

            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF00F3B0" />

            <Color x:Key="SystemAccentColor">#FF00F3B0</Color>

            <!-- 参照物是 #121212（系统默认 #202020）。层叠方向仍是「越高越亮」 -->
            <Color x:Key="SolidBackgroundFillColorBase">#FF121212</Color>
            <Color x:Key="SolidBackgroundFillColorSecondary">#FF1C1C1C</Color>
            <Color x:Key="SolidBackgroundFillColorTertiary">#FF1C1C1C</Color>

            <!-- 窗口底色。理由见浅色一段的说明 -->
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FF121212" />

            <!-- 深色稍提高强度，让颜色保持鲜明；基底仍由 AppSurfaceBrush 控制 -->
            <x:Double x:Key="AmbientOpacity">0.62</x:Double>

            <!-- 侧栏与内容区全透明。理由见浅色一段 -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />

            <!-- 侧栏导航项状态色。深色下用白色不透明度，与浅色反相 -->
            <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#2EFFFFFF" />

            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#C5FFFFFF" />

            <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#8AFFFFFF" />

            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#14FFFFFF" />

            <!-- 单选主题列表仅使用背景表示选中，与侧栏使用同一套状态色。 -->
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#2EFFFFFF" />

            <!--
                弹层与浮层面板的底色，理由与浅色那份同（实色、不再透出氛围背景）。
                比 AppSurfaceBrush（#121212）亮一档，浮层才「浮」得起来。
            -->
            <SolidColorBrush x:Key="ThemeFlyoutBackground" Color="#FF202020" />

            <!-- 压在封面图上的小角标，与浅色同一档：它压在图片上，不跟窗口底色走。 -->
            <SolidColorBrush x:Key="MediaOverlayBackgroundBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="MediaOverlayForegroundBrush" Color="#FFFFFFFF" />

            <!-- 翻页箭头，与浅色同一档（理由见浅色那一段）。 -->
            <SolidColorBrush x:Key="CardPagerButtonBackgroundBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="CardPagerButtonBackgroundPointerOverBrush" Color="#CC000000" />
            <SolidColorBrush x:Key="CardPagerButtonBackgroundPressedBrush" Color="#E6000000" />
            <SolidColorBrush x:Key="CardPagerButtonForegroundBrush" Color="#FFFFFFFF" />

            <!-- 歌单卡底色，与浅色同一立场：页面背景是渐变，卡片得用实色才看得出是卡片。 -->
            <SolidColorBrush x:Key="HomeCardBackgroundBrush" Color="#FF232A38" />
        </ResourceDictionary>

        <!-- ══ 高对比度 ══════════════════════════════════════════════════════ -->
        <!--
            只定义自定义键，不覆盖任何系统键 —— 高对比度下要让系统的无障碍配色生效。
            品牌色映射到系统的高对比度配对色，保证前景/背景仍然成对。
            这一节必须有：缺了的话，只在主题字典里定义的自定义键在高对比度下会解析失败。
        -->
        <ResourceDictionary x:Key="HighContrast">

            <!-- 评论控件在高对比度下使用系统配色。 -->
            <SolidColorBrush x:Key="CommentPanelBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CommentRaisedSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CommentBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CommentSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CommentPrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CommentSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CommentTertiaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CommentAuthorTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CommentAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CommentErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CommentPlaceholderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CommentImageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CommentEditorBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <Color x:Key="BrandAccent">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="BrandAccentOnSurface">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="BrandOnAccent">{ThemeResource SystemColorHighlightTextColor}</Color>
            <SolidColorBrush x:Key="ThemeFlyoutBackground" Color="{ThemeResource SystemColorWindowColor}" />

            <!-- 半透明黑压在封面上时，高对比度用户设的前景/背景色可能读不出来，
                 所以这里改跟系统配色走。 -->
            <SolidColorBrush x:Key="MediaOverlayBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MediaOverlayForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <!-- 翻页箭头同此立场：三档都用系统窗口色，不靠透明度分层 ——
                 高对比度下透明度对比度不受保证，箭头可能读不出来。 -->
            <SolidColorBrush x:Key="CardPagerButtonBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardPagerButtonBackgroundPointerOverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardPagerButtonBackgroundPressedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardPagerButtonForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HomeCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
