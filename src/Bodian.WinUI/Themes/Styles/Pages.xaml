<?xml version="1.0" encoding="utf-8"?>
<!--
    页面骨架的共享样式。

    背景：十三个页面各自写了一遍 <Grid Padding="24,16" RowSpacing="12"> + 三行结构 +
    16px 的 ProgressRing，光「16」就重复了十二次。改一处要改十三处。

    这里只收敛**尺寸与外观**，不动页面的行列结构 —— 各页的组合本来就不一样
    （发现页只有「重新加载」，我喜欢的页还有「重试」），
    抽成控件反而要开一堆可见性属性孔。

    ★ 这些 Style 的目标类型是 Grid / TextBlock / ProgressRing，不是 Control。
      WinUI 的 Style 可以作用于任意 FrameworkElement（通过 FrameworkElement.Style），
      只要 Setter 里的属性在目标类型上存在即可。构建能过就说明这一点成立。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 列表默认按可见行回收，保持半屏预取。所有页面使用同一组基础面板。 -->
    <ItemsPanelTemplate x:Key="BodianVirtualizedItemsPanel">
        <ItemsStackPanel CacheLength="0.5" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="BodianHorizontalItemsPanel">
        <ItemsStackPanel Orientation="Horizontal" CacheLength="0.5" />
    </ItemsPanelTemplate>

    <!-- 页面根容器：统一的页边距与行间距 -->
    <Style x:Key="BodianPageRoot" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource SpacePagePadding}" />
        <Setter Property="RowSpacing" Value="{StaticResource SpaceSection}" />
    </Style>

    <!-- 曲目列表页：减少侧栏与列表之间的留白，沿用其余页面骨架。 -->
    <Style x:Key="BodianTrackPageRoot" TargetType="Grid" BasedOn="{StaticResource BodianPageRoot}">
        <Setter Property="Padding" Value="{StaticResource SpaceTrackPagePadding}" />
    </Style>

    <!-- 页面标题 -->
    <Style x:Key="BodianPageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />

    <!-- 标题旁的次级说明（「4 组、共 20 个榜」这类） -->
    <Style x:Key="BodianPageStatus" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 页脚里那个转圈的进度环 -->
    <Style x:Key="BodianPageBusyRing" TargetType="ProgressRing">
        <Setter Property="Width" Value="{StaticResource SizeProgressRing}" />
        <Setter Property="Height" Value="{StaticResource SizeProgressRing}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- 页脚那一行：左侧一簇（进度环 + 重新加载） -->
    <Style x:Key="BodianPageFooter" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource SpaceSection}" />
    </Style>

    <!--
        列表末尾的状态小字：「没有更多了哦~」「加载失败」，由 PagingEndNote 使用。
        翻页改成滚动触发后，这是用户判断「是真的没了」还是「卡住了」的唯一线索。
    -->
    <Style x:Key="BodianPageEndNote" TargetType="TextBlock" BasedOn="{StaticResource BodianPageStatus}">
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
