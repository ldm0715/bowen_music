<?xml version="1.0" encoding="utf-8"?>
<!--
    页面骨架的共享样式。

    背景：十三个页面各自写了一遍 <Grid Padding="24,16" RowSpacing="12"> + 三行结构 +
    16px 的 ProgressRing，光「16」就重复了十二次。改一处要改十三处。

    这里只收敛**尺寸与外观**，不动页面的行列结构 —— 各页的组合本来就不一样
    （发现页只有「重新加载」，我喜欢的页还有「重试」），
    抽成控件反而要开一堆可见性属性孔。

    ★ 这些 Style 的目标类型是 Grid / TextBlock / ProgressRing，不是 Control。
      WinUI 的 Style 可以作用于任意 FrameworkElement（通过 FrameworkElement.Style），
      只要 Setter 里的属性在目标类型上存在即可。构建能过就说明这一点成立。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 列表默认按可见行回收，保持半屏预取。所有页面使用同一组基础面板。 -->
    <ItemsPanelTemplate x:Key="BodianVirtualizedItemsPanel">
        <ItemsStackPanel CacheLength="0.5" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="BodianHorizontalItemsPanel">
        <ItemsStackPanel Orientation="Horizontal" CacheLength="0.5" />
    </ItemsPanelTemplate>

    <!-- 页面根容器：统一的页边距与行间距 -->
    <Style x:Key="BodianPageRoot" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource SpacePagePadding}" />
        <Setter Property="RowSpacing" Value="{StaticResource SpaceSection}" />
    </Style>

    <!-- 曲目列表页：减少侧栏与列表之间的留白，沿用其余页面骨架。 -->
    <Style x:Key="BodianTrackPageRoot" TargetType="Grid" BasedOn="{StaticResource BodianPageRoot}">
        <Setter Property="Padding" Value="{StaticResource SpaceTrackPagePadding}" />
    </Style>

    <!-- 乐库封面卡片：悬浮背景只比内容多一圈小留白，高度随内容变化。 -->
    <Style x:Key="BodianCoverCardItem" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>

    <!-- 页面标题 -->
    <Style x:Key="BodianPageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />

    <!-- 标题旁的次级说明（「4 组、共 20 个榜」这类） -->
    <Style x:Key="BodianPageStatus" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 页脚里那个转圈的进度环 -->
    <Style x:Key="BodianPageBusyRing" TargetType="ProgressRing">
        <Setter Property="Width" Value="{StaticResource SizeProgressRing}" />
        <Setter Property="Height" Value="{StaticResource SizeProgressRing}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- 页脚那一行：左侧一簇（进度环 + 重新加载） -->
    <Style x:Key="BodianPageFooter" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource SpaceSection}" />
    </Style>

    <!--
        列表末尾的状态小字：「没有更多了哦~」「加载失败」，由 PagingEndNote 使用。
        翻页改成滚动触发后，这是用户判断「是真的没了」还是「卡住了」的唯一线索。
    -->
    <Style x:Key="BodianPageEndNote" TargetType="TextBlock" BasedOn="{StaticResource BodianPageStatus}">
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!--
        发现页的标题分两层：外层列表的模块标题（一层）、HomeSectionView 里那一组的小标题（二层）。
        两层的字号必须拉开 —— 曾经是反的（模块 14、组内 20），看起来「孩子比爸爸大」。
    -->

    <!-- 模块标题 -->
    <Style x:Key="BodianModuleTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 组内标题：低模块一层，所以是 14 半粗而不是 20 -->
    <Style x:Key="BodianSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--
        同层的「可点」版本（只有 AI 歌单那一组会点开成完整歌单）。
        字号字重与 BodianSectionTitle 对齐，可点性只用强调色区分 ——
        靠大小区分会让人以为是两种层级的东西。
    -->
    <Style x:Key="BodianSectionTitleLink" TargetType="HyperlinkButton"
           BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="4,0,0,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        28×28 的图标按钮：透明底、无边框、RadiusSm，内容由调用方给 FontIcon。
        列表工具栏、侧栏的刷新/新建、行尾的「更多」都是这一套，别再各写一份 Setter。

        ★ MinWidth/MinHeight 必须清零：Button 默认 MinWidth 是 120，不清零会被撑成长条。
        ★ 想要别的边长（行尾「更多」是 32）在调用点上写 Width/Height 覆盖即可。
        ★ 不复用 BodianCardPagerButton：那个是半透明黑底、给封面上的翻页箭头用的，
          压在浅色页面上会消失。
        ★ ToolTip / AutomationProperties.Name / Click / Command 是语义不是外观，留在各调用点。
    -->
    <Style x:Key="BodianIconButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource SizeIconButton}" />
        <Setter Property="Height" Value="{StaticResource SizeIconButton}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        发现页卡片区两侧的翻页箭头。它压封面上，底色不能用 SubtleButton 那一套
        （悬停底只有 4~6%，一悬停就没了，白箭头压在浅色封面上会消失），
        用自己的 CardPagerButton* 画刷：深浅两套是同一档半透明黑，高对比度跟系统走。
        全仓没有 Storyboard，悬停只换底色。
        ★ MinWidth 必须清零：Button 默认 MinWidth 是 120，不清零会被撑成长条。
    -->
    <Style x:Key="BodianCardPagerButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource SizeHomePagerButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource SizeHomePagerButtonHeight}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="Background" Value="{ThemeResource CardPagerButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource CardPagerButtonForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background"
                                                Value="{ThemeResource CardPagerButtonBackgroundPointerOverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background"
                                                Value="{ThemeResource CardPagerButtonBackgroundPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
