<?xml version="1.0" encoding="utf-8"?>
<!--
    沉浸页（歌词页 / MV 页）的进度条外观。

    ★ 两个页面共用这一份，不要再各写一份 —— MV 页当初只抄了歌词页的**颜色**、
      没抄**尺寸**，于是同一个白色进度条在两页上胖瘦、手感都不一样。

    ★ 这些键是 **Slider 模板自己的资源键**（轨道填充 / 值填充 / 滑块，以及模板量尺寸用的
      SliderTrackThemeHeight 那一族），不是样式属性 —— 所以只能按资源字典给：
      Style 没有 Resources 这个 Setter，套不进样式。

    ★ 也**不能放进 App.xaml 的全应用合并字典**：那样音量滑条以及任何别的 Slider
      都会跟着被改。用它的页面把它挂在自己的 Slider.Resources 上，作用域就只有那一根。

    ★ 底部播放条**不用**这一份，它是有意做成另一种的：细轨道（1.5）+ 强调色 +
      悬停才出滑块，并且兼作内容区与播放栏的分界。见 ui-refresh.md §10 / §23。

    ★ 改这里的数字前先读这条：`SliderPreContentMargin` + `SliderTrackThemeHeight` +
      `SliderPostContentMargin` **必须凑够滑条的厚度**（横向是高度、竖向是宽度）。
      模板里那两段留白占的是 **Auto 高的行、不是 ***，三者加起来小于盒子厚度时
      轨道就顶在上边缘、不居中 —— 而通栏进度条左右没有比对物，错了也看不出来。
      下面这三行是 0 + 2 + 0 = 2，配 22 高的盒子，轨道其实贴着上边（2026-10-07 在小窗那条
      音量滑条上暴露出来才发现，见 ui-refresh.md §34.4）。这里是既有观感，暂不动。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 压在深色氛围背景（或 MV 画面）上，所以一律用白的一套，不跟主题走。 -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="White" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="White" />
    <SolidColorBrush x:Key="SliderInnerThumbBackground" Color="White" />
    <SolidColorBrush x:Key="SliderInnerThumbBackgroundPointerOver" Color="White" />
    <SolidColorBrush x:Key="SliderInnerThumbBackgroundPressed" Color="White" />

    <!-- 量尺寸：轨道 2 厚，滑块 14（内圈 10），左右不留边。 -->
    <x:Double x:Key="SliderTrackThemeHeight">2</x:Double>
    <x:Double x:Key="SliderHorizontalHeight">22</x:Double>
    <x:Double x:Key="SliderPreContentMargin">0</x:Double>
    <x:Double x:Key="SliderPostContentMargin">0</x:Double>
    <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
    <x:Double x:Key="SliderInnerThumbWidth">10</x:Double>
    <x:Double x:Key="SliderInnerThumbHeight">10</x:Double>
</ResourceDictionary>
