<?xml version="1.0" encoding="utf-8"?>
<!--
    主题无关的标量 token：尺寸 / 圆角 / 间距 / 字号。

    这里只放「不随浅色深色变化」的值。颜色一律放 Colors.*.xaml。

    引用约定：
      - 这里定义的全部用 {StaticResource} 引用。它们不随主题变，用 ThemeResource
        只会额外挂一次属性监听，没有收益。
      - 颜色一律用 {ThemeResource}。ThemeResource 会随主题切换重新求值，
        StaticResource 只求值一次 —— 用错了切换主题时颜色不会变。

    命名前缀 Size*/Radius*/Space*/FontSize* 是为了跟系统键区分开，
    也方便 grep。改尺寸时只改这里，不要去页面里改字面量。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 骨架尺寸 -->
    <!-- 与原生 Tall 标题栏同高，窗口外部尺寸不变 -->
    <x:Double x:Key="SizeTopBar">48</x:Double>
    <x:Double x:Key="SizePlayerBar">80</x:Double>
    <x:Double x:Key="SizeSidebarMin">192</x:Double>
    <x:Double x:Key="SizeSidebarMax">360</x:Double>

    <!-- 侧栏展开宽度。NavigationView 的默认是 320，这里收到 200 -->
    <x:Double x:Key="SizeSidebarWidth">200</x:Double>

    <!-- 列表行 -->
    <x:Double x:Key="SizeRowHeight">64</x:Double>
    <x:Double x:Key="SizeRowOrdinalColumn">32</x:Double>
    <x:Double x:Key="SizeRowDurationColumn">40</x:Double>
    <!-- 行尾「更多」按钮的列宽。定宽而不是 Auto：按钮未悬停时是折叠的，
         Auto 列会塌成 0，一悬停整行宽度突变、时长跟着左右跳。 -->
    <x:Double x:Key="SizeRowActionColumn">32</x:Double>

    <!-- 封面。列表行与播放条共用 Row 这一档 -->
    <x:Double x:Key="SizeCoverRow">48</x:Double>
    <x:Double x:Key="SizeCoverSm">36</x:Double>
    <x:Double x:Key="SizeCoverMd">72</x:Double>
    <x:Double x:Key="SizeCoverGrid">150</x:Double>

    <!-- 图标与按钮 -->
    <x:Double x:Key="SizeIconSm">16</x:Double>
    <x:Double x:Key="SizeIconMd">20</x:Double>
    <x:Double x:Key="SizePlayButton">44</x:Double>
    <x:Double x:Key="SizeTransportIcon">28</x:Double>
    <x:Double x:Key="SizeRoundButton">32</x:Double>
    <x:Double x:Key="SizeProgressRing">16</x:Double>

    <!-- 圆角阶梯 -->
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!--
      覆盖系统的全局控件圆角（默认 4）。
      NavigationViewItem 的模板里有 <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>，
      所以这一条同时决定侧栏导航项的胶囊形状 —— 不用去重写它的模板。

      注意影响面：Button / TextBox / ComboBox / AutoSuggestBox 的圆角会一起变。
      这正是「统一圆角」想要的效果，但它是全局的，改动前后差别要目视确认。
    -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>

    <!--
        ══ 侧栏（NavigationView）几何 ══

        这里只放「不随主题变」的量；选中/hover 的底色在 Theme.xaml 里分浅色深色两套。

        为什么能靠覆盖资源键做到、不必重写 ControlTemplate：
        NavigationViewItem 的默认模板把这些值都做成了 ThemeResource 引用，
        包括那个左侧选中竖条 —— 它就是模板里一个矩形，宽高取自下面两个键，
        所以设成 0 就等于去掉了它。

        ★ 这些键名写错不会有编译错误，只会静默不生效。改动后必须目视确认。
    -->

    <!-- 左侧选中竖条：设 0 即去掉 -->
    <x:Double x:Key="NavigationViewSelectionIndicatorWidth">0</x:Double>
    <x:Double x:Key="NavigationViewSelectionIndicatorHeight">0</x:Double>

    <!-- 导航项高度。系统默认就是 36，显式写出来防止将来被别处改掉 -->
    <x:Double x:Key="NavigationViewItemOnLeftMinHeight">36</x:Double>

    <!-- 图标列宽。系统默认 40（16 图标 + 24 留白），收到 24 让文字更靠近图标 -->
    <x:Double x:Key="NavigationViewIconBoxWidth">24</x:Double>

    <!-- 使用原生的左右 4px 边距，紧凑侧栏下背景不会越界裁切；上下项间距仍为 4px -->
    <Thickness x:Key="NavigationViewItemButtonMargin">4,2</Thickness>

    <!-- 项自身不描边（选中态用底色表示，不用边框） -->
    <Thickness x:Key="NavigationViewItemBorderThickness">0</Thickness>

    <!-- 去掉面板与内容区之间的分割线：厚度清零、圆角清零 -->
    <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0,0,0,0</Thickness>
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>

    <!-- 分组头（「我的音乐」「创建的歌单」）。Left 模式下只有这一个键有用 -->
    <Thickness x:Key="NavigationViewItemInnerHeaderMargin">12,10,0,4</Thickness>

    <!--
        ══ 进度条（Slider）几何 ══

        只覆盖几何资源键，**不换控件模板** —— 拖拽、键盘方向键、无障碍
        （RangeValuePattern）全部保持系统行为。播放条上那个 seek 逻辑
        （AddHandler(PointerPressedEvent, …, handledEventsToo: true)）也不受影响。

        代价：「悬停时轨道变粗」「滑块默认隐藏、悬停才出现」是模板内的固定
        Storyboard，**没有资源键能改**，所以这两条做不到。要做得换模板，
        那是另一笔账（要重测拖拽 / 键盘 / 无障碍）。
    -->

    <!-- 轨道 4 → 2 -->
    <x:Double x:Key="SliderTrackThemeHeight">2</x:Double>

    <!-- 滑块 18 → 14，并去掉中间那个内圈小点（默认 12），得到一个纯色圆 -->
    <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
    <x:Double x:Key="SliderInnerThumbWidth">0</x:Double>
    <x:Double x:Key="SliderInnerThumbHeight">0</x:Double>

    <!-- 间距 -->
    <Thickness x:Key="SpacePagePadding">24,16</Thickness>
    <!-- 曲目页靠近侧栏；保留右侧与上下的原有留白 -->
    <Thickness x:Key="SpaceTrackPagePadding">12,16,24,16</Thickness>
    <!-- 行悬浮背景内侧留 8px。原本是 16，为的是让时间不贴住背景圆角；
         行尾加了「更多」按钮后，紧贴圆角的是那颗按钮（它自带静默热区），
         于是收回 8px，让图标右边缘落在时间原先结束的位置。 -->
    <Thickness x:Key="SpaceRowPadding">4,0,8,0</Thickness>
    <!-- 内容在浮动纵向滚动条内侧结束；左侧保持紧凑，不随滚动条显隐跳动 -->
    <Thickness x:Key="SpaceVerticalScrollContentPadding">0,0,24,0</Thickness>
    <x:Double x:Key="SpaceSection">12</x:Double>
    <x:Double x:Key="SpaceRow">8</x:Double>

    <!-- 字号阶梯 -->
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeBodyLarge">14</x:Double>
    <x:Double x:Key="FontSizeTitle">18</x:Double>
    <x:Double x:Key="FontSizePageTitle">22</x:Double>

</ResourceDictionary>
