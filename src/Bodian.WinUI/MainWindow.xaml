<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Bodian.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    xmlns:models="using:Bodian.Core.Models"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:vm="using:Bodian.WinUI.ViewModels"
    >

    <!--
        外壳 = 自定义标题栏（第 0 行）+ 侧栏 / 内容区（第 1 行）+ 通栏播放条（第 2 行）。

        ★ 播放条**通栏**，横跨整个窗口宽度，所以侧栏不再到窗口底部。
          这是刻意改的：早先的做法是把播放条塞进 NavigationView 的 Content，
          让侧栏从顶到底（模仿官方 PC 端）。但那样播放条不横跨侧栏，
          与用户对播放器的预期不符 —— 现在按 Spotify / Apple Music 的形态来。

        ★ IsBackButtonVisible=Collapsed：返回栈是自己的（INavigationService），
          返回入口统一放在搜索框左侧。交给 NavigationView 会多出一个不受控的按钮。

        ★ 用 ItemInvoked 而不是 SelectionChanged：SelectionChanged 在我们自己
          同步高亮时也会触发，会和导航互相打架。ItemInvoked 只在用户点击时触发。
    -->
    <!--
        ★ RequestedTheme 必须设在最外层这个 Grid 上，**不能设在里面的 NavigationView 上**。
          设在 NavigationView 上时只有它自己的子树跟随主题，窗口底色的那层就漏掉了 ——
          主题无关的兄弟节点会一直用浅色，深色模式下整个窗口变成一片白。实测踩过。

        ★ 底色也必须自己铺：NavigationView 的面板是 AcrylicBrush、内容区是半透明层刷，
          两者都假定自己叠在 Mica 背板上。本应用不设背板（氛围渐变才是背景），
          没有东西可叠时深色下面板会退回浅色，白字压白底 —— 导航项整个看不见。
          见 Themes/Theme.xaml 里 AppSurfaceBrush 的说明。

        ★ 不能用 Application.RequestedTheme：那个只能在窗口创建之前设，
          运行期改会抛异常。所以运行期切换只能走元素级。
    -->
    <controls:ResponsiveViewport x:Name="WindowViewport">
    <Grid
        x:Name="ShellRoot"
        RequestedTheme="{x:Bind Theme.RequestedTheme, Mode=OneWay}"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <!--
                ★ 菜单的固定宽度（逻辑像素）。

                钉死宽度是为了让**内容再也影响不了菜单大小**：菜单本来按最宽的那一项撑开，
                歌名一长整颗菜单就变宽、下面那些短行右边空出一大片。
                这里把每一项的宽度都设成这个值，于是每一行一样宽、菜单也就固定了。

                改宽度只需改这一个数。
            -->
            <x:Double x:Key="TrayMenuWidth">160</x:Double>

            <!--
                ── 托盘菜单的项模板 ────────────────────────────────────────────────

                ★★ 为什么必须自写：框架的 DefaultMenuFlyoutItemStyle 模板里只画
                   <TextBlock Text="{TemplateBinding Text}"/>，**没有内容占位** —— 所以
                   MenuFlyoutItem 只能显示「图标 + 一行文字」，做不到「三个图标合成一行」。

                ★★ 而且光改模板不够：MenuFlyoutItemBase 的基类是 Control、**不是 ContentControl**，
                   所以 MenuFlyoutItem **压根没有 Content 属性**（编译期就会报
                   WMC0011: Unknown member 'Content'）。因此这一项的 TargetType 是
                   Controls/TrayMenuItem —— 那是个薄薄一层派生类，只多一个能装任意内容的
                   Body 属性，菜单行为全部继承。理由写在那个类的注释里。

                主菜单项固定为 TrayMenuWidth，外距 3,1,3,1；行内留白由 Body 决定。
                Width 与 Margin 设在控件上，模板只负责绘制，子菜单才能复用模板并按文字收缩。
                托盘库会强制改写 Control.Padding；两份模板的内部留白直接定值，不读取该属性。
                悬停和选中背景都使用 SubtleFillColorSecondaryBrush。
            -->
            <Style x:Key="TrayMenuItemStyle" TargetType="controls:TrayMenuItem">
                <Setter Property="Width" Value="{StaticResource TrayMenuWidth}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Margin" Value="3,1,3,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:TrayMenuItem">
                            <Grid
                                x:Name="LayoutRoot"
                                Padding="0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                PointerPressed="OnTrayMenuContentPointerPressed"
                                Tapped="OnTrayMenuContentTapped">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    Content="{TemplateBinding Body}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 展开的三项按文字测量宽度，只保留左右内距。 -->
            <Style x:Key="TrayPlayModeItemStyle" TargetType="controls:TrayMenuItem" BasedOn="{StaticResource TrayMenuItemStyle}">
                <Setter Property="Width" Value="Auto" />
            </Style>

            <!--
                sealed 只限制继承，不限制替换 ControlTemplate。
                图标 16 + 文字左距 8 与其他主菜单项一致；模板内距不受托盘库强制赋值影响。
            -->
            <Style x:Key="TrayMenuSubItemStyle" TargetType="MenuFlyoutSubItem" BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}">
                <Setter Property="Width" Value="{StaticResource TrayMenuWidth}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Margin" Value="3,1,3,1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuFlyoutSubItem">
                            <Grid
                                x:Name="LayoutRoot"
                                Padding="8,6,8,6"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SubMenuOpened">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="PaddingSizeStates">
                                        <VisualState x:Name="DefaultPadding" />
                                        <VisualState x:Name="NarrowPadding" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox x:Name="IconRoot" Width="16" Height="16" VerticalAlignment="Center">
                                        <ContentPresenter x:Name="IconContent" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}" />
                                    </Viewbox>
                                    <TextBlock
                                        x:Name="TextBlock"
                                        Grid.Column="1"
                                        Margin="8,0,6,0"
                                        Text="{TemplateBinding Text}"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{TemplateBinding Foreground}"
                                        VerticalAlignment="Center" />
                                    <FontIcon
                                        x:Name="SubItemChevron"
                                        Grid.Column="2"
                                        Glyph="&#xE974;"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="12"
                                        Foreground="{TemplateBinding Foreground}"
                                        VerticalAlignment="Center"
                                        MirroredWhenRightToLeft="True"
                                        AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                转台那一排里的单个按钮。WinUI 的 Button 默认 MinWidth 是 120，
                不改的话三个并排会撑成一条巨宽的行。
            -->
            <Style x:Key="TrayTransportButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="38" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <!-- 顶部：原生自定义标题栏，复用原系统标题栏区域 -->
            <RowDefinition Height="Auto" />
            <!-- 中间：侧栏 + 内容区，顶边齐平 -->
            <RowDefinition Height="*" />
            <!-- 下：播放条。**通栏**，横跨侧栏与内容区 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            底色层与氛围渐变层都要**跨三行**：只铺内容区的话，播放条那一带会露出纯色，
            与上面的渐变之间出现一条硬边。
        -->
        <Border Grid.RowSpan="3" Background="{ThemeResource AppSurfaceBrush}" />
        <controls:AmbientBackdrop x:Name="ShellBackdrop" Grid.RowSpan="3" />

        <!--
            原生 TitleBar 负责拖动区与交互控件避让，系统 caption 按钮仍由 Windows 管理。
            左上角预留与展开侧栏等宽的 Logo 区域；收起按钮留在下方 NavigationView。
            高度与原生 Tall caption 一致，搜索框、账号、主题和窗口按钮沿同一中心线。
        -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="{StaticResource SizeTopBar}"
            Background="Transparent"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            AutomationProperties.Name="{x:Bind local:Formats.AppTitleBarName}">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <x:Double x:Key="TitleBarExpandedHeight">48</x:Double>
                <x:Double x:Key="TitleBarLeftPaddingWidth">0</x:Double>
                <x:Double x:Key="TitleBarLeftHeaderPaddingWidth">0</x:Double>
                <Thickness x:Key="TitleBarCompactContentMargin">0</Thickness>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
                <!--
                    按钮组与系统窗口三按钮之间的最小拖动区。模板默认 48 DIP，那道空档看起来像
                    按钮被推远了 —— 这里压到 8。整条标题栏仍然是拖动区（SetTitleBar 已接管），
                    8 足够留出「按钮与窗口按钮之间不误触」的余量。
                -->
                <x:Double x:Key="TitleBarMinDragRegionWidth">8</x:Double>
            </TitleBar.Resources>
            <TitleBar.LeftHeader>
                <!--
                    应用 Logo：图标 + 名字。左内边距 24 与 SpacePagePadding 的左值对齐，
                    于是页内内容、搜索框与 Logo 共用同一条左基准线。
                    ★ 收起侧栏时只留图标、内边距收到 12（48 宽的轨道刚好 12+24+12 居中），
                      由 UpdateSidebarPaneMode 切。

                    ★ 图标走 {ThemeResource AppIconSource}：深浅两版放在 Theme.xaml 的
                      主题字典里，主题一换自动重解析，不需要在代码里监听 ActualThemeChanged。
                -->
                <Border
                    x:Name="LogoHost"
                    Width="{StaticResource SizeSidebarWidth}"
                    Height="32"
                    Padding="24,0"
                    IsHitTestVisible="False">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <Image
                            Width="24"
                            Height="24"
                            Source="{ThemeResource AppIconSource}" />
                        <!--
                            ★ RenderTransform 上移 2 像素是为了让文字与图标看起来在同一水平线上。
                              TextBlock 的行盒按拉丁字母的上下伸部分配空间，而汉字的重心在 em 框里
                              偏下 —— 两者都 VerticalAlignment=Center 时，汉字看上去会低一两个像素。
                              用 RenderTransform 而不是负 Margin：前者是纯视觉位移、正好 -2，
                              后者会被居中布局吃掉一半，调不到准数。
                        -->
                        <TextBlock
                            x:Name="LogoLabel"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeBodyLarge}"
                            FontWeight="SemiBold"
                            Text="{x:Bind local:Formats.AppName}"
                            TextTrimming="CharacterEllipsis">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="-2" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </TitleBar.LeftHeader>
            <TitleBar.Content>
                <!-- 搜索宽度随可用空间收缩，并限制最大宽度以保留标题栏留白。 -->
                <Grid x:Name="SearchBarHost" Margin="24,0,24,0" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="400" />
                    </Grid.ColumnDefinitions>
                    <!--
                        ★ 尺寸与底色照抄右侧的 ThemeButton / AccountButton，**不要**给按钮套
                          ContentControl 外壳，也不要用 SubtleButtonStyle：那个样式的
                          HorizontalAlignment=Left，外壳上的 Stretch 拉不住它，按钮会缩回图标
                          自身的宽度（悬停背景比图标还小）。显式给 32×32 才是整块可点、整块出底色。
                    -->
                    <Button
                        x:Name="BackButton"
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        CornerRadius="8"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        IsEnabled="{x:Bind _navigation.CanGoBack, Mode=OneWay}"
                        Click="OnBackClick"
                        AutomationProperties.Name="返回上一级"
                        ToolTipService.ToolTip="返回上一级">
                        <Button.Resources>
                            <!--
                                ★ 默认模板的 Disabled 态会把背景铺成 ButtonBackgroundDisabled，
                                  盖住上面那句 Background="Transparent" —— 症状是「能点的时候没底色、
                                  不能点的时候反而有底色」。把它连同描边一起置空，
                                  禁用只体现在前景色变淡（那才是这个按钮该有的反馈）。
                                  旁边的主题 / 账号按钮没有 IsEnabled 绑定，所以从来没露过这个问题。
                            -->
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Button.Resources>
                        <controls:Icon Size="{StaticResource SizeIconSm}" Data="{StaticResource IconBack}" />
                    </Button>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        PlaceholderText="搜索单曲、歌单、专辑、歌手"
                        QueryIcon="Find"
                        QuerySubmitted="OnSearchQuerySubmitted"
                        TextChanged="OnSearchTextChanged"
                        GotFocus="OnSearchGotFocus"
                        ItemsSource="{x:Bind Search.Suggestions, Mode=OneWay}"
                        Text="{x:Bind Search.Keyword, Mode=TwoWay}"
                        AutomationProperties.Name="搜索单曲、歌单、专辑、歌手" />

                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel x:Name="TitleBarRightHeader" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="AccountButton"
                        Visibility="Collapsed"
                        AutomationProperties.Name="账号"
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        VerticalAlignment="Center"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="{x:Bind Account.EntryToolTip, Mode=OneWay}">
                        <Border
                            Width="24"
                            Height="24"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="12">
                            <!--
                                未登录时这里原来是一个空灰圆 —— 看不出那是个入口。
                                换成人形图标：位置不变，但一眼知道「点头像能去登录」。
                            -->
                            <Grid>
                                <Image
                                    Source="{x:Bind Account.Avatar, Mode=OneWay}"
                                    Stretch="UniformToFill"
                                    Visibility="{x:Bind Account.SignedInVisibility, Mode=OneWay}" />
                                <controls:Icon
                                    Size="14"
                                    Data="{StaticResource IconPerson}"
                                    Visibility="{x:Bind Account.SignedOutVisibility, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <Button.Flyout>
                            <!-- 正下方居中，与主题弹层一致。之前用 BottomEdgeAlignedRight，
                                 弹窗比头像按钮宽得多，右对齐会把整块甩到头像左边去。 -->
                            <Flyout Opening="OnAccountFlyoutOpening" Placement="Bottom">
                                <!--
                                    底色与主题弹层用同一个实色画刷。
                                    不写这段的话会回落到框架默认的 FlyoutPresenter 样式 ——
                                    它的背景是亚克力（半透明），叠在窗口的氛围渐变上，
                                    亮色主题看着接近实色、暗色主题就明显透，像是两个主题不一致。

                                    显式给 Style 会整份替换掉框架默认样式，所以 Padding 与 MaxWidth
                                    要照着原来的值写回来（框架默认是 12 与 456）：
                                    漏掉 MaxWidth，下面那个昵称的省略号就不生效、长昵称会把弹层撑宽。
                                    这里不用主题弹层的 Padding="6" —— 那份的内容是自带内边距的列表，
                                    这份是裸 StackPanel，保持 12。
                                -->
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Background" Value="{ThemeResource ThemeFlyoutBackground}" />
                                        <Setter Property="Padding" Value="12" />
                                        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                                        <Setter Property="MaxWidth" Value="456" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>

                                <!--
                                    两块内容互斥：一级是账号信息，二级是「切换账号」列表。
                                    用同一个 Flyout 里的两块 StackPanel 切 Visibility，而不是
                                    Flyout 套 Flyout 或弹 ContentDialog —— 前者行为很难收拾，后者对
                                    「点一下就切」这种动作太重。
                                -->
                                <Grid x:Name="AccountFlyoutRoot" MinWidth="200">
                                    <!--
                                        这一屏只在**已登录**时出现（判据见 AccountPanelVisibility）：
                                        未登录时没有账号卡片可看，弹层直接是账号列表那一屏。
                                    -->
                                    <StackPanel Spacing="12" Visibility="{x:Bind Account.AccountPanelVisibility, Mode=OneWay}">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            Visibility="{x:Bind Account.SignedInVisibility, Mode=OneWay}">
                                            <Border
                                                Width="32"
                                                Height="32"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                CornerRadius="16">
                                                <Image Source="{x:Bind Account.Avatar, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Border>

                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock
                                                    Text="{x:Bind Account.AccountText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <!--
                                                    会员徽标只是展示：播放权限一律以服务端 checkRight 为准。
                                                    胶囊 = 图标 + 档位名，按档位三选一，每档一套配色（金 / 银 / 浅绿，
                                                    见 Themes/VipBadge.xaml）；非会员三个都不显示。

                                                    ★ 图标必须是 Path 而不是 PathIcon：PathIcon 按几何的原始尺寸
                                                      出图，不缩放到 Width/Height，超出部分会被裁掉（皇冠会只剩一半）。
                                                      Path 的 Stretch 才真的缩放。写法同 SongCommentsPanel.xaml。
                                                -->
                                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                    <!-- 大会员：金，皇冠 + 顶星 -->
                                                    <Border
                                                        Padding="6,2"
                                                        Background="{ThemeResource VipBadgeBigBackgroundBrush}"
                                                        CornerRadius="10"
                                                        Visibility="{x:Bind Account.BigVipVisibility, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Path
                                                                Width="11"
                                                                Height="13"
                                                                VerticalAlignment="Center"
                                                                Data="M 2,9 L 6,13.5 L 10,7 L 14,13.5 L 18,9 L 16.5,21 L 3.5,21 Z M 10,0.1 L 10.85,2.33 L 13.23,2.45 L 11.38,3.95 L 12,6.25 L 10,4.95 L 8,6.25 L 8.62,3.95 L 6.77,2.45 L 9.15,2.33 Z"
                                                                Fill="{ThemeResource VipBadgeBigForegroundBrush}"
                                                                Stretch="Uniform" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource VipBadgeBigForegroundBrush}"
                                                                Text="{x:Bind Account.VipKindLabel, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 畅听会员：银，三尖皇冠 -->
                                                    <Border
                                                        Padding="6,2"
                                                        Background="{ThemeResource VipBadgeStandardBackgroundBrush}"
                                                        CornerRadius="10"
                                                        Visibility="{x:Bind Account.StandardVipVisibility, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Path
                                                                Width="15"
                                                                Height="13"
                                                                VerticalAlignment="Center"
                                                                Data="M 2,5 L 6,9.5 L 10,3 L 14,9.5 L 18,5 L 16.5,17 L 3.5,17 Z"
                                                                Fill="{ThemeResource VipBadgeStandardForegroundBrush}"
                                                                Stretch="Uniform" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource VipBadgeStandardForegroundBrush}"
                                                                Text="{x:Bind Account.VipKindLabel, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 福利会员：浅绿，礼物盒 -->
                                                    <Border
                                                        Padding="6,2"
                                                        Background="{ThemeResource VipBadgeWelfareBackgroundBrush}"
                                                        CornerRadius="10"
                                                        Visibility="{x:Bind Account.WelfareVipVisibility, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Path
                                                                Width="15"
                                                                Height="13"
                                                                VerticalAlignment="Center"
                                                                Data="M 1.5,9 L 22.5,9 L 22.5,12.8 L 1.5,12.8 Z M 3,14.4 L 21,14.4 L 21,21 L 3,21 Z M 12,8.8 C 11,4.6 8.5,2.6 7,4 C 5.5,5.4 7.5,8.8 12,8.8 Z M 12,8.8 C 13,4.6 15.5,2.6 17,4 C 18.5,5.4 16.5,8.8 12,8.8 Z"
                                                                Fill="{ThemeResource VipBadgeWelfareForegroundBrush}"
                                                                Stretch="Uniform" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                VerticalAlignment="Center"
                                                                Foreground="{ThemeResource VipBadgeWelfareForegroundBrush}"
                                                                Text="{x:Bind Account.VipKindLabel, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!--
                                                        到期时间：胶囊同一行的小字。
                                                        数据来自登录响应 payInfo 的到期字段（取最晚的一个，见 VipStatus.LatestExpiry），
                                                        **不需要额外接口**；老凭据里没存时整块收掉。
                                                    -->
                                                    <TextBlock
                                                        Margin="6,0,0,0"
                                                        FontSize="11"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Account.VipExpiryText, Mode=OneWay}"
                                                        Visibility="{x:Bind Account.VipExpiryVisibility, Mode=OneWay}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!--
                                            账号统计：关注数 / 听歌总时长。两条接口各自独立，谁先回来谁先显示；
                                            两个都拿不到时整块收掉，不留一行「—  —」。
                                        -->
                                        <Grid ColumnSpacing="16" Visibility="{x:Bind Account.StatsVisibility, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Account.FollowedArtistCountText, Mode=OneWay}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="关注歌手" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Account.ListenTimeText, Mode=OneWay}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="听歌时长" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="8" Visibility="{x:Bind Account.SignedInVisibility, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Button
                                                Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                Click="OnShowSwitchListClick"
                                                Content="切换账号"
                                                ToolTipService.ToolTip="切到另一个登录过的账号，不用重新扫码" />

                                            <Button
                                                Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                Command="{x:Bind Account.SignOutCommand}"
                                                Content="退出登录"
                                                ToolTipService.ToolTip="清除当前会话，回到登录页；已记住的账号仍留在切换列表里" />
                                        </Grid>
                                    </StackPanel>

                                    <!--
                                        账号列表。点一下即切，不重新认证。
                                        **未登录时这一屏就是全部内容**（没有账号卡片可看，而刚登出的人
                                        最想做的就是换个账号回来）。所以标题、下面那颗按钮的名字、
                                        空态文案都随登录态变。
                                    -->
                                    <StackPanel Spacing="8" Visibility="{x:Bind Account.SwitchListVisibility, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button
                                                Width="28"
                                                Height="28"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnHideSwitchListClick"
                                                ToolTipService.ToolTip="返回"
                                                Visibility="{x:Bind Account.BackVisibility, Mode=OneWay}">
                                                <controls:Icon Size="{StaticResource SizeIconSm}" Data="{StaticResource IconBack}" />
                                            </Button>

                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Account.ListTitle, Mode=OneWay}" />
                                        </StackPanel>

                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Account.EmptyListHint, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind Account.EmptyListVisibility, Mode=OneWay}" />

                                        <ItemsControl ItemsSource="{x:Bind Account.RememberedAccounts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RememberedAccountRow">
                                                    <Grid ColumnSpacing="4" Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!--
                                                            当前账号用**底色**表示，不用勾（与托盘播放模式菜单同一套做法：
                                                            一层铺满的 Border + 上层内容；画刷与悬停相同，鼠标划过时不突兀）。
                                                            Border 与按钮同格叠着，随格子铺满；两个都收起来时行高不变。
                                                        -->
                                                        <Border
                                                            Grid.Column="0"
                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                                            Visibility="{x:Bind CurrentHighlightVisibility}" />

                                                        <!--
                                                            整行就是切换按钮。当前那个禁掉而不是隐藏 ——
                                                            列表的位置不会因为「当前是谁」而变。
                                                        -->
                                                        <Button
                                                            Grid.Column="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="OnSwitchRememberedAccountClick"
                                                            IsEnabled="{x:Bind CanSwitch}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Border
                                                                    Width="24"
                                                                    Height="24"
                                                                    VerticalAlignment="Center"
                                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                    CornerRadius="12">
                                                                    <Image Source="{x:Bind Avatar}" Stretch="UniformToFill" />
                                                                </Border>

                                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock
                                                                            Text="{x:Bind DisplayName}"
                                                                            TextTrimming="CharacterEllipsis" />

                                                                        <Border
                                                                            Padding="6,1"
                                                                            VerticalAlignment="Center"
                                                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                            CornerRadius="8"
                                                                            Visibility="{x:Bind StaleLabelVisibility}">
                                                                            <TextBlock
                                                                                FontSize="11"
                                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                                Text="登录已失效" />
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="{x:Bind Uid}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Button>

                                                        <Button
                                                            Grid.Column="1"
                                                            Width="28"
                                                            Height="28"
                                                            MinWidth="0"
                                                            MinHeight="0"
                                                            Padding="0"
                                                            VerticalAlignment="Center"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Click="OnForgetRememberedAccountClick"
                                                            ToolTipService.ToolTip="从这台机器上移除这个账号的登录凭据">
                                                            <controls:Icon Size="12" Data="{StaticResource IconDelete}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            打开登录框。已登录时叫「添加账号」，未登录时叫「登录」——
                                            同一件事（`OnSignInClick`），只是这个人此刻缺的是什么不一样。
                                            不再先登出：那样一旦反悔就无路可回（旧行为只能退出应用）。
                                        -->
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Click="OnSignInClick"
                                            ToolTipService.ToolTip="登录一个新账号并记进列表">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <controls:Icon VerticalAlignment="Center" Size="12" Data="{StaticResource IconAdd}" />
                                                <TextBlock Text="{x:Bind Account.ListFooterText, Mode=OneWay}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Name="ThemeButton"
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="{x:Bind Theme.CurrentLabel, Mode=OneWay}"
                        AutomationProperties.Name="切换主题">
                        <controls:Icon Size="{StaticResource SizeIconSm}"
                            Data="{x:Bind local:Formats.IconPaths(Theme.CurrentIcon), Mode=OneWay}" />
                        <Button.Flyout>
                            <Flyout Opening="OnThemeFlyoutOpening" Placement="Bottom">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Background" Value="{ThemeResource ThemeFlyoutBackground}" />
                                        <Setter Property="Padding" Value="6" />
                                        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <!-- 竖排单选列表：仅以背景表示选中，隐藏圆点、勾选和强调线。 -->
                                <ListView
                                    x:Name="ThemeOptions"
                                    MinWidth="0"
                                    HorizontalAlignment="Left"
                                    SelectionMode="Single"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    AutomationProperties.Name="主题">
                                    <ListView.Resources>
                                        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                                        <x:Boolean x:Key="ListViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                                    </ListView.Resources>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="Padding" Value="10,8" />
                                            <Setter Property="Margin" Value="0,2" />
                                            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListViewItem x:Name="SystemThemeOption" AutomationProperties.Name="跟随系统">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <controls:Icon Size="{StaticResource SizeIconSm}" Data="{StaticResource IconThemeAuto}" />
                                            <TextBlock VerticalAlignment="Center" Text="跟随系统" />
                                        </StackPanel>
                                    </ListViewItem>
                                    <ListViewItem x:Name="LightThemeOption" AutomationProperties.Name="浅色">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <controls:Icon Size="{StaticResource SizeIconSm}" Data="{StaticResource IconThemeLight}" />
                                            <TextBlock VerticalAlignment="Center" Text="浅色" />
                                        </StackPanel>
                                    </ListViewItem>
                                    <ListViewItem x:Name="DarkThemeOption" AutomationProperties.Name="深色">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <controls:Icon Size="{StaticResource SizeIconSm}" Data="{StaticResource IconThemeDark}" />
                                            <TextBlock VerticalAlignment="Center" Text="深色" />
                                        </StackPanel>
                                    </ListViewItem>
                                </ListView>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!--
                        小窗开关。与旁边的主题按钮同一套尺寸与底色。

                        激活态的着色走元素级 VisualState（不是 code-behind 设画刷）：
                        后者拿一次 ThemeResource 就永久设上，切主题后前景不会跟着变 ——
                        播放条那颗桌面歌词开关就是踩过这个才改的，见 docs/icons.md。

                        ★ VisualStateManager.GoToState 的第一个参数必须是 Control，
                          而 MainWindow 是 Window，所以这组状态挂在按钮自己身上，
                          不能像 PlayerBar 那样挂在 UserControl 根上。
                    -->
                    <Button
                        x:Name="MiniPlayerButton"
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="小窗"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnMiniPlayerClick"
                        ToolTipService.ToolTip="小窗">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="MiniPlayerStates">
                                <VisualState x:Name="MiniPlayerInactive" />
                                <VisualState x:Name="MiniPlayerActive">
                                    <VisualState.Setters>
                                        <Setter Target="MiniPlayerButton.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter Target="MiniPlayerButton.Background" Value="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <controls:Icon Size="{StaticResource SizeIconSm}" Data="{StaticResource IconMiniPlayer}" />
                    </Button>

                    <!-- 设置。与左边的按钮同一套尺寸与底色，打开设置页（根页，不进返回栈）。 -->
                    <Button
                        x:Name="SettingsButton"
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="设置"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnSettingsClick"
                        ToolTipService.ToolTip="设置">
                        <controls:Icon Size="{StaticResource SizeIconSm}" Data="{StaticResource IconSettings}" />
                    </Button>
                    <Border
                        Width="1"
                        Height="16"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--
            侧栏选中高亮块。位置与滑动由 Controls/SelectionPill 负责（设置页的分类栏用同一个）。

            这一层必须排在 NavigationView **之前**（画在它下面），导航项的文字才压在高亮块之上。
            这依赖侧栏面板是透明的 —— Theme.xaml 里把 NavigationViewDefaultPaneBackground 等
            四个键都覆写成了 Transparent，NavigationView 自己也不设 Background。
            哪天侧栏改回不透明底，症状会是「侧栏没有高亮」，那时把这一层挪到 NavigationView 之后，
            代价是底色必须永远半透明，否则会盖住选中的文字。

            宽度按展开态取：收起态（48px 图标轨）那块本来就只有 40 宽。
            ClipToBounds：菜单区滚起来时项会跑到行外，不裁的话块会溢到标题栏上。
            IsHitTestVisible=False：这一层只负责画，指针事件仍归侧栏。
        -->
        <Canvas
            x:Name="SidebarIndicatorLayer"
            Grid.Row="1"
            Width="{StaticResource SizeSidebarWidth}"
            HorizontalAlignment="Left"
            IsHitTestVisible="False"
            controls:Motion.ClipToBounds="True">
            <!--
                不写 Visibility="Collapsed"：Collapsed 出生会让它的 Loaded 不触发，
                而 AppMotion 起动画前要判 element.IsLoaded，判不过就只留一次瞬跳。
                没设位置时它是 0 尺寸，画不出来；真要收起时由 SelectionPill 设 Collapsed。
            -->
            <Border
                x:Name="SidebarIndicator"
                Background="{ThemeResource SelectionPillBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                controls:SelectionPill.Owner="{x:Bind Nav}" />
        </Canvas>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="OnItemInvoked"
            OpenPaneLength="{StaticResource SizeSidebarWidth}"
            PaneDisplayMode="Left">

        <!--
            选中底改由上面那块浮动 Border 画，这里把导航项自己那层压成透明 ——
            不压的话会出现「旧项瞬间亮着 + 浮动块慢慢追上」的双高亮。

            只写浅色/深色两档，高对比度那档留空（用系统自带的那套）：系统配色下不做自绘高亮，
            侧栏与页内页签条才都跟系统走。留空的空字典是刻意的，不是漏写。

            选中态设透明、hover/pressed 取与未选中态同一档：叠在 10% 的块上观感与原来接近，
            而且悬停选中项仍有反馈 —— 三项都设透明的话，悬停当前项会完全没有反应。

            NavigationViewItemBackgroundSelected* 是框架自己的键，系统主题字典里有定义，
            这里只是覆盖它，所以不会出现「自造键三档不齐」那种启动异常。
        -->
        <NavigationView.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#0D000000" />
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#14000000" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#0DFFFFFF" />
                        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#14FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast" />
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </NavigationView.Resources>

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="DiscoverItem"
                Content="发现"
                Tag="discover">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="BangsItem"
                Content="排行榜"
                Tag="bangs">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Sort" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="LibraryItem"
                Content="乐库"
                Tag="library">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="List" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!--
                分组头要跟着下面那几项一起显隐：未登录时它们全收起来，
                只留这个标题会变成一句吊在半空的孤儿话。
            -->
            <NavigationViewItemHeader x:Name="MyMusicHeader" Content="我的音乐" />

            <NavigationViewItem
                x:Name="FavoritesItem"
                Content="我喜欢的"
                Tag="favorites">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Favorite" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="RecentItem"
                Content="最近播放"
                Tag="recent">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Clock" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="CollectedAlbumsItem"
                Content="收藏的专辑"
                Tag="collected-albums">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Audio" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!-- 收藏的歌单。与「收藏的专辑」是两回事（同一端点的另一半元素） -->
            <NavigationViewItem
                x:Name="CollectedPlaylistsItem"
                Content="收藏的歌单"
                Tag="collected-playlists">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="List" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!-- 关注的歌手。一次全量返回，没有分页（service/collect/7/list，source = 7） -->
            <NavigationViewItem
                x:Name="FollowedArtistsItem"
                Content="关注的歌手"
                Tag="followed-artists">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="People" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!--
                紧凑栏（48px 图标轨）里的「创建的歌单」入口。

                ★ 判据是 IsPaneOpen，**不是 DisplayMode** —— PaneDisplayMode=Left 时
                  DisplayMode 恒为 Expanded（WinUI 源码 UpdateAdaptiveLayout 里写死），
                  收起态是 IsPaneOpen=false + SplitView 的 ClosedCompact。
                  见 UpdateSidebarPaneMode。

                ★ SelectsOnInvoked=False：否则点一下这颗图标会被选成高亮，
                  而且 Nav.SelectedItem 会指到它，跟 SyncSelection 打架。

                ★ 展开时整项收起。用 Visibility 而不是增删 MenuItems：菜单内容的高度喂给
                  SyncPlaylistSectionHeight，增删单项会让那次计算在两态之间摆动。

                ★ 点它不弹 Flyout，而是开关下面那个自绘浮层（PlaylistsOverlay）：
                  Flyout 只能贴在触发元素旁边，做不到「贴窗口左边缘、铺满侧栏高、压住收起栏」。
            -->
            <NavigationViewItem
                x:Name="CompactPlaylistsItem"
                AutomationProperties.AutomationId="PlaylistsRailItem"
                AutomationProperties.Name="创建的歌单"
                Content="创建的歌单"
                SelectsOnInvoked="False"
                Tag="playlists-rail"
                ToolTipService.ToolTip="创建的歌单"
                Visibility="Collapsed">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="MusicInfo" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!--
            「创建的歌单」整段放在面板页脚里。

            ★ 为什么放这里：PaneFooter 对应模板里的 FooterContentBorder，它在
              ItemsContainerGrid 的第 2 行（Auto），**不在 MenuItemsScrollViewer 里**
              （WinUI 模板 generic.xaml 的 ItemsContainerGrid 四行 = *(菜单,可滚) /
              Auto(分隔线) / Auto(页脚) / Auto(页脚项)）。固定导航项留在 MenuItems，
              所以滚的只有歌单列表，侧栏整体不出滚动条 —— 这就是本次要的形态。

            ★ 高度由代码给（SyncPlaylistSectionHeight）：页脚这一行是 Auto，内容多高就多高，
              NavigationView 不会替我们算上限。按自然高度排版的话，歌单一多这段会把菜单区顶掉、
              自己溢出面板底部被裁掉。代码给的高度 =「菜单内容之下到面板底」，
              于是歌单少时这段紧跟在固定项下方（脚下留白），歌单多时列表在段内滚动。

            ★ 紧凑栏下这段会被压进 48px 并裁切（上游 issue #10415 未修），
              所以由 UpdateSidebarPaneMode 在收起时整段藏起来，换成轨上那颗图标。
        -->
        <NavigationView.PaneFooter>
            <Grid x:Name="PlaylistSection" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- 标题 -->
                    <RowDefinition Height="Auto" />
                    <!-- 列表：吃剩下的高度，自己滚 -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    分组头沿用菜单区那两个的样式：NavigationViewItemHeader 是按类型挂的隐式样式，
                    搬到这里观感、缩进与「我的音乐」完全一致。
                -->
                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <NavigationViewItemHeader x:Name="CreatedHeader" Content="创建的歌单" />

                    <!--
                        刷新与新建。样式跟浮层那颗 ✕ 是同一套（28×28、透明底、无边框）。
                        刷新在前、新建在后：次要动作靠里，主要动作靠外。

                        ★ 宽度交给 Grid 的 * 列，不写死：标题长了两颗按钮也不会被挤掉。
                    -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            x:Name="RefreshPlaylistsButton"
                            Width="28"
                            Height="28"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            AutomationProperties.Name="刷新歌单"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnRefreshPlaylistsClick"
                            CornerRadius="{StaticResource RadiusSm}"
                            IsEnabled="{x:Bind _sidebar.CanRefresh, Mode=OneWay}"
                            ToolTipService.ToolTip="刷新">
                            <controls:Icon Size="12" Data="{StaticResource IconRefresh}" />
                        </Button>

                        <Button
                            x:Name="CreatePlaylistButton"
                            Width="28"
                            Height="28"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            AutomationProperties.Name="新建歌单"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCreatePlaylistClick"
                            CornerRadius="{StaticResource RadiusSm}"
                            ToolTipService.ToolTip="新建歌单">
                            <controls:Icon Size="12" Data="{StaticResource IconAdd}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <controls:SidebarPlaylistList
                    x:Name="FooterPlaylistList"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="SidebarPlaylistList"
                    AutomationProperties.Name="创建的歌单"
                    ErrorText="{x:Bind _sidebar.ErrorText, Mode=OneWay}"
                    ItemsSource="{x:Bind _sidebar.Playlists, Mode=OneWay}"
                    PlaylistInvoked="OnSidebarPlaylistInvoked"
                    RetryRequested="OnPlaylistsRetryRequested" />
            </Grid>
        </NavigationView.PaneFooter>

        <!-- 页面宿主与侧栏从同一行开始；搜索入口统一放在上方标题栏。 -->
        <ContentControl
            x:Name="PageHost"
            controls:Motion.ClipToBounds="True"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
        </NavigationView>

        <!--
            播放条常驻，不随页面切换重建。
            **放在根 Grid 而不是 NavigationView 的 Content 里** —— 这样它横跨整个窗口宽度，
            侧栏在它上方结束。见文件头对布局形态的说明。
        -->
        <ContentControl
            x:Name="PlayerHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />


        <ContentControl
            x:Name="ImmersiveHost"
            Grid.RowSpan="3"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <Canvas x:Name="CoverMotionOverlay" Grid.RowSpan="3" IsHitTestVisible="False" />
        <Border x:Name="ThemeTransitionVeil" Grid.RowSpan="3" IsHitTestVisible="False" />
        <!--
            播放队列抽屉。

            **只跨第 1 行**：盖在内容区之上、播放条之下 —— 拉着队列调整顺序时播放条还在，
            要暂停 / 切歌不用先收起抽屉。上面那行标题栏也保留，搜索框还能用。

            空白处点一下收起，Esc 也收（见 OnShellKeyDown），右上角另有收起按钮。

            ★ **放在 ImmersiveHost 之后**（即抽屉压在歌词页之上）。
              2026-10-04 之前是反过来的 —— 那时只有播放条能开抽屉，而歌词页盖住整个窗口，
              抽屉开在下面也没人看得见。现在歌词页自己的传输组也有队列按钮了，
              再让它排在下面就是「点了没反应」。

            ★ 背景用 CommentPanelBackgroundBrush 而不是 ThemeFlyoutBackground：两者现在都是实色
              （#FAFBFD / #FAFAFA），但后者是弹层底色、靠外圈阴影与描边分层，而这条抽屉铺满
              窗口一整侧，与评论抽屉同源更合适（理由也在那边：
              「实色面板保证封面颜色和动态背景不会透过正文」）。
              2026-10-04 之前 ThemeFlyoutBackground 还是 #CC 半透明，那时这条是必需的。

            ★ **四角全圆、离窗口边留出边距**，是一张浮起来的卡片，不是贴边的侧板：
              贴边那种只有左侧圆角，右下两侧顶在窗口边上，视觉上更像把内容区切了一刀。
              边距与评论抽屉同量级（右 12）。
        -->
        <Grid
            x:Name="QueueOverlay"
            Grid.Row="1"
            Visibility="{x:Bind local:Formats.Visible(Queue.IsOpen), Mode=OneWay}">
            <Rectangle Fill="Transparent" Tapped="OnQueueDismissTapped" />
            <Border
                x:Name="QueuePane"
                Width="380"
                Margin="0,8,12,12"
                HorizontalAlignment="Right"
                Background="{ThemeResource CommentPanelBackgroundBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16"
                RequestedTheme="{x:Bind Theme.RequestedTheme, Mode=OneWay}">
                <!-- 队列内容按需创建，关闭时释放已实现的列表容器。 -->
            </Border>
        </Grid>

        <!--
            收起侧栏时「创建的歌单」的浮层：点轨上那颗图标开关。

            ★ 与右侧的播放队列抽屉是**一套东西照镜子**：同样是浮起来的圆角卡片、
              同样离窗口边留白、同样只跨第 1 行（到播放条上沿为止，不盖播放条）。
              右边那张是 QueueOverlay，这边这张是它。

            ★ 自绘浮层而不是 Flyout：Flyout 只能贴在触发元素旁边、尺寸也随内容走，
              给不了「固定宽度 + 定在左侧 + 圆角卡片」这套形态。

            ★ 左边距要让开图标轨（48 + 8），不然会把收起栏整个盖住 —— 盖住以后
              那颗图标就点不着，也没法看出自己是从哪儿弹出来的。

            ★ 背景必须实色（CommentPanelBackgroundBrush）：面板压在内容区上，
              半透明会把底下的正文透出来。理由同 QueuePane。

            ★ 行用 PlaylistListView —— 与「收藏的歌单」页是同一个控件，48 封面那套行，
              380 宽放得下名称与曲目数。放 ImmersiveHost 之前：全屏歌词页要盖住它。
        -->
        <Grid
            x:Name="PlaylistsOverlay"
            Grid.Row="1"
            Visibility="Collapsed">
            <Rectangle Fill="Transparent" Tapped="OnPlaylistsDismissTapped" />
            <Border
                x:Name="PlaylistsPane"
                AutomationProperties.AutomationId="PlaylistsPane"
                AutomationProperties.Name="创建的歌单"
                Width="{StaticResource SizePlaylistPaneWidth}"
                Margin="56,8,0,12"
                HorizontalAlignment="Left"
                Background="{ThemeResource CommentPanelBackgroundBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16"
                RequestedTheme="{x:Bind Theme.RequestedTheme, Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <NavigationViewItemHeader Content="创建的歌单" />

                        <!--
                            与展开态标题行同一组按钮，顺序也一致（刷新 · 新建 · 收起）。
                            三颗 28 宽加间距约 88，浮层 380 宽放得下。
                        -->
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Button
                                Width="28"
                                Height="28"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                AutomationProperties.AutomationId="PaneRefreshPlaylistsButton"
                                AutomationProperties.Name="刷新歌单"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnRefreshPlaylistsClick"
                                CornerRadius="{StaticResource RadiusSm}"
                                IsEnabled="{x:Bind _sidebar.CanRefresh, Mode=OneWay}"
                                ToolTipService.ToolTip="刷新">
                                <controls:Icon Size="12" Data="{StaticResource IconRefresh}" />
                            </Button>

                            <Button
                                Width="28"
                                Height="28"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                AutomationProperties.AutomationId="PaneCreatePlaylistButton"
                                AutomationProperties.Name="新建歌单"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnCreatePlaylistClick"
                                CornerRadius="{StaticResource RadiusSm}"
                                ToolTipService.ToolTip="新建歌单">
                                <controls:Icon Size="12" Data="{StaticResource IconAdd}" />
                            </Button>

                            <!--
                                收起按钮。与播放队列抽屉那颗同一种写法。
                                ★ 必须有：外面的透明遮罩只铺第 1 行，点播放条或标题栏是收不掉的，
                                  没有这颗按钮就只剩 Esc 与再点一次图标两条路，太难发现。
                            -->
                            <Button
                                Width="28"
                                Height="28"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                AutomationProperties.Name="收起歌单浮层"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnPlaylistsCloseClick"
                                CornerRadius="{StaticResource RadiusSm}"
                                ToolTipService.ToolTip="收起">
                                <controls:Icon Size="12" Data="{StaticResource IconDismiss}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <controls:PlaylistListView
                        x:Name="PanePlaylistList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind _sidebar.Playlists, Mode=OneWay}"
                        PlaylistInvoked="OnPanePlaylistInvoked" />

                    <HyperlinkButton
                        x:Name="PaneRetryRow"
                        Grid.Row="1"
                        Margin="8,2,8,4"
                        Padding="0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Click="OnPaneRetryClick"
                        Content="歌单加载失败，点击重试"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
        <!-- 非模态浮层：搜索框保留键盘焦点，外部指针事件继续交给原控件。 -->
        <Border
            x:Name="SearchPanel"
            Grid.RowSpan="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Padding="6"
            Background="{ThemeResource ThemeFlyoutBackground}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}"
            RequestedTheme="{x:Bind Theme.RequestedTheme, Mode=OneWay}">
            <ScrollViewer Margin="10" MaxHeight="500" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <HyperlinkButton
                        Content="{x:Bind Search.HotWordsStatus, Mode=OneWay}"
                        Click="OnSearchHotWordsRetry"
                        HorizontalAlignment="Left"
                        FontWeight="SemiBold"
                        Padding="0" />
                    <ListView
                        MaxHeight="240"
                        ItemsSource="{x:Bind Search.HotWords}"
                        IsItemClickEnabled="True"
                        ItemClick="OnSearchHotWordClick"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchHotWord">
                                <Grid Padding="4,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Rank}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Keyword}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="搜索历史" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="清空" Command="{x:Bind Search.ClearSearchHistoryCommand}" />
                    </Grid>
                    <TextBlock Text="暂无搜索历史" Visibility="{x:Bind Search.HistoryIsEmpty, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView
                        MaxHeight="160"
                        ItemsSource="{x:Bind Search.SearchHistory}"
                        IsItemClickEnabled="True"
                        ItemClick="OnSearchHistoryClick"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Padding="4,6" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--
            浮层通知条。全应用唯一的短提示出口，状态与队列在 NotificationViewModel 里。

            ★ **自绘，不用 InfoBar**：那个组件的模板是照「页面内横幅」做的 ——
              最小高 48、图标上下各留 16、关闭按钮 38，加起来约 52 高，
              而这些几何在模板里是 `{StaticResource}`（解析时就锁死在模板自己的作用域里），
              实例级覆写不生效，想瘦也瘦不下来。这里三个部件仍然都是原生控件。
              2026-10-05 之前是 InfoBar，取舍过程见 ui-refresh.md §28。

            ★ 排在 ShellRoot 的最后一个子元素位置上，**压在 ImmersiveHost 之上** ——
              歌词页与 MV 页盖满整窗，通知条排它们前面就看不见了。

            ★ 挂**第 1 行（内容区）的底部**，而不是第 2 行往上挪负边距：这样不依赖
              SizePlayerBar 那个常量，播放条将来改高度，通知条不会跟着错位。

            ★ **不铺全屏透明遮罩**（QueueOverlay 那种）：通知条不该吃掉指针事件。
        -->
        <Border
            x:Name="NotificationBar"
            Grid.Row="1"
            Margin="0,0,0,12"
            MaxWidth="520"
            Padding="12,6,6,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="通知"
            Background="{ThemeResource CommentPanelBackgroundBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}"
            RequestedTheme="{x:Bind Theme.RequestedTheme, Mode=OneWay}"
            Visibility="{x:Bind local:Formats.Visible(Notifications.IsOpen), Mode=OneWay}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    等级：一颗圆点，三颗叠在同一格里按等级选一颗显示。

                    ★ 拆成三颗而不是一颗动态换色：画刷必须走 `{ThemeResource}` 才能在切主题时
                      重新求值，而函数绑定/转换器只在源属性变化时跑一次 —— 那种写法切完主题
                      会留一个过期颜色。
                -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind local:Formats.Visible(Notifications.IsInformational), Mode=OneWay}" />
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Visibility="{x:Bind local:Formats.Visible(Notifications.IsSuccess), Mode=OneWay}" />
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind local:Formats.Visible(Notifications.IsError), Mode=OneWay}" />
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeBody}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    MaxLines="2"
                    Text="{x:Bind Notifications.Message, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords" />

                <Button
                    Grid.Column="2"
                    Width="22"
                    Height="22"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="关闭通知"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnNotificationCloseClick"
                    CornerRadius="{StaticResource RadiusSm}"
                    ToolTipService.ToolTip="关闭">
                    <controls:Icon Size="10" Data="{StaticResource IconDismiss}" />
                </Button>
            </Grid>
        </Border>

        <!--
            系统托盘。

            ★ 为什么挂在这里而不是 App.xaml 的资源字典：TaskbarIcon 是 FrameworkElement，
              必须有**已加载的 XAML 树**与带 DispatcherQueue 的 UI 线程。App.xaml 的资源在
              任何窗口存在之前就被解析 —— 那正是这个库那批
              "Failed to assign to property" / COMException 报告的共同来源。

            ★ 为什么不用独立隐藏窗口：那是给**没有主窗口**的应用用的形态。我们的主窗口因为
              「关闭到托盘」永不销毁，控件寿命 == 进程寿命，多一个 XAML 岛只换来不确定性。

            ★ 它没有视觉，跨三行只为不占位；IsHitTestVisible=False 是必须的 ——
              否则这个横跨三行的元素会挡住整个窗口的命中测试。

            ★ 真退出时必须在 MainWindow 的 Closed 里显式 Tray.Dispose()，见 MainWindow.xaml.cs。
        -->
        <tb:TaskbarIcon
            x:Name="Tray"
            Grid.RowSpan="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            ToolTipText="{x:Bind local:Formats.AppName}"
            NoLeftClickDelay="True"
            LeftClickCommand="{x:Bind ShowMainWindowCommand}"
            ContextMenuMode="SecondWindow">

            <!--
                ★ 托盘图标**不写在这里，在 code-behind 里赋 Tray.Icon**，见 ConfigureTitleBar。

                  踩过的坑：先试的是 IconSource（类型是 ImageSource，库内部渲染成 PNG 再由
                  PngToIcoConverter 转成 ICO）。那条路对 GeneratedIconSource 这种矢量源有效，
                  对 BitmapImage 不行 —— 它是异步解码的，库在属性变更那一刻就去渲染，
                  图还没加载出来，转出来是一张**全透明**的 ICO，表现成「托盘上什么都没有」。
                  Tray.Icon 收 System.Drawing.Icon，直接读 .ico 文件，没有中间转换。

                  托盘图标由 shell 绘制、不跟随应用主题，所以固定用深色版。
            -->

            <!--
                SecondWindow 使用库的透明窗口显示 WinUI 菜单，保留托盘项的 Body 模板。
                三个并排播放按钮通过 TrayMenuItem 的内容模板实现。

                PopupMenu 将标准项转换成 Win32 菜单，不理解自定义 Body；若切回它，
                还需要恢复标准项的 Text 和 Command，不能只改 ContextMenuMode。
                菜单内连续操作由共享模板的指针处理实现，具体约定见 docs/tray.md §5。
            -->
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>

                    <!--
                        ★★ 这一整颗菜单**没有任何一项依赖"菜单即将弹出"事件**。

                        该库把 TrayContextMenuOpen / TrayPopupOpen 这些事件在编译期关掉了
                        （WinRTEvents 默认关闭，实测 2.4.1 的二进制里连 add_TrayContextMenuOpen
                        访问器都不存在，只剩一个 OnTrayContextMenuOpen 方法名）。所以拿不到
                        「弹出前刷一遍状态」的钩子。

                        替代方案是全程 x:Bind OneWay：菜单项的属性随时是最新的，库在弹出那一刻
                        读到的就是新值。这也让「主界面改了模式，托盘选中项跟着变」不需要任何接线。

                        ★ 每一项都套 TrayMenuItemStyle（自写模板，见 ShellRoot.Resources）。
                          框架模板里只画 TextBlock、**没有 ContentPresenter**，不换模板就塞不进
                          自定义内容，也就做不到「三个图标一行」。换掉之后图标一律用
                          Controls/Icon 放在**内容里**，不走 MenuFlyoutItem.Icon
                          （那条要求 IconElement，还得绕 Geometry）。
                    -->

                    <!--
                        顶部「正在播放」行。不可点，只作标题。

                        ★ MaxWidth + 省略号是为了**压住菜单宽度**：菜单按最宽的那一项撑开，
                          曲名一长，下面那些短行右边就空出一大片。限宽之后整颗菜单窄下来。
                    -->
                    <controls:TrayMenuItem Style="{StaticResource TrayMenuItemStyle}" IsEnabled="False">
                        <controls:TrayMenuItem.Body>
                            <Grid Margin="8,6,8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:Icon
                                    Grid.Column="0"
                                    Data="{StaticResource IconNote}"
                                    Size="16"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <!--
                                    ★ 用 * 列而不是 StackPanel：横向 StackPanel 给子元素的是
                                      无限宽，TextBlock 会按自己的需要撑开、把整行顶出去；
                                      * 列才会把剩余宽度**约束**给文字，省略号也才真的生效。
                                -->
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Text="{x:Bind Player.NowPlayingText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </controls:TrayMenuItem.Body>
                    </controls:TrayMenuItem>

                    <MenuFlyoutSeparator IsHitTestVisible="False" />

                    <!--
                        转台：**三个纯图标合成一行**，不放文字（与参照图一致）。

                        ★ 这正是自写模板存在的全部理由 —— 框架的 MenuFlyoutItem 一项就是一行
                          文字加一颗图标，做不到「一行三项」。

                        三个按钮的 Click 只执行播放操作，支持连续点击。
                        所有菜单项的模板统一处理点击，避免执行命令后收起菜单。
                    -->
                    <controls:TrayMenuItem Style="{StaticResource TrayMenuItemStyle}">
                        <controls:TrayMenuItem.Body>
                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="6"
                                Margin="0,2,0,2">
                                <Button
                                    Style="{StaticResource TrayTransportButtonStyle}"
                                    IsEnabled="{x:Bind Player.CanGoPrevious, Mode=OneWay}"
                                    Click="OnTrayPreviousClick"
                                    ToolTipService.ToolTip="上一首">
                                    <controls:Icon Data="{StaticResource IconPrevious}" Size="18" />
                                </Button>
                                <Button
                                    Style="{StaticResource TrayTransportButtonStyle}"
                                    Click="OnTrayPlayPauseClick"
                                    ToolTipService.ToolTip="播放 / 暂停">
                                    <controls:Icon
                                        Data="{x:Bind local:Formats.PlayPauseIcon(Player.IsPlaying), Mode=OneWay}"
                                        Size="22" />
                                </Button>
                                <Button
                                    Style="{StaticResource TrayTransportButtonStyle}"
                                    IsEnabled="{x:Bind Player.CanGoNext, Mode=OneWay}"
                                    Click="OnTrayNextClick"
                                    ToolTipService.ToolTip="下一首">
                                    <controls:Icon Data="{StaticResource IconNext}" Size="18" />
                                </Button>
                            </StackPanel>
                        </controls:TrayMenuItem.Body>
                    </controls:TrayMenuItem>

                    <MenuFlyoutSeparator IsHitTestVisible="False" />

                    <!--
                        模式子菜单。标题直接显示**当前模式**（与参照图一致：那里写的就是
                        "列表循环"），绑 Player.PlayModeText —— 那个属性由队列变化驱动，
                        所以标题与选中项天然跟着主界面走。

                        入口仍由 MenuFlyoutSubItem 处理展开和键盘导航，模板与其他主菜单项使用
                        相同外距、内距和图标列，文字统一落在 3 + 8 + 16 + 8 = 35。
                        展开的模式项使用自动宽度，不继承主菜单的固定宽度。

                        ★ CommandParameter 必须传**枚举值**，不能写 CommandParameter="Sequential"：
                          CommunityToolkit.Mvvm 8.4.2 的 RelayCommand<T> 不做 string→enum 转换，
                          传字符串会在运行时抛 ArgumentException。
                    -->
                    <MenuFlyoutSubItem Style="{StaticResource TrayMenuSubItemStyle}" Text="{x:Bind Player.PlayModeText, Mode=OneWay}">
                        <MenuFlyoutSubItem.Icon>
                            <PathIcon Data="{x:Bind local:Formats.IconGeometryFor('IconListLoop')}" />
                        </MenuFlyoutSubItem.Icon>

                        <!--
                            ★ 选中态**用背景表示，不用勾**。

                            写法是「一层铺满的 Border + 上层带 Margin 的文字」：Border 不设
                            Margin 就填满整行（它上面那层 Grid 已随模板撑满），文字自己带
                            Margin 撑出行高 —— 这样即使 Border 收起来，行高也不变。
                            画刷用 SubtleFillColorSecondaryBrush，与悬停是同一个 ——
                            选中项被鼠标划过时不会突兀地变样。
                        -->
                        <controls:TrayMenuItem
                            Style="{StaticResource TrayPlayModeItemStyle}"
                            Command="{x:Bind Player.SetPlayModeCommand}"
                            CommandParameter="{x:Bind models:PlayMode.Sequential}">
                            <controls:TrayMenuItem.Body>
                                <Grid>
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Visibility="{x:Bind local:Formats.Visible(Player.IsSequentialMode), Mode=OneWay}" />
                                    <TextBlock Text="顺序播放" Margin="8,6,8,6" VerticalAlignment="Center" />
                                </Grid>
                            </controls:TrayMenuItem.Body>
                        </controls:TrayMenuItem>

                        <controls:TrayMenuItem
                            Style="{StaticResource TrayPlayModeItemStyle}"
                            Command="{x:Bind Player.SetPlayModeCommand}"
                            CommandParameter="{x:Bind models:PlayMode.ListLoop}">
                            <controls:TrayMenuItem.Body>
                                <Grid>
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Visibility="{x:Bind local:Formats.Visible(Player.IsListLoopMode), Mode=OneWay}" />
                                    <TextBlock Text="列表循环" Margin="8,6,8,6" VerticalAlignment="Center" />
                                </Grid>
                            </controls:TrayMenuItem.Body>
                        </controls:TrayMenuItem>

                        <controls:TrayMenuItem
                            Style="{StaticResource TrayPlayModeItemStyle}"
                            Command="{x:Bind Player.SetPlayModeCommand}"
                            CommandParameter="{x:Bind models:PlayMode.Shuffle}">
                            <controls:TrayMenuItem.Body>
                                <Grid>
                                    <Border
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        Visibility="{x:Bind local:Formats.Visible(Player.IsShuffleMode), Mode=OneWay}" />
                                    <TextBlock Text="列表随机" Margin="8,6,8,6" VerticalAlignment="Center" />
                                </Grid>
                            </controls:TrayMenuItem.Body>
                        </controls:TrayMenuItem>
                    </MenuFlyoutSubItem>

                    <MenuFlyoutSeparator IsHitTestVisible="False" />

                    <!--
                        两个窗口开关。选中态直接绑各自的 IsEnabled —— 小窗与桌面歌词窗的显隐
                        本来就由这个开关驱动（见 MiniPlayerWindowHost / DesktopLyricsWindowHost），
                        所以这里不需要额外同步，也不该多存一份状态。
                    -->
                    <controls:TrayMenuItem Style="{StaticResource TrayMenuItemStyle}" Command="{x:Bind MiniPlayer.ToggleCommand}">
                        <controls:TrayMenuItem.Body>
                            <Grid>
                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Visibility="{x:Bind local:Formats.Visible(MiniPlayer.IsEnabled), Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,6,8,6">
                                    <controls:Icon Data="{StaticResource IconMiniPlayer}" Size="16" VerticalAlignment="Center" />
                                    <TextBlock Text="mini窗口" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </controls:TrayMenuItem.Body>
                    </controls:TrayMenuItem>

                    <controls:TrayMenuItem Style="{StaticResource TrayMenuItemStyle}" Command="{x:Bind DesktopLyrics.ToggleCommand}">
                        <controls:TrayMenuItem.Body>
                            <Grid>
                                <Border
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Visibility="{x:Bind local:Formats.Visible(DesktopLyrics.IsEnabled), Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,6,8,6">
                                    <controls:Icon Data="{StaticResource IconLyrics}" Size="16" VerticalAlignment="Center" />
                                    <TextBlock Text="桌面歌词" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </controls:TrayMenuItem.Body>
                    </controls:TrayMenuItem>

                    <MenuFlyoutSeparator IsHitTestVisible="False" />

                    <!--
                        退出 = 唯一真正结束进程的入口。它只置一个位再关窗口，
                        走的是 App 在 OnLaunched 里挂的那条清理串（桌面歌词窗 → 小窗 → SMTC →
                        播放引擎 → 容器），一行都没有重复实现。
                    -->
                    <controls:TrayMenuItem Style="{StaticResource TrayMenuItemStyle}" Command="{x:Bind ExitAppCommand}">
                        <controls:TrayMenuItem.Body>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,6,8,6">
                                <controls:Icon Data="{StaticResource IconExit}" Size="16" VerticalAlignment="Center" />
                                <TextBlock Text="退出" VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:TrayMenuItem.Body>
                    </controls:TrayMenuItem>

                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
    </controls:ResponsiveViewport>
</Window>
