<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Bodian.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    xmlns:models="using:Bodian.Core.Models"
    Title="波点音乐">

    <!--
        外壳 = 自定义标题栏（第 0 行）+ 侧栏 / 内容区（第 1 行）+ 通栏播放条（第 2 行）。

        ★ 播放条**通栏**，横跨整个窗口宽度，所以侧栏不再到窗口底部。
          这是刻意改的：早先的做法是把播放条塞进 NavigationView 的 Content，
          让侧栏从顶到底（模仿官方 PC 端）。但那样播放条不横跨侧栏，
          与用户对播放器的预期不符 —— 现在按 Spotify / Apple Music 的形态来。

        ★ IsBackButtonVisible=Collapsed：返回栈是自己的（INavigationService），
          返回入口统一放在搜索框左侧。交给 NavigationView 会多出一个不受控的按钮。

        ★ 用 ItemInvoked 而不是 SelectionChanged：SelectionChanged 在我们自己
          同步高亮时也会触发，会和导航互相打架。ItemInvoked 只在用户点击时触发。
    -->
    <!--
        ★ RequestedTheme 必须设在最外层这个 Grid 上，**不能设在里面的 NavigationView 上**。
          设在 NavigationView 上时只有它自己的子树跟随主题，窗口底色的那层就漏掉了 ——
          主题无关的兄弟节点会一直用浅色，深色模式下整个窗口变成一片白。实测踩过。

        ★ 底色也必须自己铺：NavigationView 的面板是 AcrylicBrush、内容区是半透明层刷，
          两者都假定自己叠在 Mica 背板上。本应用不设背板（氛围渐变才是背景），
          没有东西可叠时深色下面板会退回浅色，白字压白底 —— 导航项整个看不见。
          见 Themes/Theme.xaml 里 AppSurfaceBrush 的说明。

        ★ 不能用 Application.RequestedTheme：那个只能在窗口创建之前设，
          运行期改会抛异常。所以运行期切换只能走元素级。
    -->
    <controls:ResponsiveViewport x:Name="WindowViewport">
    <Grid x:Name="ShellRoot" RequestedTheme="{x:Bind Theme.RequestedTheme, Mode=OneWay}">
        <Grid.RowDefinitions>
            <!-- 顶部：原生自定义标题栏，复用原系统标题栏区域 -->
            <RowDefinition Height="Auto" />
            <!-- 中间：侧栏 + 内容区，顶边齐平 -->
            <RowDefinition Height="*" />
            <!-- 下：播放条。**通栏**，横跨侧栏与内容区 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            底色层与氛围渐变层都要**跨三行**：只铺内容区的话，播放条那一带会露出纯色，
            与上面的渐变之间出现一条硬边。
        -->
        <Border Grid.RowSpan="3" Background="{ThemeResource AppSurfaceBrush}" />
        <controls:AmbientBackdrop x:Name="ShellBackdrop" Grid.RowSpan="3" />

        <!--
            原生 TitleBar 负责拖动区与交互控件避让，系统 caption 按钮仍由 Windows 管理。
            左上角预留与展开侧栏等宽的 Logo 区域；收起按钮留在下方 NavigationView。
            高度与原生 Tall caption 一致，搜索框、账号、主题和窗口按钮沿同一中心线。
        -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="{StaticResource SizeTopBar}"
            Background="Transparent"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            AutomationProperties.Name="波点音乐标题栏">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <x:Double x:Key="TitleBarExpandedHeight">48</x:Double>
                <x:Double x:Key="TitleBarLeftPaddingWidth">0</x:Double>
                <x:Double x:Key="TitleBarLeftHeaderPaddingWidth">0</x:Double>
                <Thickness x:Key="TitleBarCompactContentMargin">0</Thickness>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.LeftHeader>
                <!-- 暂无图案：保留 Logo 插槽，后续可在此挂载设计好的资源。 -->
                <Border
                    x:Name="LogoHost"
                    Width="{StaticResource SizeSidebarWidth}"
                    Height="32"
                    Padding="24,0"
                    IsHitTestVisible="False" />
            </TitleBar.LeftHeader>
            <TitleBar.Content>
                <!-- 搜索宽度随可用空间收缩，并限制最大宽度以保留标题栏留白。 -->
                <Grid x:Name="SearchBarHost" Margin="24,0,24,0" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="400" />
                    </Grid.ColumnDefinitions>
                    <!--
                        ★ 尺寸与底色照抄右侧的 ThemeButton / AccountButton，**不要**给按钮套
                          ContentControl 外壳，也不要用 SubtleButtonStyle：那个样式的
                          HorizontalAlignment=Left，外壳上的 Stretch 拉不住它，按钮会缩回图标
                          自身的宽度（悬停背景比图标还小）。显式给 32×32 才是整块可点、整块出底色。
                    -->
                    <Button
                        x:Name="BackButton"
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        CornerRadius="8"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        IsEnabled="{x:Bind _navigation.CanGoBack, Mode=OneWay}"
                        Click="OnBackClick"
                        AutomationProperties.Name="返回上一级"
                        ToolTipService.ToolTip="返回上一级">
                        <Button.Resources>
                            <!--
                                ★ 默认模板的 Disabled 态会把背景铺成 ButtonBackgroundDisabled，
                                  盖住上面那句 Background="Transparent" —— 症状是「能点的时候没底色、
                                  不能点的时候反而有底色」。把它连同描边一起置空，
                                  禁用只体现在前景色变淡（那才是这个按钮该有的反馈）。
                                  旁边的主题 / 账号按钮没有 IsEnabled 绑定，所以从来没露过这个问题。
                            -->
                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                        </Button.Resources>
                        <controls:Icon Size="{StaticResource SizeIconSm}" Data="{StaticResource IconBack}" />
                    </Button>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        PlaceholderText="搜索单曲、歌单、专辑、歌手"
                        QueryIcon="Find"
                        QuerySubmitted="OnSearchQuerySubmitted"
                        TextChanged="OnSearchTextChanged"
                        GotFocus="OnSearchGotFocus"
                        ItemsSource="{x:Bind Search.Suggestions, Mode=OneWay}"
                        Text="{x:Bind Search.Keyword, Mode=TwoWay}"
                        AutomationProperties.Name="搜索单曲、歌单、专辑、歌手" />

                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="AccountButton"
                        Visibility="Collapsed"
                        AutomationProperties.Name="账号"
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        VerticalAlignment="Center"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="{x:Bind Account.AccountText, Mode=OneWay}">
                        <Border
                            Width="24"
                            Height="24"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="12">
                            <Image Source="{x:Bind Account.Avatar, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>

                        <Button.Flyout>
                            <!-- 正下方居中，与主题弹层一致。之前用 BottomEdgeAlignedRight，
                                 弹窗比头像按钮宽得多，右对齐会把整块甩到头像左边去。 -->
                            <Flyout Opening="OnAccountFlyoutOpening" Placement="Bottom">
                                <StackPanel MinWidth="200" Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border
                                            Width="32"
                                            Height="32"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            CornerRadius="16">
                                            <Image Source="{x:Bind Account.Avatar, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind Account.AccountText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!--
                                                会员徽标只是展示：播放权限一律以服务端 checkRight 为准。
                                                胶囊 = 图标 + 档位名，按档位三选一，每档一套配色（金 / 银 / 浅绿，
                                                见 Themes/VipBadge.xaml）；非会员三个都不显示。

                                                ★ 图标必须是 Path 而不是 PathIcon：PathIcon 按几何的原始尺寸
                                                  出图，不缩放到 Width/Height，超出部分会被裁掉（皇冠会只剩一半）。
                                                  Path 的 Stretch 才真的缩放。写法同 SongCommentsPanel.xaml。
                                            -->
                                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                <!-- 大会员：金，皇冠 + 顶星 -->
                                                <Border
                                                    Padding="6,2"
                                                    Background="{ThemeResource VipBadgeBigBackgroundBrush}"
                                                    CornerRadius="10"
                                                    Visibility="{x:Bind Account.BigVipVisibility, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Path
                                                            Width="11"
                                                            Height="13"
                                                            VerticalAlignment="Center"
                                                            Data="M 2,9 L 6,13.5 L 10,7 L 14,13.5 L 18,9 L 16.5,21 L 3.5,21 Z M 10,0.1 L 10.85,2.33 L 13.23,2.45 L 11.38,3.95 L 12,6.25 L 10,4.95 L 8,6.25 L 8.62,3.95 L 6.77,2.45 L 9.15,2.33 Z"
                                                            Fill="{ThemeResource VipBadgeBigForegroundBrush}"
                                                            Stretch="Uniform" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource VipBadgeBigForegroundBrush}"
                                                            Text="{x:Bind Account.VipKindLabel, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- 畅听会员：银，三尖皇冠 -->
                                                <Border
                                                    Padding="6,2"
                                                    Background="{ThemeResource VipBadgeStandardBackgroundBrush}"
                                                    CornerRadius="10"
                                                    Visibility="{x:Bind Account.StandardVipVisibility, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Path
                                                            Width="15"
                                                            Height="13"
                                                            VerticalAlignment="Center"
                                                            Data="M 2,5 L 6,9.5 L 10,3 L 14,9.5 L 18,5 L 16.5,17 L 3.5,17 Z"
                                                            Fill="{ThemeResource VipBadgeStandardForegroundBrush}"
                                                            Stretch="Uniform" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource VipBadgeStandardForegroundBrush}"
                                                            Text="{x:Bind Account.VipKindLabel, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- 福利会员：浅绿，礼物盒 -->
                                                <Border
                                                    Padding="6,2"
                                                    Background="{ThemeResource VipBadgeWelfareBackgroundBrush}"
                                                    CornerRadius="10"
                                                    Visibility="{x:Bind Account.WelfareVipVisibility, Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <Path
                                                            Width="15"
                                                            Height="13"
                                                            VerticalAlignment="Center"
                                                            Data="M 1.5,9 L 22.5,9 L 22.5,12.8 L 1.5,12.8 Z M 3,14.4 L 21,14.4 L 21,21 L 3,21 Z M 12,8.8 C 11,4.6 8.5,2.6 7,4 C 5.5,5.4 7.5,8.8 12,8.8 Z M 12,8.8 C 13,4.6 15.5,2.6 17,4 C 18.5,5.4 16.5,8.8 12,8.8 Z"
                                                            Fill="{ThemeResource VipBadgeWelfareForegroundBrush}"
                                                            Stretch="Uniform" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource VipBadgeWelfareForegroundBrush}"
                                                            Text="{x:Bind Account.VipKindLabel, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Border>

                                                <!--
                                                    到期时间：胶囊同一行的小字。
                                                    数据来自登录响应 payInfo 的到期字段（取最晚的一个，见 VipStatus.LatestExpiry），
                                                    **不需要额外接口**；老凭据里没存时整块收掉。
                                                -->
                                                <TextBlock
                                                    Margin="6,0,0,0"
                                                    FontSize="11"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Account.VipExpiryText, Mode=OneWay}"
                                                    Visibility="{x:Bind Account.VipExpiryVisibility, Mode=OneWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--
                                        账号统计：关注数 / 听歌总时长。两条接口各自独立，谁先回来谁先显示；
                                        两个都拿不到时整块收掉，不留一行「—  —」。
                                    -->
                                    <Grid ColumnSpacing="16" Visibility="{x:Bind Account.StatsVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Account.FollowedArtistCountText, Mode=OneWay}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="关注歌手" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Account.ListenTimeText, Mode=OneWay}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="听歌时长" />
                                        </StackPanel>
                                    </Grid>

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind Account.SignOutCommand}"
                                        Content="退出登录"
                                        ToolTipService.ToolTip="清除本机保存的会话，回到扫码登录" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Name="ThemeButton"
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="{x:Bind Theme.CurrentLabel, Mode=OneWay}"
                        AutomationProperties.Name="切换主题">
                        <controls:Icon Size="{StaticResource SizeIconSm}"
                            Data="{x:Bind local:Formats.IconPaths(Theme.CurrentIcon), Mode=OneWay}" />
                        <Button.Flyout>
                            <Flyout Opening="OnThemeFlyoutOpening" Placement="Bottom">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Background" Value="{ThemeResource ThemeFlyoutBackground}" />
                                        <Setter Property="Padding" Value="6" />
                                        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <!-- 竖排单选列表：仅以背景表示选中，隐藏圆点、勾选和强调线。 -->
                                <ListView
                                    x:Name="ThemeOptions"
                                    MinWidth="0"
                                    HorizontalAlignment="Left"
                                    SelectionMode="Single"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    AutomationProperties.Name="主题">
                                    <ListView.Resources>
                                        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                                        <x:Boolean x:Key="ListViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                                    </ListView.Resources>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="Padding" Value="10,8" />
                                            <Setter Property="Margin" Value="0,2" />
                                            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListViewItem x:Name="SystemThemeOption" AutomationProperties.Name="跟随系统">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <controls:Icon Size="{StaticResource SizeIconSm}" Data="{StaticResource IconThemeAuto}" />
                                            <TextBlock VerticalAlignment="Center" Text="跟随系统" />
                                        </StackPanel>
                                    </ListViewItem>
                                    <ListViewItem x:Name="LightThemeOption" AutomationProperties.Name="浅色">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <controls:Icon Size="{StaticResource SizeIconSm}" Data="{StaticResource IconThemeLight}" />
                                            <TextBlock VerticalAlignment="Center" Text="浅色" />
                                        </StackPanel>
                                    </ListViewItem>
                                    <ListViewItem x:Name="DarkThemeOption" AutomationProperties.Name="深色">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <controls:Icon Size="{StaticResource SizeIconSm}" Data="{StaticResource IconThemeDark}" />
                                            <TextBlock VerticalAlignment="Center" Text="深色" />
                                        </StackPanel>
                                    </ListViewItem>
                                </ListView>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Border
                        Width="1"
                        Height="16"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="OnItemInvoked"
            OpenPaneLength="{StaticResource SizeSidebarWidth}"
            PaneDisplayMode="Left">

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="DiscoverItem"
                Content="发现"
                Tag="discover">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="BangsItem"
                Content="排行榜"
                Tag="bangs">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Sort" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="LibraryItem"
                Content="乐库"
                Tag="library">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="List" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItemHeader Content="我的音乐" />

            <NavigationViewItem
                x:Name="FavoritesItem"
                Content="我喜欢的"
                Tag="favorites">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Favorite" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="RecentItem"
                Content="最近播放"
                Tag="recent">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Clock" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="CollectedAlbumsItem"
                Content="收藏的专辑"
                Tag="collected-albums">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Audio" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!-- 收藏的歌单。与「收藏的专辑」是两回事（同一端点的另一半元素） -->
            <NavigationViewItem
                x:Name="CollectedPlaylistsItem"
                Content="收藏的歌单"
                Tag="collected-playlists">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="List" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!--
                紧凑栏（48px 图标轨）里的「创建的歌单」入口。

                ★ 判据是 IsPaneOpen，**不是 DisplayMode** —— PaneDisplayMode=Left 时
                  DisplayMode 恒为 Expanded（WinUI 源码 UpdateAdaptiveLayout 里写死），
                  收起态是 IsPaneOpen=false + SplitView 的 ClosedCompact。
                  见 UpdateSidebarPaneMode。

                ★ SelectsOnInvoked=False：否则点一下这颗图标会被选成高亮，
                  而且 Nav.SelectedItem 会指到它，跟 SyncSelection 打架。

                ★ 展开时整项收起。用 Visibility 而不是增删 MenuItems：菜单内容的高度喂给
                  SyncPlaylistSectionHeight，增删单项会让那次计算在两态之间摆动。

                ★ 点它不弹 Flyout，而是开关下面那个自绘浮层（PlaylistsOverlay）：
                  Flyout 只能贴在触发元素旁边，做不到「贴窗口左边缘、铺满侧栏高、压住收起栏」。
            -->
            <NavigationViewItem
                x:Name="CompactPlaylistsItem"
                AutomationProperties.AutomationId="PlaylistsRailItem"
                AutomationProperties.Name="创建的歌单"
                Content="创建的歌单"
                SelectsOnInvoked="False"
                Tag="playlists-rail"
                ToolTipService.ToolTip="创建的歌单"
                Visibility="Collapsed">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="MusicInfo" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <!--
            「创建的歌单」整段放在面板页脚里。

            ★ 为什么放这里：PaneFooter 对应模板里的 FooterContentBorder，它在
              ItemsContainerGrid 的第 2 行（Auto），**不在 MenuItemsScrollViewer 里**
              （WinUI 模板 generic.xaml 的 ItemsContainerGrid 四行 = *(菜单,可滚) /
              Auto(分隔线) / Auto(页脚) / Auto(页脚项)）。固定导航项留在 MenuItems，
              所以滚的只有歌单列表，侧栏整体不出滚动条 —— 这就是本次要的形态。

            ★ 高度由代码给（SyncPlaylistSectionHeight）：页脚这一行是 Auto，内容多高就多高，
              NavigationView 不会替我们算上限。按自然高度排版的话，歌单一多这段会把菜单区顶掉、
              自己溢出面板底部被裁掉。代码给的高度 =「菜单内容之下到面板底」，
              于是歌单少时这段紧跟在固定项下方（脚下留白），歌单多时列表在段内滚动。

            ★ 紧凑栏下这段会被压进 48px 并裁切（上游 issue #10415 未修），
              所以由 UpdateSidebarPaneMode 在收起时整段藏起来，换成轨上那颗图标。
        -->
        <NavigationView.PaneFooter>
            <Grid x:Name="PlaylistSection" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- 标题 -->
                    <RowDefinition Height="Auto" />
                    <!-- 列表：吃剩下的高度，自己滚 -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    分组头沿用菜单区那两个的样式：NavigationViewItemHeader 是按类型挂的隐式样式，
                    搬到这里观感、缩进与「我的音乐」完全一致。
                -->
                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <NavigationViewItemHeader x:Name="CreatedHeader" Content="创建的歌单" />

                    <!--
                        刷新与新建。样式跟浮层那颗 ✕ 是同一套（28×28、透明底、无边框）。
                        刷新在前、新建在后：次要动作靠里，主要动作靠外。

                        ★ 宽度交给 Grid 的 * 列，不写死：标题长了两颗按钮也不会被挤掉。
                    -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            x:Name="RefreshPlaylistsButton"
                            Width="28"
                            Height="28"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            AutomationProperties.Name="刷新歌单"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnRefreshPlaylistsClick"
                            CornerRadius="{StaticResource RadiusSm}"
                            IsEnabled="{x:Bind _sidebar.CanRefresh, Mode=OneWay}"
                            ToolTipService.ToolTip="刷新">
                            <controls:Icon Size="12" Data="{StaticResource IconRefresh}" />
                        </Button>

                        <Button
                            x:Name="CreatePlaylistButton"
                            Width="28"
                            Height="28"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            AutomationProperties.Name="新建歌单"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCreatePlaylistClick"
                            CornerRadius="{StaticResource RadiusSm}"
                            ToolTipService.ToolTip="新建歌单">
                            <controls:Icon Size="12" Data="{StaticResource IconAdd}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <controls:SidebarPlaylistList
                    x:Name="FooterPlaylistList"
                    Grid.Row="1"
                    AutomationProperties.AutomationId="SidebarPlaylistList"
                    AutomationProperties.Name="创建的歌单"
                    ErrorText="{x:Bind _sidebar.ErrorText, Mode=OneWay}"
                    ItemsSource="{x:Bind _sidebar.Playlists, Mode=OneWay}"
                    PlaylistInvoked="OnSidebarPlaylistInvoked"
                    RetryRequested="OnPlaylistsRetryRequested" />
            </Grid>
        </NavigationView.PaneFooter>

        <!-- 页面宿主与侧栏从同一行开始；搜索入口统一放在上方标题栏。 -->
        <ContentControl
            x:Name="PageHost"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
        </NavigationView>

        <!--
            播放条常驻，不随页面切换重建。
            **放在根 Grid 而不是 NavigationView 的 Content 里** —— 这样它横跨整个窗口宽度，
            侧栏在它上方结束。见文件头对布局形态的说明。
        -->
        <ContentControl
            x:Name="PlayerHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />


        <ContentControl
            x:Name="ImmersiveHost"
            Grid.RowSpan="3"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <!--
            播放队列抽屉。

            **只跨第 1 行**：盖在内容区之上、播放条之下 —— 拉着队列调整顺序时播放条还在，
            要暂停 / 切歌不用先收起抽屉。上面那行标题栏也保留，搜索框还能用。

            空白处点一下收起，Esc 也收（见 OnShellKeyDown），右上角另有收起按钮。

            ★ **放在 ImmersiveHost 之后**（即抽屉压在歌词页之上）。
              2026-10-04 之前是反过来的 —— 那时只有播放条能开抽屉，而歌词页盖住整个窗口，
              抽屉开在下面也没人看得见。现在歌词页自己的传输组也有队列按钮了，
              再让它排在下面就是「点了没反应」。

            ★ 背景用 CommentPanelBackgroundBrush 而不是 ThemeFlyoutBackground：后者是 #CC 的
              半透明，铺满一整条抽屉时底下的正文会透出来。这块实色面板与评论抽屉同源，
              理由也在那边（「实色面板保证封面颜色和动态背景不会透过正文」）。

            ★ **四角全圆、离窗口边留出边距**，是一张浮起来的卡片，不是贴边的侧板：
              贴边那种只有左侧圆角，右下两侧顶在窗口边上，视觉上更像把内容区切了一刀。
              边距与评论抽屉同量级（右 12）。
        -->
        <Grid
            x:Name="QueueOverlay"
            Grid.Row="1"
            Visibility="{x:Bind local:Formats.Visible(Queue.IsOpen), Mode=OneWay}">
            <Rectangle Fill="Transparent" Tapped="OnQueueDismissTapped" />
            <Border
                x:Name="QueuePane"
                Width="380"
                Margin="0,8,12,12"
                HorizontalAlignment="Right"
                Background="{ThemeResource CommentPanelBackgroundBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16"
                RequestedTheme="{x:Bind Theme.RequestedTheme, Mode=OneWay}">
                <controls:PlayQueuePanel
                    ClearRequested="OnClearQueueRequested"
                    CloseRequested="OnQueueCloseRequested"
                    ViewModel="{x:Bind Queue}" />
            </Border>
        </Grid>

        <!--
            收起侧栏时「创建的歌单」的浮层：点轨上那颗图标开关。

            ★ 与右侧的播放队列抽屉是**一套东西照镜子**：同样是浮起来的圆角卡片、
              同样离窗口边留白、同样只跨第 1 行（到播放条上沿为止，不盖播放条）。
              右边那张是 QueueOverlay，这边这张是它。

            ★ 自绘浮层而不是 Flyout：Flyout 只能贴在触发元素旁边、尺寸也随内容走，
              给不了「固定宽度 + 定在左侧 + 圆角卡片」这套形态。

            ★ 左边距要让开图标轨（48 + 8），不然会把收起栏整个盖住 —— 盖住以后
              那颗图标就点不着，也没法看出自己是从哪儿弹出来的。

            ★ 背景必须实色（CommentPanelBackgroundBrush）：面板压在内容区上，
              半透明会把底下的正文透出来。理由同 QueuePane。

            ★ 行用 PlaylistListView —— 与「收藏的歌单」页是同一个控件，48 封面那套行，
              380 宽放得下名称与曲目数。放 ImmersiveHost 之前：全屏歌词页要盖住它。
        -->
        <Grid
            x:Name="PlaylistsOverlay"
            Grid.Row="1"
            Visibility="Collapsed">
            <Rectangle Fill="Transparent" Tapped="OnPlaylistsDismissTapped" />
            <Border
                x:Name="PlaylistsPane"
                AutomationProperties.AutomationId="PlaylistsPane"
                AutomationProperties.Name="创建的歌单"
                Width="{StaticResource SizePlaylistPaneWidth}"
                Margin="56,8,0,12"
                HorizontalAlignment="Left"
                Background="{ThemeResource CommentPanelBackgroundBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16"
                RequestedTheme="{x:Bind Theme.RequestedTheme, Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <NavigationViewItemHeader Content="创建的歌单" />

                        <!--
                            与展开态标题行同一组按钮，顺序也一致（刷新 · 新建 · 收起）。
                            三颗 28 宽加间距约 88，浮层 380 宽放得下。
                        -->
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Button
                                Width="28"
                                Height="28"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                AutomationProperties.AutomationId="PaneRefreshPlaylistsButton"
                                AutomationProperties.Name="刷新歌单"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnRefreshPlaylistsClick"
                                CornerRadius="{StaticResource RadiusSm}"
                                IsEnabled="{x:Bind _sidebar.CanRefresh, Mode=OneWay}"
                                ToolTipService.ToolTip="刷新">
                                <controls:Icon Size="12" Data="{StaticResource IconRefresh}" />
                            </Button>

                            <Button
                                Width="28"
                                Height="28"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                AutomationProperties.AutomationId="PaneCreatePlaylistButton"
                                AutomationProperties.Name="新建歌单"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnCreatePlaylistClick"
                                CornerRadius="{StaticResource RadiusSm}"
                                ToolTipService.ToolTip="新建歌单">
                                <controls:Icon Size="12" Data="{StaticResource IconAdd}" />
                            </Button>

                            <!--
                                收起按钮。与播放队列抽屉那颗同一种写法。
                                ★ 必须有：外面的透明遮罩只铺第 1 行，点播放条或标题栏是收不掉的，
                                  没有这颗按钮就只剩 Esc 与再点一次图标两条路，太难发现。
                            -->
                            <Button
                                Width="28"
                                Height="28"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                AutomationProperties.Name="收起歌单浮层"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnPlaylistsCloseClick"
                                CornerRadius="{StaticResource RadiusSm}"
                                ToolTipService.ToolTip="收起">
                                <controls:Icon Size="12" Data="{StaticResource IconDismiss}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <controls:PlaylistListView
                        x:Name="PanePlaylistList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind _sidebar.Playlists, Mode=OneWay}"
                        PlaylistInvoked="OnPanePlaylistInvoked" />

                    <HyperlinkButton
                        x:Name="PaneRetryRow"
                        Grid.Row="1"
                        Margin="8,2,8,4"
                        Padding="0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Click="OnPaneRetryClick"
                        Content="歌单加载失败，点击重试"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
        <!-- 非模态浮层：搜索框保留键盘焦点，外部指针事件继续交给原控件。 -->
        <Border
            x:Name="SearchPanel"
            Grid.RowSpan="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Padding="6"
            Background="{ThemeResource ThemeFlyoutBackground}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}"
            RequestedTheme="{x:Bind Theme.RequestedTheme, Mode=OneWay}">
            <ScrollViewer Margin="10" MaxHeight="500" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <HyperlinkButton
                        Content="{x:Bind Search.HotWordsStatus, Mode=OneWay}"
                        Click="OnSearchHotWordsRetry"
                        HorizontalAlignment="Left"
                        FontWeight="SemiBold"
                        Padding="0" />
                    <ListView
                        MaxHeight="240"
                        ItemsSource="{x:Bind Search.HotWords}"
                        IsItemClickEnabled="True"
                        ItemClick="OnSearchHotWordClick"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchHotWord">
                                <Grid Padding="4,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Rank}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Keyword}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="搜索历史" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="清空" Command="{x:Bind Search.ClearSearchHistoryCommand}" />
                    </Grid>
                    <TextBlock Text="暂无搜索历史" Visibility="{x:Bind Search.HistoryIsEmpty, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView
                        MaxHeight="160"
                        ItemsSource="{x:Bind Search.SearchHistory}"
                        IsItemClickEnabled="True"
                        ItemClick="OnSearchHistoryClick"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Padding="4,6" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--
            浮层通知条。全应用唯一的短提示出口，状态与队列在 NotificationViewModel 里。

            ★ **自绘，不用 InfoBar**：那个组件的模板是照「页面内横幅」做的 ——
              最小高 48、图标上下各留 16、关闭按钮 38，加起来约 52 高，
              而这些几何在模板里是 `{StaticResource}`（解析时就锁死在模板自己的作用域里），
              实例级覆写不生效，想瘦也瘦不下来。这里三个部件仍然都是原生控件。
              2026-10-05 之前是 InfoBar，取舍过程见 ui-refresh.md §28。

            ★ 排在 ShellRoot 的最后一个子元素位置上，**压在 ImmersiveHost 之上** ——
              歌词页与 MV 页盖满整窗，通知条排它们前面就看不见了。

            ★ 挂**第 1 行（内容区）的底部**，而不是第 2 行往上挪负边距：这样不依赖
              SizePlayerBar 那个常量，播放条将来改高度，通知条不会跟着错位。

            ★ **不铺全屏透明遮罩**（QueueOverlay 那种）：通知条不该吃掉指针事件。
        -->
        <Border
            x:Name="NotificationBar"
            Grid.Row="1"
            Margin="0,0,0,12"
            MaxWidth="520"
            Padding="12,6,6,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            AutomationProperties.Name="通知"
            Background="{ThemeResource CommentPanelBackgroundBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}"
            RequestedTheme="{x:Bind Theme.RequestedTheme, Mode=OneWay}"
            Visibility="{x:Bind local:Formats.Visible(Notifications.IsOpen), Mode=OneWay}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    等级：一颗圆点，三颗叠在同一格里按等级选一颗显示。

                    ★ 拆成三颗而不是一颗动态换色：画刷必须走 `{ThemeResource}` 才能在切主题时
                      重新求值，而函数绑定/转换器只在源属性变化时跑一次 —— 那种写法切完主题
                      会留一个过期颜色。
                -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind local:Formats.Visible(Notifications.IsInformational), Mode=OneWay}" />
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Visibility="{x:Bind local:Formats.Visible(Notifications.IsSuccess), Mode=OneWay}" />
                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind local:Formats.Visible(Notifications.IsError), Mode=OneWay}" />
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource FontSizeBody}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    MaxLines="2"
                    Text="{x:Bind Notifications.Message, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="WrapWholeWords" />

                <Button
                    Grid.Column="2"
                    Width="22"
                    Height="22"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="关闭通知"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnNotificationCloseClick"
                    CornerRadius="{StaticResource RadiusSm}"
                    ToolTipService.ToolTip="关闭">
                    <controls:Icon Size="10" Data="{StaticResource IconDismiss}" />
                </Button>
            </Grid>
        </Border>
    </Grid>
    </controls:ResponsiveViewport>
</Window>
