<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Bodian.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:models="using:Bodian.Core.Models"
    Title="波点音乐">

    <!--
        外壳 = 自定义标题栏（第 0 行）+ 侧栏 / 内容区（第 1 行）+ 通栏播放条（第 2 行）。

        ★ 播放条**通栏**，横跨整个窗口宽度，所以侧栏不再到窗口底部。
          这是刻意改的：早先的做法是把播放条塞进 NavigationView 的 Content，
          让侧栏从顶到底（模仿官方 PC 端）。但那样播放条不横跨侧栏，
          与用户对播放器的预期不符 —— 现在按 Spotify / Apple Music 的形态来。

        ★ IsBackButtonVisible=Collapsed：返回栈是自己的（INavigationService），
          返回入口统一放在搜索框左侧。交给 NavigationView 会多出一个不受控的按钮。

        ★ 用 ItemInvoked 而不是 SelectionChanged：SelectionChanged 在我们自己
          同步高亮时也会触发，会和导航互相打架。ItemInvoked 只在用户点击时触发。
    -->
    <!--
        ★ RequestedTheme 必须设在最外层这个 Grid 上，**不能设在里面的 NavigationView 上**。
          设在 NavigationView 上时只有它自己的子树跟随主题，窗口底色的那层就漏掉了 ——
          主题无关的兄弟节点会一直用浅色，深色模式下整个窗口变成一片白。实测踩过。

        ★ 底色也必须自己铺：NavigationView 的面板是 AcrylicBrush、内容区是半透明层刷，
          两者都假定自己叠在 Mica 背板上。本应用不设背板（氛围渐变才是背景），
          没有东西可叠时深色下面板会退回浅色，白字压白底 —— 导航项整个看不见。
          见 Themes/Theme.xaml 里 AppSurfaceBrush 的说明。

        ★ 不能用 Application.RequestedTheme：那个只能在窗口创建之前设，
          运行期改会抛异常。所以运行期切换只能走元素级。
    -->
    <Grid x:Name="ShellRoot" RequestedTheme="{x:Bind Theme.RequestedTheme, Mode=OneWay}">
        <Grid.RowDefinitions>
            <!-- 顶部：原生自定义标题栏，复用原系统标题栏区域 -->
            <RowDefinition Height="Auto" />
            <!-- 中间：侧栏 + 内容区，顶边齐平 -->
            <RowDefinition Height="*" />
            <!-- 下：播放条。**通栏**，横跨侧栏与内容区 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            底色层与氛围渐变层都要**跨三行**：只铺内容区的话，播放条那一带会露出纯色，
            与上面的渐变之间出现一条硬边。
        -->
        <Border Grid.RowSpan="3" Background="{ThemeResource AppSurfaceBrush}" />
        <controls:AmbientBackdrop Grid.RowSpan="3" />

        <!--
            原生 TitleBar 负责拖动区与交互控件避让，系统 caption 按钮仍由 Windows 管理。
            左上角预留与展开侧栏等宽的 Logo 区域；收起按钮留在下方 NavigationView。
            高度与原生 Tall caption 一致，搜索框、账号、主题和窗口按钮沿同一中心线。
        -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="{StaticResource SizeTopBar}"
            Background="Transparent"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            AutomationProperties.Name="波点音乐标题栏">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <x:Double x:Key="TitleBarExpandedHeight">48</x:Double>
                <x:Double x:Key="TitleBarLeftPaddingWidth">0</x:Double>
                <x:Double x:Key="TitleBarLeftHeaderPaddingWidth">0</x:Double>
                <Thickness x:Key="TitleBarCompactContentMargin">0</Thickness>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.LeftHeader>
                <!-- 暂无图案：保留 Logo 插槽，后续可在此挂载设计好的资源。 -->
                <Border
                    x:Name="LogoHost"
                    Width="{StaticResource SizeSidebarWidth}"
                    Height="32"
                    Padding="24,0"
                    IsHitTestVisible="False" />
            </TitleBar.LeftHeader>
            <TitleBar.Content>
                <!-- 搜索宽度随可用空间收缩，并限制最大宽度以保留标题栏留白。 -->
                <Grid x:Name="SearchBarHost" Margin="24,0,24,0" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="400" />
                    </Grid.ColumnDefinitions>
                    <ContentControl
                        x:Name="BackButtonHost"
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                        <Button
                            x:Name="BackButton"
                            Style="{StaticResource SubtleButtonStyle}"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            CornerRadius="8"
                            IsEnabled="{x:Bind _navigation.CanGoBack, Mode=OneWay}"
                            Click="OnBackClick"
                            AutomationProperties.Name="返回上一级"
                            ToolTipService.ToolTip="返回上一级">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" IsTextScaleFactorEnabled="False" />
                        </Button>
                    </ContentControl>
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        PlaceholderText="搜索单曲、歌单、专辑、歌手"
                        QueryIcon="Find"
                        QuerySubmitted="OnSearchQuerySubmitted"
                        TextChanged="OnSearchTextChanged"
                        GotFocus="OnSearchGotFocus"
                        ItemsSource="{x:Bind Search.Suggestions, Mode=OneWay}"
                        Text="{x:Bind Search.Keyword, Mode=TwoWay}"
                        AutomationProperties.Name="搜索单曲、歌单、专辑、歌手" />

                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="AccountButton"
                        Visibility="Collapsed"
                        AutomationProperties.Name="账号"
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        VerticalAlignment="Center"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="{x:Bind Account.AccountText, Mode=OneWay}">
                        <Border
                            Width="24"
                            Height="24"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="12">
                            <Image Source="{x:Bind Account.Avatar, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>

                        <Button.Flyout>
                            <!-- 右对齐：顶栏在窗口右上角，默认居中会往左偏出去 -->
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel MinWidth="200" Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border
                                            Width="32"
                                            Height="32"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            CornerRadius="16">
                                            <Image Source="{x:Bind Account.Avatar, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind Account.AccountText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />

                                            <!-- 会员徽标只是展示：播放权限一律以服务端 checkRight 为准 -->
                                            <Border
                                                Padding="5,0"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                CornerRadius="3"
                                                Visibility="{x:Bind Account.IsVip, Mode=OneWay}">
                                                <TextBlock FontSize="11" Text="VIP" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind Account.SignOutCommand}"
                                        Content="退出登录"
                                        ToolTipService.ToolTip="清除本机保存的会话，回到扫码登录" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        x:Name="ThemeButton"
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="{x:Bind Theme.CurrentLabel, Mode=OneWay}"
                        AutomationProperties.Name="切换主题">
                        <FontIcon
                            FontSize="{StaticResource SizeIconSm}"
                            Glyph="{x:Bind Theme.CurrentGlyph, Mode=OneWay}" />
                        <Button.Flyout>
                            <Flyout Opening="OnThemeFlyoutOpening" Placement="Bottom">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Background" Value="{ThemeResource ThemeFlyoutBackground}" />
                                        <Setter Property="Padding" Value="6" />
                                        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <!-- 竖排单选列表：仅以背景表示选中，隐藏圆点、勾选和强调线。 -->
                                <ListView
                                    x:Name="ThemeOptions"
                                    MinWidth="0"
                                    HorizontalAlignment="Left"
                                    SelectionMode="Single"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    AutomationProperties.Name="主题">
                                    <ListView.Resources>
                                        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                                        <x:Boolean x:Key="ListViewItemSelectionCheckMarkVisualEnabled">False</x:Boolean>
                                    </ListView.Resources>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="Padding" Value="10,8" />
                                            <Setter Property="Margin" Value="0,2" />
                                            <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListViewItem x:Name="SystemThemeOption" AutomationProperties.Name="跟随系统">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                Width="20"
                                                Height="20"
                                                FontSize="{StaticResource SizeIconSm}"
                                                Glyph="&#xE770;" />
                                            <TextBlock VerticalAlignment="Center" Text="跟随系统" />
                                        </StackPanel>
                                    </ListViewItem>
                                    <ListViewItem x:Name="LightThemeOption" AutomationProperties.Name="浅色">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                Width="20"
                                                Height="20"
                                                FontSize="{StaticResource SizeIconSm}"
                                                Glyph="&#xE706;" />
                                            <TextBlock VerticalAlignment="Center" Text="浅色" />
                                        </StackPanel>
                                    </ListViewItem>
                                    <ListViewItem x:Name="DarkThemeOption" AutomationProperties.Name="深色">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon
                                                Width="20"
                                                Height="20"
                                                FontSize="{StaticResource SizeIconSm}"
                                                Glyph="&#xE708;" />
                                            <TextBlock VerticalAlignment="Center" Text="深色" />
                                        </StackPanel>
                                    </ListViewItem>
                                </ListView>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Border
                        Width="1"
                        Height="16"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="OnItemInvoked"
            OpenPaneLength="{StaticResource SizeSidebarWidth}"
            PaneDisplayMode="Left">

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="DiscoverItem"
                Content="发现"
                Tag="discover">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="BangsItem"
                Content="排行榜"
                Tag="bangs">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Sort" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="LibraryItem"
                Content="乐库"
                Tag="library">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="List" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItemHeader Content="我的音乐" />

            <NavigationViewItem
                x:Name="FavoritesItem"
                Content="我喜欢的"
                Tag="favorites">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Favorite" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="RecentItem"
                Content="最近播放"
                Tag="recent">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Clock" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="PurchasedItem"
                Content="已购音乐"
                Tag="purchased">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Shop" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="CollectedAlbumsItem"
                Content="收藏的专辑"
                Tag="collected-albums">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Audio" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <!-- 这一行是「创建的歌单」那一段的锚点：动态项在它后面追加 -->
            <NavigationViewItemHeader x:Name="CreatedHeader" Content="创建的歌单" />
        </NavigationView.MenuItems>

        <!-- 页面宿主与侧栏从同一行开始；搜索入口统一放在上方标题栏。 -->
        <ContentControl
            x:Name="PageHost"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
        </NavigationView>

        <!--
            播放条常驻，不随页面切换重建。
            **放在根 Grid 而不是 NavigationView 的 Content 里** —— 这样它横跨整个窗口宽度，
            侧栏在它上方结束。见文件头对布局形态的说明。
        -->
        <ContentControl
            x:Name="PlayerHost"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />

        <ContentControl
            x:Name="ImmersiveHost"
            Grid.RowSpan="3"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Visibility="Collapsed" />
        <!-- 非模态浮层：搜索框保留键盘焦点，外部指针事件继续交给原控件。 -->
        <Border
            x:Name="SearchPanel"
            Grid.RowSpan="3"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Padding="6"
            Background="{ThemeResource ThemeFlyoutBackground}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}"
            RequestedTheme="{x:Bind Theme.RequestedTheme, Mode=OneWay}">
            <ScrollViewer Margin="10" MaxHeight="500" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <HyperlinkButton
                        Content="{x:Bind Search.HotWordsStatus, Mode=OneWay}"
                        Click="OnSearchHotWordsRetry"
                        HorizontalAlignment="Left"
                        FontWeight="SemiBold"
                        Padding="0" />
                    <ListView
                        MaxHeight="240"
                        ItemsSource="{x:Bind Search.HotWords}"
                        IsItemClickEnabled="True"
                        ItemClick="OnSearchHotWordClick"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchHotWord">
                                <Grid Padding="4,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Rank}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Keyword}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="搜索历史" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="清空" Command="{x:Bind Search.ClearSearchHistoryCommand}" />
                    </Grid>
                    <TextBlock Text="暂无搜索历史" Visibility="{x:Bind Search.HistoryIsEmpty, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView
                        MaxHeight="160"
                        ItemsSource="{x:Bind Search.SearchHistory}"
                        IsItemClickEnabled="True"
                        ItemClick="OnSearchHistoryClick"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Padding="4,6" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
