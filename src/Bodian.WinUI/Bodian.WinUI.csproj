<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <!-- XAML 编译靠它，不能省 -->
    <UseWinUI>true</UseWinUI>
    <!-- 输入法兼容选项需要在 Application.Start 之前应用。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <RootNamespace>Bodian.WinUI</RootNamespace>
    <AssemblyName>Bodian.WinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 自身的图标：资源管理器、开始菜单快捷方式、Alt-Tab 都读它 -->
    <ApplicationIcon>Assets\Ripple.ico</ApplicationIcon>

    <!--
      ★ RuntimeIdentifier 是单数且不可省：开自包含后不带 RID 构建会直接失败
      （WindowsAppSDKSelfContained requires a supported Windows architecture）。
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!--
      只保留简繁中文的附属资源。这条管的是托管附属程序集（.resources.dll）。
      注意：它管不到 WinAppSDK 的原生 .mui，那批走下面的 _TrimWinAppSDKFrameworkLanguages。
    -->
    <SatelliteResourceLanguages>zh-Hans;zh-Hant</SatelliteResourceLanguages>

    <!-- 关掉反射序列化：DTO 必须走 JsonSerializerContext -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <!--
      这四个只做 ExcludeAssets="all"，目的是挡掉元包连带进来的原生资产，不是要使用它们。
      摘掉的理由与踩过的坑见 src/Directory.Packages.props 的注释。
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" ExcludeAssets="all" />
    <!-- 歌词的逐字渲染。原生 Microsoft.Graphics.Canvas.dll 会随 RID(win-x64) 拷进输出目录 -->
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- 音频引擎。原生库 libmpv-2.dll 由下面的 None 项拷到输出目录，见 libmpv/README.md -->
    <PackageReference Include="HanumanInstitute.LibMpv" />
    <!-- 扫码登录的二维码本地渲染 -->
    <PackageReference Include="QRCoder" />
    <PackageReference Include="NAudio.Wasapi" />
    <!-- 系统托盘。unpackaged 没有 MSIX 身份，托盘只能靠 Win32 Shell_NotifyIcon，这个库封装了它 -->
    <PackageReference Include="H.NotifyIcon.WinUI" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 仓库根的 libmpv/。不入库，克隆后需自行下载，见该目录的 README -->
    <LibMpvDir>$(MSBuildThisFileDirectory)..\..\libmpv\</LibMpvDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      条件拷贝：文件不存在时静默跳过，不进错误列表。
      这样新克隆的仓库不做这一步也能 0/0 构建并正常启动（缺库由
      LibMpvPlaybackService 在首次播放时给出可读提示，而不是启动就崩）。
    -->
    <None Include="$(LibMpvDir)libmpv-2.dll"
          Condition="Exists('$(LibMpvDir)libmpv-2.dll')"
          Link="libmpv-2.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      应用图标。**必须复制到输出目录**：任务栏图标、托盘图标与侧栏 Logo 都从输出目录读，
      而 unpackaged 应用没有包身份，文件不在输出目录就是「图标不显示」。
      四角已经处理成透明，见 docs/settings.md。
    -->
    <Content Include="Assets\Ripple.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\RippleLight.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Ripple.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\RippleLight.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    WinAppSDK 的原生语言资源放在包的 runtimes-framework 下，由 Base 的
    SelfContained.targets 自己拷贝，不走 NuGet 的附属资源机制——所以
    SatelliteResourceLanguages 对它们无效。实测铺 91 个语言目录，每个两份 .mui，
    合计 3.4 MB，对中文用户是死重量，这里只留简繁中文。

    ★ 走的是在 WinAppSDK 拷完之后、按 Link 元数据把 None 项摘掉的路线，不去碰它内部的
      MicrosoftWindowsAppSDKFilesExcluded 口子。试过那个口子：它的 item spec 形如
      ...\buildTransitive\..\，排除清单的路径只要经过一次规范化就对不上，会静默失效；
      而用 %(Identity) 原样拼又会让 glob 不展开。踩不起，不如自己按 Link 删。
    ★ 语言目录里只有 .mui，所以按 Link 以 .mui 结尾来判定，既精确又不会误伤
      Microsoft.UI.Xaml\Assets 里的 .png / .html。
    ★ 必须写在 Target 里：%(Link) 这类元数据不允许出现在求值期的 Condition 中（MSB4190）。
  -->
  <Target Name="_TrimWinAppSDKFrameworkLanguages"
          AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <ItemGroup>
      <_WinAppSDKLangMui Include="@(None)"
          Condition="$([System.String]::Copy('%(None.Link)').EndsWith('.mui')) and !$([System.String]::Copy('%(None.Link)').StartsWith('zh-CN\')) and !$([System.String]::Copy('%(None.Link)').StartsWith('zh-TW\'))" />
      <None Remove="@(_WinAppSDKLangMui)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Bodian.Core\Bodian.Core.csproj" />
  </ItemGroup>

</Project>
