<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <!-- XAML 编译靠它，不能省 -->
    <UseWinUI>true</UseWinUI>
    <RootNamespace>Bodian.WinUI</RootNamespace>
    <AssemblyName>Bodian.WinUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 自身的图标：资源管理器、开始菜单快捷方式、Alt-Tab 都读它 -->
    <ApplicationIcon>Assets\Ripple.ico</ApplicationIcon>

    <!--
      ★ RuntimeIdentifier 是单数且不可省：开自包含后不带 RID 构建会直接失败
      （WindowsAppSDKSelfContained requires a supported Windows architecture）。
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- 关掉反射序列化：DTO 必须走 JsonSerializerContext -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <!-- 歌词的逐字渲染。原生 Microsoft.Graphics.Canvas.dll 会随 RID(win-x64) 拷进输出目录 -->
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- 音频引擎。原生库 libmpv-2.dll 由下面的 None 项拷到输出目录，见 libmpv/README.md -->
    <PackageReference Include="HanumanInstitute.LibMpv" />
    <!-- 扫码登录的二维码本地渲染 -->
    <PackageReference Include="QRCoder" />
    <PackageReference Include="NAudio.Wasapi" />
    <!-- 系统托盘。unpackaged 没有 MSIX 身份，托盘只能靠 Win32 Shell_NotifyIcon，这个库封装了它 -->
    <PackageReference Include="H.NotifyIcon.WinUI" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 仓库根的 libmpv/。不入库，克隆后需自行下载，见该目录的 README -->
    <LibMpvDir>$(MSBuildThisFileDirectory)..\..\libmpv\</LibMpvDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      条件拷贝：文件不存在时静默跳过，不进错误列表。
      这样新克隆的仓库不做这一步也能 0/0 构建并正常启动（缺库由
      LibMpvPlaybackService 在首次播放时给出可读提示，而不是启动就崩）。
    -->
    <None Include="$(LibMpvDir)libmpv-2.dll"
          Condition="Exists('$(LibMpvDir)libmpv-2.dll')"
          Link="libmpv-2.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      应用图标。**必须复制到输出目录**：任务栏图标、托盘图标与侧栏 Logo 都从输出目录读，
      而 unpackaged 应用没有包身份，文件不在输出目录就是「图标不显示」。
      四角已经处理成透明，见 docs/settings.md。
    -->
    <Content Include="Assets\Ripple.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\RippleLight.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Ripple.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\RippleLight.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bodian.Core\Bodian.Core.csproj" />
  </ItemGroup>

</Project>
