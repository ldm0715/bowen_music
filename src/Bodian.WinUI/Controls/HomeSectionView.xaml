<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.HomeSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bodian.WinUI"
    xmlns:models="using:Bodian.Core.Models.Home">

    <!--
        发现页的一组卡片：可选的小标题 + 一排横向卡片。

        ★ 横向列表用 ListView + 横向 StackPanel 而不是 GridView：
          GridView 会按宽度自动换行排成网格，而这里要的是一行横着滚。
          卡片的宽度写死（120），所以一行能放几张由容器宽度决定。
    -->
    <StackPanel Spacing="6">
        <!--
            标题在 AI 歌单上是**入口**（那一组其实是一个完整歌单，这里只有 3 首预览），
            所以用 HyperlinkButton；其余分组没有可进去的地方，保持纯文本。
            两种形态切换靠两个控件的 Visibility，而不是改按钮的可点状态 ——
            纯文本配可点样式会让人以为坏了。
        -->
        <HyperlinkButton
            Margin="0"
            Padding="4,0,0,0"
            Click="OnTitleClick"
            Content="{x:Bind Section.Title}"
            Visibility="{x:Bind local:Formats.Visible(IsOpenable)}" />

        <TextBlock
            Margin="4,0,0,0"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind Section.Title}"
            Visibility="{x:Bind local:Formats.Visible(HasPlainTitle)}"
            TextTrimming="CharacterEllipsis" />

        <ListView
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemsSource="{x:Bind Section.Cards}"
            SelectionMode="None"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.VerticalScrollMode="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:HomeCard">
                    <StackPanel Width="116" Spacing="6">
                        <Border
                            Width="116"
                            Height="116"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="8">
                            <Image Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Stretch="UniformToFill" />
                        </Border>

                        <TextBlock
                            MaxLines="1"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Subtitle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</UserControl>
