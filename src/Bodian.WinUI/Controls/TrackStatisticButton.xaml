<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.TrackStatisticButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    MinWidth="0">
    <!--
        收藏 / 分享 / 评论入口：一颗 32 圆的图标按钮 + 右上角的计数角标。

        ★ 角标**放在按钮之外**（`Margin="0,-5,-4,0"` + `IsHitTestVisible="False"`）：
          压在按钮右上角、往外探一点，不盖住图标，也不算进按钮的点击区。

        ★ 图标走 Controls/Icon（矢量路径），不再用 FontIcon ——
          字体字形要按基线做上移补偿，路径的墨水本来就居中，不需要。
    -->
    <Grid>
        <Button
            x:Name="InnerButton"
            Style="{StaticResource PlayerRoundIconButtonStyle}"
            Click="OnInnerClick"
            AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind Label, Mode=OneWay}">
            <Grid>
                <!-- 未激活：轮廓图标，沿用外层给的前景色。 -->
                <controls:Icon
                    Size="18"
                    Data="{x:Bind Data, Mode=OneWay}"
                    Visibility="{x:Bind local:Formats.VisibleWhenFalse(IsActive), Mode=OneWay}" />
                <!-- 已激活：实心图标 + 强调色。两个图标叠在同一格，靠可见性切换。 -->
                <controls:Icon
                    Size="18"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Data="{x:Bind ActiveData, Mode=OneWay}"
                    Visibility="{x:Bind local:Formats.Visible(IsActive), Mode=OneWay}" />
            </Grid>
        </Button>
        <Border
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,-5,-4,0"
            MinWidth="16"
            MaxWidth="36"
            Padding="3,0"
            CornerRadius="7"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            IsHitTestVisible="False"
            Visibility="{x:Bind local:Formats.Visible(HasBadgeCount), Mode=OneWay}">
            <TextBlock
                FontSize="9"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="{x:Bind BadgeText, Mode=OneWay}"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
