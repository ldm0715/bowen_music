<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.PlayQueuePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    xmlns:vm="using:Bodian.WinUI.ViewModels">

    <!--
        主窗口右侧那个播放队列抽屉的内容。

        **是内存播放队列，不是服务器歌单** —— 与曲目行「更多」菜单里的「添加到歌单」是两回事。
        面板做四件事：点行切歌、删单曲、清空、拖动手柄调整顺序（拖动那张浮起来的卡片是 DragGhost，
        手势在 code-behind 里，见 docs/play-queue.md §12）。列表要撑满抽屉高度，所以根容器是 Grid
        而不是 StackPanel（后者会把列表压成内容高度，下面的空白就露出来了）。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="18,16,10,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                FontSize="14"
                FontWeight="SemiBold"
                Text="播放队列"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                VerticalAlignment="Center" />

            <!-- 空队列时藏起来：没有东西可清，摆一个灰按钮只会让人以为点坏了。 -->
            <Button
                Grid.Column="2"
                MinWidth="0"
                Padding="8,4"
                AutomationProperties.Name="清空播放队列"
                Click="OnClearClick"
                Content="清空"
                FontSize="12"
                Visibility="{x:Bind local:Formats.VisibleWhenFalse(ViewModel.IsEmpty), Mode=OneWay}" />
            <Button
                Grid.Column="3"
                Width="32"
                Height="32"
                MinWidth="0"
                MinHeight="0"
                Padding="0"
                AutomationProperties.Name="收起播放队列"
                Background="Transparent"
                BorderThickness="0"
                Click="OnCloseClick"
                CornerRadius="{StaticResource RadiusSm}"
                ToolTipService.ToolTip="收起">
                <controls:Icon Size="12" Data="{StaticResource IconDismiss}" />
            </Button>
        </Grid>

        <Grid x:Name="RowHost" Grid.Row="1">
            <ListView
                x:Name="RowList"
                MinWidth="0"
                IsItemClickEnabled="True"
                ItemClick="OnRowClick"
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                SelectionMode="None"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="播放队列">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="40" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Margin" Value="6,1" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlayQueueRow">
                        <!--
                            Background 不能省：没有它，行内空白处收不到指针事件，悬停态就只在文字/封面
                            上才触发（TrackListView 的行根同理，那边有注释）。
                        -->
                        <Grid
                            Background="Transparent"
                            ColumnSpacing="8"
                            Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                            PointerEntered="OnRowPointerEntered"
                            PointerExited="OnRowPointerExited">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>

                            <!--
                                序号位三态互斥，一律 Center：正在播放 → 起伏条（自己按 IsPlaying 管显隐）；
                                悬停且能拖 → 拖动条；其余 → 序号。

                                ★ 三态必须落在同一个位置上。TrackListView 那边踩过：序号右对齐、播放键居中，
                                  差半个列宽，鼠标一进一出整列就横向跳一下。

                                ★ 拖动条外面那层透明 Border 不是装饰：六点握把的墨迹只有六个小圆，点与点之间
                                  是空的，而 Icon 是没有背景的 UserControl、空白处不参与命中测试 ——
                                  指针事件挂在 Icon 上的话，会变成「必须精准点在点上」。撑满整格的 Border
                                  才是 20×28 的靶子。
                            -->
                            <Grid Grid.Column="0">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind OrdinalText}"
                                    Visibility="{x:Bind OrdinalVisibility, Mode=OneWay}" />
                                <controls:PlayingBars
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsPlaying="{x:Bind IsCurrent, Mode=OneWay}" />
                                <Border
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    PointerPressed="OnGripPressed"
                                    ToolTipService.ToolTip="拖动调整顺序"
                                    Visibility="{x:Bind DragHandleVisibility, Mode=OneWay}">
                                    <controls:Icon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Size="14"
                                        Data="{StaticResource IconDragHandle}" />
                                </Border>
                            </Grid>

                            <Border
                                Grid.Column="1"
                                Width="{StaticResource SizeCoverRow}"
                                Height="{StaticResource SizeCoverRow}"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="{StaticResource RadiusMd}">
                                <Image Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ArtistText}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="3"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind DurationText}"
                                VerticalAlignment="Center" />

                            <Button
                                Grid.Column="4"
                                Width="28"
                                Height="28"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                AutomationProperties.Name="从播放队列中移除"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnRemoveClick"
                                CornerRadius="{StaticResource RadiusSm}"
                                IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                                ToolTipService.ToolTip="从播放队列中移除"
                                VerticalAlignment="Center">
                                <controls:Icon Size="12" Data="{StaticResource IconDismiss}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--
                拖动时浮在列表之上的那张卡片。

                ★ 为什么不是「把被拖那一行原地抬起来」：那需要在 ItemsStackPanel 里把某个 ListViewItem
                  提到最上层，而它认不认 Canvas.ZIndex 没有可靠的依据可查。这张卡片画在 ListView **之后**
                  （同级、后声明即在上层），不依赖任何面板行为。被拖那一行原地隐掉，其余行让位。

                ★ 列结构刻意与行模板保持一致（宽度 20 / Auto / * / Auto / 28，同样的 ColumnSpacing）
                  与 Padding —— 卡片起来的那一瞬间才能和原行严丝合缝地重合。
                  改行模板的列宽时这里要一起改。
            -->
            <Border
                x:Name="DragGhost"
                Margin="6,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Background="{ThemeResource CommentPanelBackgroundBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DragGhostShift" />
                </Border.RenderTransform>
                <Grid Padding="10,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>

                    <!-- 握着的那一格：原行悬停时才出现的握把，在卡片上一直亮着。 -->
                    <controls:Icon
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Size="14"
                        Data="{StaticResource IconDragHandle}" />

                    <Border
                        Grid.Column="1"
                        Width="{StaticResource SizeCoverRow}"
                        Height="{StaticResource SizeCoverRow}"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{StaticResource RadiusMd}">
                        <Image Source="{x:Bind local:Formats.CoverSource(DraggedRow.CoverImage), Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{x:Bind DraggedRow.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind DraggedRow.ArtistText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="3"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind DraggedRow.DurationText, Mode=OneWay}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock
                Margin="18,28,18,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                HorizontalAlignment="Center"
                Text="播放队列是空的"
                VerticalAlignment="Top"
                Visibility="{x:Bind local:Formats.Visible(ViewModel.IsEmpty), Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
