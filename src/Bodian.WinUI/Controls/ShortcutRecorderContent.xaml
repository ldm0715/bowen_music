<?xml version="1.0" encoding="utf-8"?>
<!--
    录制快捷键的内容体。由设置页放进一个 ContentDialog 显示，见 SettingsPage.xaml.cs。

    ★ 根节点的 IsTabStop=True 是为了拿键盘焦点：KeyDown 只送到有焦点的元素，
      而 ContentDialog 默认会把焦点给它的第一个按钮。见 code-behind 的 OnLoaded。
-->
<UserControl
    x:Class="Bodian.WinUI.Controls.ShortcutRecorderContent"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="320"
    IsTabStop="True"
    Loaded="OnLoaded">

    <StackPanel Spacing="12">
        <TextBlock
            x:Name="HintText"
            FontSize="{StaticResource FontSizeBody}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <Border
            Background="{ThemeResource HomeCardBackgroundBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusMd}"
            Padding="16,20">
            <TextBlock
                x:Name="GestureText"
                HorizontalAlignment="Center"
                FontSize="{StaticResource FontSizeTitle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Border>

        <!-- 校验与冲突提示。空的时候整块收起来，不占高度。 -->
        <TextBlock
            x:Name="MessageText"
            FontSize="{StaticResource FontSizeBody}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
