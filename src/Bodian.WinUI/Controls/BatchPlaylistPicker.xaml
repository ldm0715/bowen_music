<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.BatchPlaylistPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bodian.WinUI"
    xmlns:models="using:Bodian.Core.Models">

    <!--
        「批量加入歌单」对话框的内容：选一个自建歌单，然后就地写入并显示进度。
        外壳（标题 / 按钮 / 主题）由 TrackListToolbar 用 AppDialogs 拼，这里只管内容。

        ★ 写入过程中**不关窗**：失败与「已取消，成功 N 首」这类结果要留在面板里，
          关掉用户就看不见了 —— 与行尾「更多」那条弹层是同一条规矩。
    -->
    <Grid MinWidth="280">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView
            x:Name="PlaylistList"
            MaxHeight="280"
            MinWidth="0"
            AutomationProperties.Name="选择歌单"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="36" />
                    <Setter Property="Padding" Value="10,7" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Playlist">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="13"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind local:Formats.AlbumCount(MusicCount)}"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing
            x:Name="LoadingRing"
            Width="24"
            Height="24"
            Margin="0,24"
            HorizontalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="MessageText"
            Margin="0,12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!-- 写入进度。放在第二行，选择列表还留在上面给用户对照。 -->
        <StackPanel
            x:Name="WritePanel"
            Grid.Row="1"
            Margin="0,12,0,0"
            Spacing="6"
            Visibility="Collapsed">
            <ProgressBar x:Name="WriteBar" />
            <TextBlock
                x:Name="WriteText"
                Style="{StaticResource BodianPageStatus}" />
        </StackPanel>
    </Grid>
</UserControl>
