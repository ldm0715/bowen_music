<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.TrackListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bodian.WinUI"
    xmlns:models="using:Bodian.Core.Models">

    <!--
        曲目列表。搜索页、我喜欢的页、歌单详情页共用同一套行模板。

        **只负责「列表 + 点行」**：表头、空状态、加载更多按钮都留给页面自己 ——
        它们每页的说法不一样（「输入关键词开始搜索」/「账号里没有这个歌单」），
        塞进控件就得开一堆属性孔。

        **点行只报 Track，不给下标。** 队列要的是「当前列表里的第几首」，
        而下标取决于页面用的是哪个集合（搜索结果还是歌单曲目），控件不该知道。
    -->
    <ListView
        IsItemClickEnabled="True"
        ItemClick="OnItemClick"
        ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
        SelectionMode="None">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:Track">
                <Grid Padding="8,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 封面。没有封面时留一块底色，行高不跳。 -->
                    <Border
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="4">
                        <Image Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />

                            <!-- 付费标识：让用户在点之前就知道要不要会员 -->
                            <Border
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                CornerRadius="3"
                                Visibility="{x:Bind local:Formats.PayLabelVisibility(RequiresVip, RequiresPurchase)}">
                                <TextBlock FontSize="11" Text="{x:Bind local:Formats.PayLabel(RequiresVip, RequiresPurchase)}" />
                            </Border>
                        </StackPanel>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ArtistText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="2"
                        MaxWidth="200"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind AlbumName}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind local:Formats.Quality(AvailableQualities)}" />

                    <TextBlock
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind local:Formats.Duration(Duration)}" />
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</UserControl>
