<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.TrackListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    xmlns:vm="using:Bodian.WinUI.ViewModels">

    <!--
        曲目列表。搜索页、我喜欢的页、歌单详情页等共用同一套行模板。

        **只负责「列表 + 点行 + 自动翻页」**：表头、空状态、底部文案都留给页面自己 ——
        它们每页的说法不一样（「输入关键词开始搜索」/「账号里没有这个歌单」），
        塞进控件就得开一堆属性孔。

        翻页靠透传 HasMore / LoadMoreCommand 两个依赖属性给内部的 AutoPaging，
        页面因此不必知道这里用的是什么列表控件。

        **点行只报 Track，不给下标。** 队列要的是「当前列表里的第几首」，
        而下标取决于页面用的是哪个集合（搜索结果还是歌单曲目），控件不该知道。

        ★ 对外契约没变：ItemsSource 收 IEnumerable<Track>，TrackInvoked 报 Track。
          内部把曲目投影成 TrackRow 只是为了拿到序号与「正在播放」两个可绑定状态，
          调用方一行都不用改。

        ★ 行根必须有 Background="Transparent"。少了它，行内的空白处收不到指针事件，
          序号列就不会在悬停时切换成播放键。
    -->
    <!-- Padding 作用在原生 ItemsPresenter 上，给时间列与滚动条之间留出独立空间。 -->
    <controls:VirtualizedListView
        x:Name="List"
        Padding="{StaticResource SpaceVerticalScrollContentPadding}"
        controls:AutoPaging.Command="{x:Bind LoadMoreCommand, Mode=OneWay}"
        controls:AutoPaging.HasMore="{x:Bind HasMore, Mode=OneWay}"
        IsItemClickEnabled="True"
        ItemClick="OnItemClick"
        ItemsSource="{x:Bind Rows}"
        SelectionMode="None"
        ContainerContentChanging="OnContainerContentChanging">
        <controls:VirtualizedListView.ItemsPanel>
            <ItemsPanelTemplate><ItemsStackPanel CacheLength="0.5" /></ItemsPanelTemplate>
        </controls:VirtualizedListView.ItemsPanel>
        <!-- 行内自己保留播放区；移除原生容器的额外左右内边距，沿用原生完整模板。 -->
        <controls:VirtualizedListView.ItemContainerStyle>
            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </controls:VirtualizedListView.ItemContainerStyle>
        <controls:VirtualizedListView.ItemTemplate>
            <DataTemplate x:DataType="vm:TrackRow">
                <Grid
                    MinHeight="{StaticResource SizeRowHeight}"
                    Padding="{StaticResource SpaceRowPadding}"
                    Background="Transparent"
                    ColumnSpacing="{StaticResource SpaceRow}"
                    PointerEntered="OnRowPointerEntered"
                    PointerExited="OnRowPointerExited">
                    <!--
                        列宽写的是字面量而不是 token：ColumnDefinition.Width 是 GridLength，
                        而 token 定义的是 x:Double —— {StaticResource} 返回的是 double 对象，
                        赋给 GridLength 会类型不匹配。数值与 Tokens.xaml 里的
                        SizeRowOrdinalColumn / SizeRowDurationColumn / SizeRowActionColumn 一致，
                        改的时候两处一起改。

                        最后一列是行尾的「更多」按钮，**必须定宽**：按钮未悬停时是折叠的，
                        用 Auto 会塌成 0，一悬停整行宽度突变、时长跟着左右跳。
                    -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>

                    <!--
                        序号列：四态互斥。多选 → 复选框；正在播放 → 起伏条；悬停 → 播放键；其余 → 序号。
                        后三个 Visibility 由 TrackRow 算好（起伏条自己管显隐，见 PlayingBars）。

                        ★ 四种状态**必须落在同一个位置上**，所以一律 Center：
                          早先序号是右对齐的，和居中的播放键差半个列宽，鼠标一进一出
                          整个图标就横向跳一下。

                        ★ 复选框是**纯显示**（IsHitTestVisible=False）：勾选由整行点击驱动。
                          给它自己接点击的话，「勾上了但计数没变」这类不一致就有了两个来源。
                    -->
                    <Grid Grid.Column="0">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind OrdinalText}"
                            Visibility="{x:Bind IndexVisibility, Mode=OneWay}" />

                        <controls:Icon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Visibility="{x:Bind PlayGlyphVisibility, Mode=OneWay}" Size="14" Data="{StaticResource IconPlay}" />

                        <controls:PlayingBars
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsPlaying="{x:Bind ShowPlayingBars, Mode=OneWay}" />

                        <CheckBox
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MinWidth="0"
                            IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Visibility="{x:Bind SelectionCheckVisibility, Mode=OneWay}" />
                    </Grid>

                    <!-- 封面。没有封面时留一块底色，行高不跳。 -->
                    <Border
                        Grid.Column="1"
                        Width="{StaticResource SizeCoverRow}"
                        Height="{StaticResource SizeCoverRow}"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="{StaticResource RadiusMd}">
                        <Image Source="{x:Bind local:Formats.CoverSource(CoverImage)}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontSize="{StaticResource FontSizeBodyLarge}"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />

                            <!-- 付费标识：让用户在点之前就知道要不要会员 -->
                            <Border
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                CornerRadius="{StaticResource RadiusXs}"
                                Visibility="{x:Bind PayLabelVisibility}">
                                <TextBlock FontSize="{StaticResource FontSizeCaption}" Text="{x:Bind PayLabel}" />
                            </Border>

                            <!--
                                MV 标记。**这是标记不是入口** —— 播放走行尾「更多」菜单里的那一项，
                                这里点它没有反应，与旁边的付费角标同一语义。
                            -->
                            <Border
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                CornerRadius="{StaticResource RadiusXs}"
                                Visibility="{x:Bind MvLabelVisibility}">
                                <TextBlock FontSize="{StaticResource FontSizeCaption}" Text="MV" />
                            </Border>
                        </StackPanel>

                        <TextBlock
                            FontSize="{StaticResource FontSizeCaption}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ArtistText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind AlbumName}"
                        TextTrimming="CharacterEllipsis" />

                    <!--
                        时长。TextBlock 没有 OpenType feature 属性（等宽数字做不到），
                        所以只能靠固定列宽 + 右对齐。
                    -->
                    <TextBlock
                        Grid.Column="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind DurationText}" />

                    <!-- 悬停才出现的「更多」。显隐由控件自己按 MoreVisibility 绑，这里只给数据。 -->
                    <controls:TrackMoreButton
                        Grid.Column="5"
                        VerticalAlignment="Center"
                        Row="{x:Bind}" />
                </Grid>
            </DataTemplate>
        </controls:VirtualizedListView.ItemTemplate>
    </controls:VirtualizedListView>
</UserControl>
