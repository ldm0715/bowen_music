<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bodian.WinUI"
    xmlns:vm="using:Bodian.WinUI.ViewModels">

    <!-- 铺满整块内容区，盖住页面。底色不透明，否则底下的列表会透上来。 -->
    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部：曲名 + 歌手 + 关闭 -->
        <Grid Grid.Row="0" Padding="24,16,24,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button
                Grid.Column="1"
                VerticalAlignment="Top"
                Command="{x:Bind ViewModel.CloseCommand}"
                ToolTipService.ToolTip="关闭歌词">
                <FontIcon FontSize="14" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- 歌词行。点一行跳到那一句。 -->
        <ListView
            x:Name="LinesList"
            Grid.Row="1"
            Padding="24,0,24,16"
            IsItemClickEnabled="True"
            ItemClick="OnLineClick"
            ItemsSource="{x:Bind ViewModel.Lines}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <!-- 去掉列表项自带的选中底色与内边距，歌词要看起来像一段文本而不是一张表 -->
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LyricLineView">
                    <TextBlock
                        Margin="0,7"
                        FontSize="{x:Bind local:Formats.LyricLineSize(IsCurrent), Mode=OneWay}"
                        IsTextSelectionEnabled="False"
                        Opacity="{x:Bind local:Formats.LyricLineOpacity(IsCurrent), Mode=OneWay}"
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 空态 / 失败态 / 加载中 -->
        <StackPanel
            Grid.Row="2"
            Padding="24,0,24,16"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">
            <ProgressRing
                Width="16"
                Height="16"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind local:Formats.Visible(ViewModel.IsLoading), Mode=OneWay}" />

            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Visibility="{x:Bind local:Formats.Visible(ViewModel.HasStatusText), Mode=OneWay}" />

            <Button
                Command="{x:Bind ViewModel.RetryCommand}"
                Content="重试"
                Visibility="{x:Bind local:Formats.Visible(ViewModel.LoadFailed), Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
