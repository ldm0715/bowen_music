<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.AudioQualityChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        音质档位的标签：标准灰 / HQ 蓝 / SQ 金（配色见 Themes/Quality.xaml）。

        三张底叠在同一格，按 Quality 选一张显示 —— 与账号下拉里的会员徽标同一套写法。
        档位未知（还没取到音源）时三张都不显示，只留文字，不会凭空画一个标签。

        ★ 形状是**小圆角矩形**，不是端部全圆的药丸：实色底 + 白字加粗，圆角取 RadiusXs。
          高度由字号和内边距撑，约 18 DIP。改字号 / 内边距时留意别把高度撑起来 ——
          一旦接近宽度就又从标签变成椭圆了。
    -->
    <Grid x:Name="ChipRoot"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">
        <Border x:Name="StandardChip"
            Background="{ThemeResource QualityStandardBackgroundBrush}"
            CornerRadius="{StaticResource RadiusXs}" />
        <Border x:Name="HighChip"
            Background="{ThemeResource QualityHighBackgroundBrush}"
            CornerRadius="{StaticResource RadiusXs}"
            Visibility="Collapsed" />
        <Border x:Name="LosslessChip"
            Background="{ThemeResource QualityLosslessBackgroundBrush}"
            CornerRadius="{StaticResource RadiusXs}"
            Visibility="Collapsed" />
        <TextBlock
            Margin="6,2"
            FontSize="10"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource QualityChipForegroundBrush}"
            Text="{x:Bind Label, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
        <!--
            悬停反馈由标签自己画：填满按钮时，按钮模板的悬停底色在内容之下，会被标签整个盖住。
            这层只在指针压到标签上时出现，弹层里的行仍由 ListViewItem 自己的悬停兜底。
        -->
        <Border x:Name="HoverOverlay"
            Background="#14000000"
            CornerRadius="{StaticResource RadiusXs}"
            IsHitTestVisible="False"
            Opacity="0" />
    </Grid>
</UserControl>
