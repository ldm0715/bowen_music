<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Bodian.WinUI.Converters"
    xmlns:local="using:Bodian.WinUI">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="NotBoolToVisibility" Invert="True" />

        <Style x:Key="PlayerUtilityButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Width" Value="{StaticResource SizeRoundButton}" />
            <Setter Property="Height" Value="{StaticResource SizeRoundButton}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <!-- 细轨道作为上下分界，22px 热区保留原生 Slider 的点击、拖动与键盘操作。 -->
        <Style x:Key="PlayerProgressSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource ControlStrongFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="IsThumbToolTipEnabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.1" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="HorizontalTrackRect.Height" Value="4" />
                                            <Setter Target="HorizontalDecreaseRect.Height" Value="4" />
                                            <Setter Target="HorizontalThumb.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="HorizontalTrackRect.Height" Value="4" />
                                            <Setter Target="HorizontalDecreaseRect.Height" Value="4" />
                                            <Setter Target="HorizontalThumb.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="HorizontalDecreaseRect.Fill" Value="{ThemeResource AccentFillColorDisabledBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusEngagementStates">
                                    <VisualState x:Name="FocusDisengaged" />
                                    <VisualState x:Name="FocusEngagedHorizontal">
                                        <VisualState.Setters>
                                            <Setter Target="FocusBorder.(Control.IsTemplateFocusTarget)" Value="False" />
                                            <Setter Target="HorizontalThumb.(Control.IsTemplateFocusTarget)" Value="True" />
                                            <Setter Target="HorizontalThumb.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Border
                                x:Name="FocusBorder"
                                CornerRadius="2"
                                Control.IsTemplateFocusTarget="True" />
                            <Grid x:Name="SliderContainer" Background="Transparent">
                                <Grid x:Name="HorizontalTemplate" MinHeight="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle
                                        x:Name="HorizontalTrackRect"
                                        Grid.ColumnSpan="3"
                                        Height="2"
                                        VerticalAlignment="Center"
                                        Fill="{TemplateBinding Background}"
                                        RadiusX="1"
                                        RadiusY="1" />
                                    <Rectangle
                                        x:Name="HorizontalDecreaseRect"
                                        Height="2"
                                        Margin="0,0,-6,0"
                                        VerticalAlignment="Center"
                                        Fill="{TemplateBinding Foreground}"
                                        RadiusX="1"
                                        RadiusY="1" />
                                    <Thumb
                                        x:Name="HorizontalThumb"
                                        Grid.Column="1"
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Background="{ThemeResource SliderOuterThumbBackground}"
                                        BorderBrush="{ThemeResource SliderThumbBorderBrush}"
                                        BorderThickness="1"
                                        DataContext="{TemplateBinding Value}"
                                        Opacity="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 延续页面的氛围背景，由横贯窗口的播放进度划分内容区与播放栏。 -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PlayerLayoutStates">
                <VisualState x:Name="CompactPlayer">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SongInfo.Width" Value="144" />
                        <Setter Target="PlaybackTime.Visibility" Value="Collapsed" />
                        <Setter Target="CompactPlaybackTime.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WidePlayer">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid Grid.Row="1" MinHeight="78" Padding="20,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左右两栏等宽，播放按钮始终位于窗口正中。 -->
            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Border
                    Width="{StaticResource SizeCoverRow}"
                    Height="{StaticResource SizeCoverRow}"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource RadiusMd}">
                    <Image
                        Source="{x:Bind ViewModel.CoverImage, Mode=OneWay}"
                        Stretch="UniformToFill" />
                </Border>

                <StackPanel
                    x:Name="SongInfo"
                    Width="{x:Bind local:Formats.PlayerInfoBlockWidth}"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <!-- 标题与徽标紧邻，长标题为徽标留出空间。 -->
                    <StackPanel
                        HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="{x:Bind local:Formats.PlayerBadgeSpacing}">
                        <TextBlock
                            MaxWidth="{x:Bind local:Formats.PlayerTitleMaxWidth(SongInfo.Width, ViewModel.IsAudition, ViewModel.HasPayLabel), Mode=OneWay}"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeBodyLarge}"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4"
                            Visibility="{x:Bind ViewModel.IsAudition, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11" Text="试听" />
                        </Border>
                        <Border
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4"
                            Visibility="{x:Bind ViewModel.HasPayLabel, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11" Text="{x:Bind ViewModel.PayLabel, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind local:Formats.ArtistLine(ViewModel.ArtistText, ViewModel.AlbumText), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="CompactPlaybackTime"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Visibility="Collapsed">
                        <Run Text="{x:Bind local:Formats.Seconds(ViewModel.PositionSeconds), Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{x:Bind local:Formats.Seconds(ViewModel.DurationSeconds), Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <Button
                    AutomationProperties.Name="上一首"
                    Command="{x:Bind ViewModel.PreviousCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                    Style="{StaticResource PlayerUtilityButtonStyle}"
                    ToolTipService.ToolTip="上一首">
                    <FontIcon FontSize="{StaticResource SizeIconMd}" Glyph="&#xE892;" />
                </Button>
                <Button
                    Width="{StaticResource SizePlayButton}"
                    Height="{StaticResource SizePlayButton}"
                    MinWidth="0"
                    Padding="0"
                    AutomationProperties.Name="播放 / 暂停"
                    Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                    CornerRadius="22"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="播放 / 暂停">
                    <Grid>
                        <FontIcon
                            FontSize="{StaticResource SizeIconMd}"
                            Glyph="&#xE768;"
                            Visibility="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource NotBoolToVisibility}}" />
                        <FontIcon
                            FontSize="{StaticResource SizeIconMd}"
                            Glyph="&#xE769;"
                            Visibility="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Button>
                <Button
                    AutomationProperties.Name="下一首"
                    Command="{x:Bind ViewModel.NextCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                    Style="{StaticResource PlayerUtilityButtonStyle}"
                    ToolTipService.ToolTip="下一首">
                    <FontIcon FontSize="{StaticResource SizeIconMd}" Glyph="&#xE893;" />
                </Button>
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    x:Name="PlaybackTime"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}">
                    <Run Text="{x:Bind local:Formats.Seconds(ViewModel.PositionSeconds), Mode=OneWay}" />
                    <Run Text=" / " />
                    <Run Text="{x:Bind local:Formats.Seconds(ViewModel.DurationSeconds), Mode=OneWay}" />
                </TextBlock>

                <!-- 音质与播放列表先保留入口，后续接入功能。实际音质仍然显示。 -->
                <Button
                    x:Name="QualityButton"
                    Width="64"
                    Padding="8,0"
                    AutomationProperties.Name="音质切换（暂未开放）"
                    IsEnabled="False"
                    Style="{StaticResource PlayerUtilityButtonStyle}"
                    ToolTipService.ToolTip="音质切换（暂未开放）">
                    <TextBlock
                        FontSize="{StaticResource FontSizeCaption}"
                        Text="{x:Bind local:Formats.PlayerQualityLabel(ViewModel.QualityText), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="{x:Bind ViewModel.QualityText, Mode=OneWay}" />
                </Button>
                <Button
                    AutomationProperties.Name="歌词"
                    Click="OnLyricsClick"
                    IsEnabled="{x:Bind Lyrics.HasTrack, Mode=OneWay}"
                    Style="{StaticResource PlayerUtilityButtonStyle}"
                    ToolTipService.ToolTip="歌词">
                    <TextBlock FontSize="{StaticResource FontSizeBody}" Text="词" />
                </Button>
                <Button
                    AutomationProperties.Name="音量"
                    Style="{StaticResource PlayerUtilityButtonStyle}"
                    ToolTipService.ToolTip="音量">
                    <FontIcon FontSize="{StaticResource SizeIconSm}" Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" />
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind local:Formats.Percent(ViewModel.Volume), Mode=OneWay}" />
                                <Slider
                                    Height="140"
                                    AutomationProperties.Name="音量"
                                    IsThumbToolTipEnabled="False"
                                    Maximum="100"
                                    Minimum="0"
                                    Orientation="Vertical"
                                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="PlaylistButton"
                    AutomationProperties.Name="播放列表（暂未开放）"
                    IsEnabled="False"
                    Style="{StaticResource PlayerUtilityButtonStyle}"
                    ToolTipService.ToolTip="播放列表（暂未开放）">
                    <FontIcon FontSize="{StaticResource SizeIconMd}" Glyph="&#xE142;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 负边距让细轨道贴在栏顶，悬停和拖动时加粗并显示圆形滑块。 -->
        <Slider
            x:Name="PositionSlider"
            Grid.Row="0"
            Margin="0,-10,0,-10"
            AutomationProperties.Name="播放进度"
            Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
            Style="{StaticResource PlayerProgressSliderStyle}"
            Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}" />

        <InfoBar
            Grid.Row="2"
            Margin="20,0,20,12"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Informational" />
    </Grid>
</UserControl>
