<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Bodian.WinUI.Converters"
    xmlns:local="using:Bodian.WinUI">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="NotBoolToVisibility" Invert="True" />
    </UserControl.Resources>

    <!-- 播放条与页面共用同一层氛围渐变，不再叠底色或顶部细线。 -->
    <Border Background="Transparent">

        <!--
            三栏分区：左=曲目信息，中=传输控制 + 进度（占满剩余宽度），右=音质与音量。
            这是播放器的常规布局 —— 控制区居中且进度条尽量长，才像在操作播放而不是在填表格。
        -->
        <Grid Padding="16,12" ColumnSpacing="16" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ── 左：封面 + 标题 / 歌手 · 专辑 ───────────────────────────────── -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">

                <!-- 没有封面时留一块底色，布局不跳。 -->
                <Border
                    Width="{StaticResource SizeCoverRow}"
                    Height="{StaticResource SizeCoverRow}"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="{StaticResource RadiusMd}">
                    <Image
                        Source="{x:Bind ViewModel.CoverImage, Mode=OneWay}"
                        Stretch="UniformToFill" />
                </Border>

                <!--
                    固定宽度：否则长标题会把中间的控制区挤走。

                    ★ 宽度绑 Formats 而不是写字面量 —— 曲名的 MaxWidth 是靠这个宽度反推的
                      （见 Formats.PlayerTitleMaxWidth），两处必须同源。
                -->
                <StackPanel
                    Width="{x:Bind local:Formats.PlayerInfoBlockWidth}"
                    VerticalAlignment="Center"
                    Spacing="3">

                    <!--
                        曲名与徽标必须在同一个横向 StackPanel 里，徽标才会紧跟曲名。
                        放在 * / Auto 两列的 Grid 里时，* 那一列吃掉剩余宽度，徽标就永远钉在最右边界，
                        曲名一短它就飘开（看起来像「贴着上一曲」）。
                        曲名的 MaxWidth 由徽标占位算出来，见 Formats.PlayerTitleMaxWidth。
                    -->
                    <StackPanel
                        HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="{x:Bind local:Formats.PlayerBadgeSpacing}">

                        <TextBlock
                            VerticalAlignment="Center"
                            MaxWidth="{x:Bind local:Formats.PlayerTitleMaxWidth(ViewModel.IsAudition, ViewModel.HasPayLabel), Mode=OneWay}"
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />

                        <!-- 试听徽标常驻，不是一闪而过的提示 -->
                        <Border
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4"
                            Padding="6,1"
                            Visibility="{x:Bind ViewModel.IsAudition, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11" Text="试听" />
                        </Border>

                        <!-- 付费标识。**只是服务端标记的展示**，不代表当前账号一定播不了。 -->
                        <Border
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4"
                            Padding="6,1"
                            Visibility="{x:Bind ViewModel.HasPayLabel, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11" Text="{x:Bind ViewModel.PayLabel, Mode=OneWay}" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind local:Formats.ArtistLine(ViewModel.ArtistText, ViewModel.AlbumText), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <!-- ── 中：传输控制 + 进度 ─────────────────────────────────────────── -->
            <Grid Grid.Row="0" Grid.Column="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">

                    <!--
                        上下首是裸图标：按钮比图标稍大一点留出点击热区，但不给底色 ——
                        播放条上只有主按钮带底色，其余靠 hover 反馈。
                    -->
                    <Button
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        MinWidth="0"
                        Padding="0"
                        Command="{x:Bind ViewModel.PreviousCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                        ToolTipService.ToolTip="上一首">
                        <FontIcon FontSize="{StaticResource SizeIconSm}" Glyph="&#xE892;" />
                    </Button>

                    <!--
                        圆形的强调按钮：整个播放条上唯一一个「主角」，一眼能找到。
                        **Padding 必须清零** —— 样式自带的左右内边距会把圆里的内容区压到装不下图标。
                        CornerRadius 是尺寸的一半，改尺寸时这里要跟着改。
                    -->
                    <Button
                        Width="{StaticResource SizePlayButton}"
                        Height="{StaticResource SizePlayButton}"
                        MinWidth="0"
                        Padding="0"
                        Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                        CornerRadius="22"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="播放 / 暂停">
                        <!-- 两个图标叠在同一格里，各自按内容定尺，不给容器写死尺寸（写死就会裁掉字形）。 -->
                        <Grid>
                            <FontIcon
                                FontSize="{StaticResource SizeIconMd}"
                                Glyph="&#xE768;"
                                Visibility="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource NotBoolToVisibility}}" />
                            <FontIcon
                                FontSize="{StaticResource SizeIconMd}"
                                Glyph="&#xE769;"
                                Visibility="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>

                    <Button
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        MinWidth="0"
                        Padding="0"
                        Command="{x:Bind ViewModel.NextCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                        ToolTipService.ToolTip="下一首">
                        <FontIcon FontSize="{StaticResource SizeIconSm}" Glyph="&#xE893;" />
                    </Button>

                    <!-- 歌词。没有在播的歌时是灰的 —— 那时进歌词页也没有内容可显示。 -->
                    <Button
                        Width="{StaticResource SizeRoundButton}"
                        Height="{StaticResource SizeRoundButton}"
                        MinWidth="0"
                        Margin="8,0,0,0"
                        Padding="0"
                        Click="OnLyricsClick"
                        IsEnabled="{x:Bind Lyrics.HasTrack, Mode=OneWay}"
                        ToolTipService.ToolTip="歌词">
                        <TextBlock FontSize="{StaticResource FontSizeBody}" Text="词" />
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        MinWidth="38"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind local:Formats.Seconds(ViewModel.PositionSeconds), Mode=OneWay}" />

                    <!--
                        显式给高度：这个 Slider 在一个 VerticalAlignment=Center 的 Grid 里，
                        不给高度时容易被父布局压扁。
                        Maximum 用 ProgressMaximum 而不是 DurationSeconds —— 后者初值为 0，
                        而 Slider 的值域为零时轨道会退化成看不见。
                    -->
                    <Slider
                        x:Name="PositionSlider"
                        Grid.Column="1"
                        Height="28"
                        MinWidth="160"
                        IsThumbToolTipEnabled="False"
                        Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                        Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}" />

                    <TextBlock
                        Grid.Column="2"
                        MinWidth="38"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind local:Formats.Seconds(ViewModel.DurationSeconds), Mode=OneWay}" />
                </Grid>
            </Grid>

            <!-- ── 右：实际音质 + 音量 ─────────────────────────────────────────── -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.QualityText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="服务端实际给出的音质" />

                <!--
                    音量：点击弹出竖条。横条常驻会白占一段水平空间，而音量不是每首都调。
                    Placement 必须是 Top —— 播放条在窗口底部，默认朝下会弹出屏幕外。
                -->
                <Button
                    Width="{StaticResource SizeRoundButton}"
                    Height="{StaticResource SizeRoundButton}"
                    MinWidth="0"
                    Padding="0"
                    ToolTipService.ToolTip="音量">
                    <FontIcon FontSize="{StaticResource SizeIconSm}" Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" />
                    <Button.Flyout>
                        <Flyout Placement="Top">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind local:Formats.Percent(ViewModel.Volume), Mode=OneWay}" />
                                <Slider
                                    Height="140"
                                    IsThumbToolTipEnabled="False"
                                    Maximum="100"
                                    Minimum="0"
                                    Orientation="Vertical"
                                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                Severity="Informational" />
        </Grid>
    </Border>
</UserControl>
