<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Bodian.WinUI.Converters"
    xmlns:local="using:Bodian.WinUI">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="NotBoolToVisibility" Invert="True" />
    </UserControl.Resources>

    <Border
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">

        <Grid Padding="16,10" ColumnSpacing="16" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 传输控制 -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Command="{x:Bind ViewModel.PreviousCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                    ToolTipService.ToolTip="上一首">
                    <FontIcon FontSize="14" Glyph="&#xE892;" />
                </Button>

                <Button
                    Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                    ToolTipService.ToolTip="播放 / 暂停">
                    <Grid Width="16" Height="16">
                        <FontIcon
                            FontSize="16"
                            Glyph="&#xE768;"
                            Visibility="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource NotBoolToVisibility}}" />
                        <FontIcon
                            FontSize="16"
                            Glyph="&#xE769;"
                            Visibility="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Button>

                <Button
                    Command="{x:Bind ViewModel.NextCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                    ToolTipService.ToolTip="下一首">
                    <FontIcon FontSize="14" Glyph="&#xE893;" />
                </Button>

                <!-- 歌词。没有在播的歌时是灰的 —— 那时打开面板也没有内容可显示。 -->
                <Button
                    Margin="8,0,0,0"
                    Command="{x:Bind Lyrics.ToggleCommand}"
                    IsEnabled="{x:Bind Lyrics.HasTrack, Mode=OneWay}"
                    ToolTipService.ToolTip="歌词">
                    <TextBlock FontSize="14" Text="词" />
                </Button>
            </StackPanel>

            <!-- 曲目信息：封面 + 标题 / 歌手 / 专辑 -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">

                <!-- 封面。没有封面时留一块底色，布局不跳。 -->
                <Border
                    Width="44"
                    Height="44"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="4">
                    <Image
                        Source="{x:Bind ViewModel.CoverImage, Mode=OneWay}"
                        Stretch="UniformToFill" />
                </Border>

                <StackPanel VerticalAlignment="Center" Spacing="2" Width="224">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />

                        <!-- 试听徽标常驻，不是一闪而过的提示 -->
                        <Border
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            CornerRadius="4"
                            Padding="6,1"
                            Visibility="{x:Bind ViewModel.IsAudition, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11" Text="试听" />
                        </Border>

                        <!-- 付费标识。**只是服务端标记的展示**，不代表当前账号一定播不了。 -->
                        <Border
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            CornerRadius="4"
                            Padding="6,1"
                            Visibility="{x:Bind ViewModel.HasPayLabel, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11" Text="{x:Bind ViewModel.PayLabel, Mode=OneWay}" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.ArtistText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.AlbumText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <!-- 进度 -->
            <Grid
                Grid.Row="0"
                Grid.Column="2"
                VerticalAlignment="Center"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind local:Formats.Seconds(ViewModel.PositionSeconds), Mode=OneWay}" />

                <!--
                    显式给高度：这个 Slider 在一个 VerticalAlignment=Center 的 Grid 里，
                    不给高度时容易被父布局压扁。
                    Maximum 用 ProgressMaximum 而不是 DurationSeconds —— 后者初值为 0，
                    而 Slider 的值域为零时轨道会退化成看不见。
                -->
                <Slider
                    x:Name="PositionSlider"
                    Grid.Column="1"
                    Height="32"
                    MinWidth="120"
                    IsThumbToolTipEnabled="False"
                    Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                    Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind local:Formats.Seconds(ViewModel.DurationSeconds), Mode=OneWay}" />
            </Grid>

            <!-- 音量与实际音质 -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.QualityText, Mode=OneWay}"
                    ToolTipService.ToolTip="服务端实际给出的音质" />

                <FontIcon FontSize="14" Glyph="&#xE767;" />

                <Slider
                    Width="100"
                    IsThumbToolTipEnabled="False"
                    Maximum="100"
                    Minimum="0"
                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                Severity="Informational" />
        </Grid>
    </Border>
</UserControl>
