<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.PlayerBar"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Bodian.WinUI.Converters"
    xmlns:local="using:Bodian.WinUI"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="NotBoolToVisibility" Invert="True" />

        <!-- 细进度条保留完整原生模板，轨道与滑块外观在控件加载后调整。 -->
        <Style x:Key="PlayerProgressSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource ControlStrongFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="IsThumbToolTipEnabled" Value="False" />
        </Style>

    </UserControl.Resources>

    <!-- 延续页面的氛围背景，由横贯窗口的播放进度划分内容区与播放栏。 -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="2" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PlayerLayoutStates">
                <VisualState x:Name="CompactPlayer">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TrackInfoGroup.MaxWidth" Value="300" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WidePlayer">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid Grid.Row="1" MinHeight="78" Padding="20,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左右两栏等宽，播放按钮始终位于窗口正中。 -->
            <Grid x:Name="TrackInfoGroup" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                MaxWidth="376" MinWidth="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CoverButton" Width="{StaticResource SizeCoverRow}" Height="{StaticResource SizeCoverRow}"
                    MinWidth="0" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="打开歌词页"
                    Click="OnLyricsClick" CornerRadius="{StaticResource RadiusMd}"
                    IsEnabled="{x:Bind Lyrics.HasTrack, Mode=OneWay}" Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="打开歌词页">
                    <Border Width="{StaticResource SizeCoverRow}" Height="{StaticResource SizeCoverRow}"
                        Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="{StaticResource RadiusMd}">
                        <Image Source="{x:Bind ViewModel.CoverImage, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>
                </Button>
                <Grid x:Name="SongInfo" Grid.Column="1" MinWidth="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--
                        曲名与徽标放同一个横向 StackPanel，徽标才会紧跟曲名 ——
                        换成 `*`/`Auto` 两列的 Grid 时，`*` 列会吃掉整个信息块，
                        徽标被钉在最右边界，曲名一短就和它拉开一大截。
                        代价是 StackPanel 不约束子元素，曲名要自己带上限（见下面的 MaxWidth）。
                    -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                        Spacing="{x:Bind local:Formats.PlayerBadgeSpacing}">
                        <TextBlock MinWidth="0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeBodyLarge}"
                            FontWeight="SemiBold" Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            MaxWidth="{x:Bind local:Formats.PlayerTitleMaxWidth(SongInfo.ActualWidth, ViewModel.IsAudition, ViewModel.HasPayLabel), Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <Border Padding="6,1" VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4"
                            Visibility="{x:Bind ViewModel.IsAudition, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11" Text="试听" />
                        </Border>
                        <Border Padding="6,1" VerticalAlignment="Center"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" CornerRadius="4"
                            Visibility="{x:Bind ViewModel.HasPayLabel, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontSize="11" Text="{x:Bind ViewModel.PayLabel, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind local:Formats.ArtistLine(ViewModel.ArtistText, ViewModel.AlbumText), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
                <!-- 收藏 / 分享：紧跟信息块右侧，各自 32 圆 + 右上角计数角标。 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <controls:TrackStatisticButton x:Name="FavoriteButton" Data="{StaticResource IconHeart}" ActiveData="{StaticResource IconHeartFilled}"
                        IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                        IsActive="{x:Bind ViewModel.Statistics.IsFavorite, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        Label="{x:Bind ViewModel.Statistics.FavoriteAutomationName, Mode=OneWay}"
                        BadgeText="{x:Bind ViewModel.Statistics.FavoriteBadgeText, Mode=OneWay}"
                        HasBadgeCount="{x:Bind ViewModel.Statistics.HasFavoriteCount, Mode=OneWay}" />
                    <controls:TrackStatisticButton x:Name="ShareButton" Data="{StaticResource IconShare}"
                        IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ShareCommand}"
                        Label="{x:Bind ViewModel.Statistics.ShareAutomationName, Mode=OneWay}"
                        BadgeText="{x:Bind ViewModel.Statistics.ShareBadgeText, Mode=OneWay}"
                        HasBadgeCount="{x:Bind ViewModel.Statistics.HasShareCount, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!--
                传输组：播放模式 · 上一首 · 播放/暂停 · 下一首 · 播放列表。

                ★ 左二右二，播放键正好落在整窗中线上 —— 这正是左右两栏要求等宽的原因，
                  往这一组里加减按钮不需要动别处，但别把播放键挪走。
            -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="24">
                <!--
                    播放模式：一个按钮循环切换三种模式，三个图标叠在同一格里靠 Visibility 选一个显示，
                    写法与右边那颗播放/暂停按钮一致。

                    几何搬去了 Themes/Icons.xaml（Fluent System Icons，MIT）。尺寸取 26 ——
                    那三条路径的墨水只占 24 单位视框里的 17×13，缩到 20 就只有 14×11，
                    比旁边 28 号的上一首/下一首小一半；26 时约 18×14，和队列那颗（22）同量级。
                -->
                <Button
                    AutomationProperties.Name="播放模式"
                    Command="{x:Bind ViewModel.CyclePlayModeCommand}"
                    Style="{StaticResource PlayerBareIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PlayModeText, Mode=OneWay}">
                    <Grid>
                        <controls:Icon Data="{StaticResource IconSequential}" Size="26"
                            Visibility="{x:Bind ViewModel.IsSequentialMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <controls:Icon Data="{StaticResource IconListLoop}" Size="26"
                            Visibility="{x:Bind ViewModel.IsListLoopMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <controls:Icon Data="{StaticResource IconShuffle}" Size="26"
                            Visibility="{x:Bind ViewModel.IsShuffleMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Button>
                <Button
                    AutomationProperties.Name="上一首"
                    Command="{x:Bind ViewModel.PreviousCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                    Style="{StaticResource PlayerBareIconButtonStyle}"
                    ToolTipService.ToolTip="上一首">
                    <controls:Icon Data="{StaticResource IconPrevious}" Size="28" />
                </Button>
                <Button
                    AutomationProperties.Name="播放 / 暂停"
                    Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                    Style="{StaticResource PlayerAccentButtonStyle}"
                    ToolTipService.ToolTip="播放 / 暂停">
                    <Grid>
                        <controls:Icon
                            Size="24"
                            Data="{StaticResource IconPlay}"
                            Visibility="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource NotBoolToVisibility}}" />
                        <controls:Icon
                            Size="24"
                            Data="{StaticResource IconPause}"
                            Visibility="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Button>
                <Button
                    AutomationProperties.Name="下一首"
                    Command="{x:Bind ViewModel.NextCommand}"
                    IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                    Style="{StaticResource PlayerBareIconButtonStyle}"
                    ToolTipService.ToolTip="下一首">
                    <controls:Icon Data="{StaticResource IconNext}" Size="28" />
                </Button>
                <!--
                    播放列表：弹出的是内存播放队列，不是服务器歌单。
                    抽屉挂在主窗口上（要盖住内容区，播放条这一层放不下），所以这里只抛事件。
                -->
                <Button
                    x:Name="PlaylistButton"
                    AutomationProperties.Name="播放列表"
                    Click="OnPlaylistClick"
                    Style="{StaticResource PlayerBareIconButtonStyle}"
                    ToolTipService.ToolTip="播放列表">
                    <controls:Icon Data="{StaticResource IconQueue}" Size="22" />
                </Button>
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <!--
                    播放栏只显示当前档位，面板保留各档大小。
                    当前档用档位色标签表示（标准灰 / HQ 蓝 / SQ 金），与面板里那三行同一个控件。

                    ★ Spacing 16：音质标签是撑满按钮的方块，另外两颗是外圈留白的图标按钮。
                      数值取 8 时方块那侧的视觉空隙只有一半，看着挤；16 才和左区那颗图标按钮的间距等效。
                -->
                <Button
                    x:Name="QualityButton"
                    Width="36"
                    Height="36"
                    CornerRadius="8"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="音质切换"
                    IsEnabled="{x:Bind ViewModel.CanChangeQuality, Mode=OneWay}"
                    Style="{StaticResource PlayerRoundIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.QualityText, Mode=OneWay}">
                    <!-- 音质按钮回到扁平药丸那一版：36 宽、圆角 8，胶囊横向撑满、纵向居中。 -->
                    <controls:AudioQualityChip
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Label="{x:Bind ViewModel.QualityLabel, Mode=OneWay}"
                        Quality="{x:Bind ViewModel.CurrentQuality, Mode=OneWay}" />
                    <Button.Flyout>
                        <Flyout x:Name="QualityFlyout" Placement="Top">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Background" Value="{ThemeResource ThemeFlyoutBackground}" />
                                    <Setter Property="Padding" Value="6" />
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <controls:AudioQualityPicker ViewModel="{x:Bind ViewModel}" SelectionRequested="OnQualitySelected" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    AutomationProperties.Name="歌词"
                    Click="OnLyricsClick"
                    IsEnabled="{x:Bind Lyrics.HasTrack, Mode=OneWay}"
                    Style="{StaticResource PlayerRoundIconButtonStyle}"
                    ToolTipService.ToolTip="歌词">
                    <!-- 歌词页入口：矢量路径，与旁边音量同尺寸，不再需要字号补偿。 -->
                    <controls:Icon Data="{StaticResource IconLyrics}" Size="16" />
                </Button>
                <!-- 音量与歌词页共用同一个控件。 -->
                <controls:VolumeButton
                    x:Name="VolumeControl"
                    ViewModel="{x:Bind ViewModel}" />
            </StackPanel>
        </Grid>

        <!-- 负边距让细轨道贴在栏顶，悬停和拖动时加粗并显示圆形滑块。 -->
        <Slider
            x:Name="PositionSlider"
            Grid.Row="0"
            Margin="0,-10,0,-10"
            AutomationProperties.Name="播放进度"
            Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
            ValueChanged="OnProgressValueChanged"
            Style="{StaticResource PlayerProgressSliderStyle}"
            Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}">
            <Slider.Resources>
                <x:Double x:Key="SliderTrackThemeHeight">1.5</x:Double>
                <x:Double x:Key="SliderHorizontalHeight">22</x:Double>
                <x:Double x:Key="SliderPreContentMargin">10</x:Double>
                <x:Double x:Key="SliderPostContentMargin">10</x:Double>
                <x:Double x:Key="SliderHorizontalThumbWidth">8</x:Double>
                <x:Double x:Key="SliderHorizontalThumbHeight">8</x:Double>
                <x:Double x:Key="SliderInnerThumbWidth">4</x:Double>
                <x:Double x:Key="SliderInnerThumbHeight">4</x:Double>
            </Slider.Resources>
        </Slider>

        <InfoBar
            Grid.Row="2"
            Margin="20,0,20,12"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
            Severity="Informational" />

        <!-- 气泡在单独的 Popup 中绘制，不占播放栏高度，也不挡住进度拖动。 -->
        <primitives:Popup x:Name="ProgressTimePopup" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Border
                x:Name="ProgressTimeBubble"
                MinWidth="84"
                Padding="10,6"
                Background="{ThemeResource ToolTipBackground}"
                BorderBrush="{ThemeResource ToolTipBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <TextBlock
                    x:Name="ProgressTimeText"
                    FontSize="{StaticResource FontSizeCaption}"
                    Foreground="{ThemeResource ToolTipForeground}"
                    TextAlignment="Center" />
            </Border>
        </primitives:Popup>

    </Grid>
</UserControl>
