<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.EditPlaylistDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            标签 chip。选中态交给 ToggleButton 自己的视觉状态，不用另外画。
            Tag 上绑数据项本身，事件处理器据此找到是哪一个 —— 比从 DataContext 猜要稳。
        -->
        <DataTemplate x:Key="TagChipTemplate" x:DataType="controls:TagChip">
            <ToggleButton
                Padding="10,4"
                Checked="OnChipChecked"
                Content="{x:Bind Name}"
                FontSize="12"
                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                MinWidth="0"
                Tag="{x:Bind}"
                Unchecked="OnChipUnchecked" />
        </DataTemplate>

        <!--
            标签按行摆放。**不用 GridView / ItemsWrapGrid** —— 那些给一屏里所有条目用同一个
            格子尺寸（由第一个条目定下来），标签一长就被裁。WrapPanel 让每个 chip 按自己的文字定宽。
        -->
        <ItemsPanelTemplate x:Key="TagChipPanelTemplate">
            <controls:WrapPanel HorizontalSpacing="6" VerticalSpacing="6" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <!--
        表单与裁剪器在同一个对话框里互斥显示。
        **裁剪不能另开一个 ContentDialog** —— 同一个 XamlRoot 上同时只允许一个，
        嵌一个进去会直接抛。
    -->
    <Grid MinWidth="400">

        <StackPanel x:Name="FormPanel" Spacing="6">
            <!-- 封面 -->
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="封面" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border
                    Width="56"
                    Height="56"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="6">
                    <Image x:Name="CoverPreview" Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <Button x:Name="PickCoverButton" Click="OnPickCoverClick" Content="选择封面…" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="按 1.25:1 裁剪，最长边 1400" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                x:Name="CoverErrorText"
                FontSize="12"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- 标题 -->
            <TextBlock
                Margin="0,10,0,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="标题*" />
            <TextBox
                x:Name="NameBox"
                PlaceholderText="请输入歌单名称"
                TextChanged="OnNameTextChanged" />

            <!-- 介绍 -->
            <TextBlock
                Margin="0,10,0,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="介绍" />
            <TextBox
                x:Name="DescriptionBox"
                Height="72"
                AcceptsReturn="True"
                PlaceholderText="对歌单进行描述"
                TextWrapping="Wrap" />

            <!-- 标签 -->
            <TextBlock
                Margin="0,10,0,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="标签（最多 3 个）" />

            <!-- 横向不给滚：WrapPanel 要拿到有限的宽度才知道在哪换行。 -->
            <ScrollViewer
                MaxHeight="200"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TagGroupsPanel" />
            </ScrollViewer>
        </StackPanel>

        <Grid x:Name="CropPanel" Height="360" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:ImageCropView x:Name="Cropper" Grid.Row="0" />

            <StackPanel
                Grid.Row="1"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="OnRepickClick" Content="重新选择" />
                <Button
                    Click="OnCropDoneClick"
                    Content="完成裁剪"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
