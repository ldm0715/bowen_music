<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.TrackMoreButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls">

    <!--
        曲目行尾的「更多」按钮。菜单内容在 TrackActionsMenu 里，与歌词页那颗共用同一份。

        **显隐由控件自己绑**（Row.MoreVisibility = 悬停或菜单开着），行模板只负责给出 Row：
        判据涉及两个状态位，写在模板里得挂两次绑定，还容易漏掉「菜单开着」那一个。

        **Flyout 的内容写在这里，不写进行模板**：模板是虚拟化回收的，塞进去要碰
        namescope 与绑定时序的麻烦；放在控件里则与控件同生命周期。
    -->
    <Button
        Width="32"
        Height="32"
        MinWidth="0"
        MinHeight="0"
        Padding="0"
        AutomationProperties.Name="更多"
        Background="Transparent"
        BorderThickness="0"
        CornerRadius="{StaticResource RadiusSm}"
        ToolTipService.ToolTip="更多"
        Visibility="{x:Bind Row.MoreVisibility, Mode=OneWay}">
        <controls:Icon Size="14" Data="{StaticResource IconMore}" />

        <Button.Flyout>
            <Flyout
                x:Name="MoreFlyout"
                Closed="OnFlyoutClosed"
                Opening="OnFlyoutOpening"
                Placement="Bottom">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Background" Value="{ThemeResource ThemeFlyoutBackground}" />
                        <Setter Property="Padding" Value="6" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>

                <!-- 菜单在首次打开时创建，关闭后释放，歌曲行不预建隐藏的列表与按钮。 -->
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
