<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.TrackMoreButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bodian.WinUI.Controls"
    xmlns:local="using:Bodian.WinUI"
    xmlns:models="using:Bodian.Core.Models"
    xmlns:vm="using:Bodian.WinUI.ViewModels">

    <!--
        曲目行尾的「更多」按钮，菜单里是喜欢 / 添加到歌单 / 查看歌手 / 查看专辑。

        **显隐由控件自己绑**（Row.MoreVisibility = 悬停或菜单开着），行模板只负责给出 Row：
        判据涉及两个状态位，写在模板里得挂两次绑定，还容易漏掉「菜单开着」那一个。

        **Flyout 的内容写在这里，不写进行模板**：模板是虚拟化回收的，塞进去要碰
        namescope 与绑定时序的麻烦；放在控件里则与控件同生命周期。

        **选歌单是同一个 Flyout 内换面板，不是弹第二个 Flyout**：
        二级弹层在会被回收的行容器里定位不可靠，而这里的两面本来就互斥。
    -->
    <Button
        Width="32"
        Height="32"
        MinWidth="0"
        MinHeight="0"
        Padding="0"
        AutomationProperties.Name="更多"
        Background="Transparent"
        BorderThickness="0"
        CornerRadius="{StaticResource RadiusSm}"
        ToolTipService.ToolTip="更多"
        Visibility="{x:Bind Row.MoreVisibility, Mode=OneWay}">
        <controls:Icon Size="14" Data="{StaticResource IconMore}" />

        <Button.Flyout>
            <Flyout
                x:Name="MoreFlyout"
                Closed="OnFlyoutClosed"
                Opening="OnFlyoutOpening"
                Placement="Bottom">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Background" Value="{ThemeResource ThemeFlyoutBackground}" />
                        <Setter Property="Padding" Value="6" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>

                <!--
                    宽度随内容走，不写死：菜单只有四行短文案，定宽会留出一大片空白。
                    代价是切到歌单那一面时（那一面内容更宽）弹层会跟着变一下宽度。
                    MaxWidth 是防长歌单名把弹层撑到窗口另一头 —— 到了这个宽度，
                    歌单名按列的 TextTrimming 截断。
                -->
                <Grid MaxWidth="240">
                    <!-- 第一面：四项动作 -->
                    <ListView
                        MaxHeight="240"
                        MinWidth="0"
                        IsItemClickEnabled="True"
                        ItemClick="OnMenuEntryClick"
                        ItemsSource="{x:Bind ViewModel.MenuEntries, Mode=OneWay}"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        AutomationProperties.Name="曲目操作"
                        Visibility="{x:Bind local:Formats.VisibleWhenFalse(ViewModel.IsPickingPlaylist), Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <!-- 「查看专辑」这类没数据的项灰掉；用经典绑定，容器样式里拿不到 x:Bind 的数据类型。 -->
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrackMenuEntry">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:Icon Size="16"
                                        Data="{x:Bind local:Formats.IconPaths(IconKey), Mode=OneWay}"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="13"
                                        Text="{x:Bind Text, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 第二面：选一个自建歌单 -->
                    <StackPanel
                        Spacing="2"
                        Visibility="{x:Bind local:Formats.Visible(ViewModel.IsPickingPlaylist), Mode=OneWay}">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Width="32"
                                Height="32"
                                MinWidth="0"
                                MinHeight="0"
                                Padding="0"
                                AutomationProperties.Name="返回"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnBackToMenuClick"
                                ToolTipService.ToolTip="返回">
                                <controls:Icon Size="12" Data="{StaticResource IconBack}" />
                            </Button>
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="添加到歌单"
                                VerticalAlignment="Center" />
                        </Grid>

                        <ProgressRing
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            IsActive="{x:Bind ViewModel.IsPlaylistsBusy, Mode=OneWay}"
                            Visibility="{x:Bind local:Formats.Visible(ViewModel.IsPlaylistsBusy), Mode=OneWay}" />

                        <ListView
                            MaxHeight="200"
                            MinWidth="0"
                            IsItemClickEnabled="True"
                            ItemClick="OnPlaylistClick"
                            ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            AutomationProperties.Name="选择歌单">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MinHeight" Value="32" />
                                    <Setter Property="Padding" Value="10,7" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="CornerRadius" Value="6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Playlist">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontSize="13"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind local:Formats.AlbumCount(MusicCount)}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            Margin="10,2,10,4"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.PlaylistError, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind local:Formats.Visible(ViewModel.HasPlaylistError), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
