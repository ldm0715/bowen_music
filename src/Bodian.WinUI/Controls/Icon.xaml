<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bodian.WinUI.Controls.Icon"
    x:Name="IconRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 保持 SVG 的完整 24×24 坐标，避免 PathIcon 按自身包围盒偏移、裁切。 -->
    <Viewbox x:Name="Scaler" Width="16" Height="16" Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path x:Name="Glyph" Stretch="None"
                Fill="{Binding Foreground, ElementName=IconRoot, Mode=OneWay}" />
        </Canvas>
    </Viewbox>
</UserControl>
